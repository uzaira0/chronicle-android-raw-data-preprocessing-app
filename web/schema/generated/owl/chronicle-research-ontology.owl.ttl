.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_startup>
    a owl:Class ;
    rdfs:label "device_startup" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Device startup boundary (UI:27 / importance 27)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#foreground_service_start>
    a owl:Class ;
    rdfs:label "foreground_service_start" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Foreground Service Start (UI:19). App-scoped; named by the gesis_app_scoped_starts opener set." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_hidden>
    a owl:Class ;
    rdfs:label "keyguard_hidden" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Keyguard hidden / device unlocked (UI:18)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_shown>
    a owl:Class ;
    rdfs:label "keyguard_shown" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Keyguard shown / device locked (UI:17)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#notification_interruption>
    a owl:Class ;
    rdfs:label "notification_interruption" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Notification Interruption (UI:12). An INSTANT, like Notification Seen; the interruption_contact_v1 proxy rule emits it. The stronger of the two contact signals." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#notification_seen>
    a owl:Class ;
    rdfs:label "notification_seen" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Notification Seen (UI:10). An INSTANT, not an interval: the seen_contact_v1 notification-proxy rule emits it into a separate contact channel and it contributes no duration to app usage." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#rollover_foreground_service>
    a owl:Class ;
    rdfs:label "rollover_foreground_service" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Rollover Foreground Service (UI:22). App-scoped; named by the gesis_app_scoped_starts opener set." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_interactive>
    a owl:Class ;
    rdfs:label "screen_interactive" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Screen turned interactive (UI:15)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_non_interactive>
    a owl:Class ;
    rdfs:label "screen_non_interactive" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Screen turned non-interactive (UI:16)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#slice_pinned_app>
    a owl:Class ;
    rdfs:label "slice_pinned_app" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Slice Pinned App (UI:14). App-scoped; named by the gesis_app_scoped_starts opener set." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#standby_bucket_changed>
    a owl:Class ;
    rdfs:label "standby_bucket_changed" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Standby Bucket Changed (UI:11). App-scoped; named by the gesis_app_scoped_starts opener set." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#user_interaction>
    a owl:Class ;
    rdfs:label "user_interaction" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "User Interaction (UI:7). The only code retained by usage_logger_5 that no other named published retention set keeps (the `none` value retains every event)." ;
.

chron:FilterMatchFieldId
    a owl:Class ;
    rdfs:label "FilterMatchFieldId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#app_package_name>
        <https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#application_label>
    ) ;
    skos:definition "Canonical identifier for the field whose exact value makes a filter-file row match an input row. app_package_name is the compatibility default. application_label uses case-sensitive full-string equality and retains a matched row as filtered lineage without inferring a package identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#app_package_name> ,
        <https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#application_label> ;
.

<https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#app_package_name>
    a owl:Class ;
    rdfs:label "app_package_name" ;
    rdfs:subClassOf chron:FilterMatchFieldId ;
    skos:definition "Compatibility default: match the supplied package identity, optionally narrowed by the supplied known label." ;
.

<https://w3id.org/chronicle-usage-ontology/core/FilterMatchFieldId#application_label>
    a owl:Class ;
    rdfs:label "application_label" ;
    rdfs:subClassOf chron:FilterMatchFieldId ;
    skos:definition "Match the input application_label by exact, case-sensitive, full-string equality; never case-fold, use substrings, or infer a package." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordGroupingBasisId#declared_group_membership>
    a owl:Class ;
    rdfs:label "declared_group_membership" ;
    rdfs:subClassOf chron:GroupedRecordGroupingBasisId ;
    skos:definition "Use the upstream declared groups; do not infer undisclosed equality fields." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordGroupingBasisId#field_equality>
    a owl:Class ;
    rdfs:label "field_equality" ;
    rdfs:subClassOf chron:GroupedRecordGroupingBasisId ;
    skos:definition "Group by equality of the referenced source fields inside the upstream partition." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordGroupingBasisId#raw_string_concatenation>
    a owl:Class ;
    rdfs:label "raw_string_concatenation" ;
    rdfs:subClassOf chron:GroupedRecordGroupingBasisId ;
    skos:definition "Group by equality of the raw strings concatenated in the declared operand order, without separator, escaping or type coercion. Only explicitly listed absent fields default to the empty string; null is not absence." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#DISCARD_SUMMARY_IF_NON_SUMMARY_EXISTS>
    a owl:Class ;
    rdfs:label "DISCARD_SUMMARY_IF_NON_SUMMARY_EXISTS" ;
    rdfs:subClassOf chron:GroupedRecordSelectionRuleId ;
    skos:definition "Discard summary members only when non-summary members coexist, preserving all non-summary members. Preserve summary-only groups without imposing singleton cardinality or FIRST/LAST reduction. The literal summary marker and its extraction are separate source-schema facts, not supplied by this rule." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#FIRST>
    a owl:Class ;
    rdfs:label "FIRST" ;
    rdfs:subClassOf chron:GroupedRecordSelectionRuleId ;
    skos:definition "Retain the first member in the source-defined order; undisclosed ordering stays unresolved." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#LAST>
    a owl:Class ;
    rdfs:label "LAST" ;
    rdfs:subClassOf chron:GroupedRecordSelectionRuleId ;
    skos:definition "Retain the last member in the source-defined order; undisclosed ordering stays unresolved." ;
.

<https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#RETAIN_SUMMARIES_IF_PRESENT_ELSE_ALL>
    a owl:Class ;
    rdfs:label "RETAIN_SUMMARIES_IF_PRESENT_ELSE_ALL" ;
    rdfs:subClassOf chron:GroupedRecordSelectionRuleId ;
    skos:definition "Preserve every summary member when any summary exists, otherwise every member, retaining their relative input order. Do not collapse multiple summaries or impose FIRST/LAST. Marker extraction is a separate source fact." ;
.

<https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#corresponding_text_content_tagged>
    a owl:Class ;
    rdfs:label "corresponding_text_content_tagged" ;
    rdfs:subClassOf chron:HierarchyRedactionEffectId ;
.

<https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#qualifying_element_metadata_removed>
    a owl:Class ;
    rdfs:label "qualifying_element_metadata_removed" ;
    rdfs:subClassOf chron:HierarchyRedactionEffectId ;
.

<https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#gesture>
    a owl:Class ;
    rdfs:label "gesture" ;
    rdfs:subClassOf chron:InteractionEventPayloadRoleId ;
    skos:definition "Associated interaction type and location; its presence does not establish correctness." ;
.

<https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#screenshot>
    a owl:Class ;
    rdfs:label "screenshot" ;
    rdfs:subClassOf chron:InteractionEventPayloadRoleId ;
    skos:definition "Captured visual representation of the UI." ;
.

<https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#view_hierarchy>
    a owl:Class ;
    rdfs:label "view_hierarchy" ;
    rdfs:subClassOf chron:InteractionEventPayloadRoleId ;
    skos:definition "Captured structural representation of the same UI." ;
.

chron:InteractionEventRecord
    a owl:Class ;
    rdfs:label "InteractionEventRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:capture_incomplete ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:screen_description ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:screen_description ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:capture_incomplete ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:screen_description ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:hierarchy_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:interaction_event_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:hierarchy_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:interaction_event_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:capture_incomplete ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:interaction_redactions ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:human_detected_incorrect ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:integer

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:integer ;
                            owl:withRestrictions (

                                [
                                    xsd:minInclusive 0 ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:event_sequence_position ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:screenshot_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:event_sequence_position ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:screenshot_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:gesture_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:hierarchy_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:interaction_event_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:human_detected_incorrect ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:event_sequence_position ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:gesture_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:screenshot_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:gesture_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:human_detected_incorrect ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:InteractionRedactionRecord ;
            owl:onProperty chron:interaction_redactions ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "One normalized trace member with paired visual/structural payload identities and optional gesture. Positions express current trace order, not timestamps. Capture incompleteness and human-detected incorrectness are independent nullable assertions; gesture presence implies neither correctness nor a human assessment. ODIM PDF pp. 6-7 sections 4.2-4.3. IDs and field names are normalized, not recovered." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:InteractionRedactionRecord
    a owl:Class ;
    rdfs:label "InteractionRedactionRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:target_region_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:hierarchy_redaction_effect ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:target_region_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:redaction_selection_basis ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:redacted_hierarchy_artifact_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:target_region_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
