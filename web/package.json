{
  "name": "chronicle-preprocessing-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-clean-env.mjs vite build",
    "generate:contract": "node scripts/run-clean-env.mjs vite-node scripts/generate_contract_artifacts.mts",
    "preview": "node scripts/run-clean-env.mjs vite preview --host 127.0.0.1 --port 4173",
    "host:local": "npm run build && npm run preview",
    "prepare:github-pages": "node scripts/run-clean-env.mjs vite-node scripts/prepare_github_pages_artifact.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.mjs.json",
    "lint": "eslint src e2e",
    "test": "node scripts/run-clean-env.mjs vitest run",
    "test:coverage": "node scripts/run-clean-env.mjs vitest run --coverage",
    "check:contract": "node scripts/run-clean-env.mjs vite-node scripts/generate_contract_artifacts.mts --check && node scripts/run-clean-env.mjs vite-node scripts/check_contract_consistency.mts && node scripts/run-clean-env.mjs vite-node scripts/generate_pipeline_graph_artifacts.mts --check && node scripts/run-clean-env.mjs vite-node scripts/generate_output_codebook_artifacts.mts --check && node scripts/run-clean-env.mjs vite-node scripts/check_step_dataflow.mts && node scripts/run-clean-env.mjs vite-node scripts/check_contract_compat.mts",
    "check:contract-compat": "node scripts/run-clean-env.mjs vite-node scripts/check_contract_compat.mts",
    "check:step-dataflow": "node scripts/run-clean-env.mjs vite-node scripts/check_step_dataflow.mts",
    "check:deploy-artifact": "node scripts/run-clean-env.mjs vite-node scripts/check_deploy_artifact.mts",
    "check:github-pages-artifact": "node scripts/run-clean-env.mjs vite-node scripts/check_deploy_artifact.mts github-pages",
    "test:e2e": "node scripts/run-clean-env.mjs playwright test",
    "test:e2e:headed": "node scripts/run-clean-env.mjs playwright test --headed",
    "test:e2e:smoke": "node scripts/run-clean-env.mjs playwright test --grep @smoke",
    "process:browser": "vite-node scripts/run_browser_processing.mts",
    "benchmark:browser": "node scripts/benchmark_browser_processing.mjs",
    "build:wasm": "wasm-pack build ../rust/chronicle_app_usage_wasm --target web --out-dir ../../web/src/wasm/chronicle_app_usage_wasm/pkg",
    "generate:pipeline-graph": "node scripts/run-clean-env.mjs vite-node scripts/generate_pipeline_graph_artifacts.mts",
    "generate:output-codebook": "node scripts/run-clean-env.mjs vite-node scripts/generate_output_codebook_artifacts.mts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dagrejs/graphlib": "^4.0.1",
    "@xyflow/react": "^12.11.2",
    "comlink": "^4.4.2",
    "hyparquet-writer": "^0.15.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^5.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "hyparquet": "^1.26.0",
    "read-excel-file": "^5.8.0",
    "sav-reader": "^2.0.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.12",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "qs": "6.15.3"
  }
}
