.

chron:MethodConfigurationGroup
    a sh:NodeShape ;
    rdfs:comment "One source-declared fixed, alternative, conditional, sensitivity, ablation, or multiverse group." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Source-declared axes varied by this group." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:method_configuration_axis ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Evidence-blocked settings preventing complete configuration selection." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:unresolved_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicit rule prohibiting or enumerating combinations with other groups." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:method_cross_product_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-grounded group kind such as fixed set, sensitivity axis, ablation, or conditional state machine." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_configuration_group_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source statements retained for audit but not treated as selectable method values." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
