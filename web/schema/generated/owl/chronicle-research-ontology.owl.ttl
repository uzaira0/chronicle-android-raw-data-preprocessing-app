chron:quantity_record_id
    a owl:DatatypeProperty ;
    rdfs:label "quantity_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied quantity identity unique within its owning session; repeated equal properties/values remain independent." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:quantity_scope
    a owl:DatatypeProperty ;
    rdfs:label "quantity_scope" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "^(session|app|app_category)$" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Explicit session/app/app-category subject scope, independent of whether the app/category identity is known." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:quantity_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "quantity_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Profile-local feature or record-field definition with compatible role, target, property, unit and scope; not a request to compute the value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_bounds
    a owl:DatatypeProperty ;
    rdfs:label "query_bounds" ;
    rdfs:range xsd:string ;
    skos:definition "Query interval and bound inclusivity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_execution_status
    a owl:ObjectProperty ;
    rdfs:label "query_execution_status" ;
    rdfs:range chron:QueryExecutionStatus ;
    skos:definition "Observed physical execution state." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_group_id
    a owl:DatatypeProperty ;
    rdfs:label "query_group_id" ;
    rdfs:range xsd:string ;
    skos:definition "Presentation-only query-group identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_id
    a owl:DatatypeProperty ;
    rdfs:label "query_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable physical-query identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_input_key
    a owl:DatatypeProperty ;
    rdfs:label "query_input_key" ;
    rdfs:range xsd:string ;
    skos:definition "Content identity of the query's exact effective inputs." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_output_digest
    a owl:DatatypeProperty ;
    rdfs:label "query_output_digest" ;
    rdfs:range xsd:string ;
    skos:definition "Content identity of the query output." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:query_reason_id
    a owl:DatatypeProperty ;
    rdfs:label "query_reason_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identity of the evidence supporting the state." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:range_annotation_id
    a owl:DatatypeProperty ;
    rdfs:label "range_annotation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied annotation identity local to the owning screenshot session, not inferred from equal endpoints or labels." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:range_label_values_json
    a owl:DatatypeProperty ;
    rdfs:label "range_label_values_json" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied lexical JSON object of open dimension labels to values, or JSON null. Partial, empty, omitted and supplied-null objects stay distinct; no codebook, completeness or relabel rule is imposed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:raw_event_availability
    a owl:DatatypeProperty ;
    rdfs:label "raw_event_availability" ;
    rdfs:range xsd:string ;
    skos:definition "Whether and where underlying raw events are available." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:realized_cadence_and_jitter
    a owl:DatatypeProperty ;
    rdfs:label "realized_cadence_and_jitter" ;
    rdfs:range xsd:string ;
    skos:definition "Observed cadence and jitter, kept distinct from the request." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:reconstruction_strategy
    a owl:ObjectProperty ;
    rdfs:label "reconstruction_strategy" ;
    rdfs:range chron:ReconstructionStrategy ;
    skos:definition "Named reconstruction strategy used by the constructor." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:records_occurrence
    a owl:ObjectProperty ;
    rdfs:label "records_occurrence" ;
    rdfs:range chron:PlatformEventOccurrence ;
    skos:definition "The real-world occurrence this record logs." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:redacted_hierarchy_artifact_id
    a owl:DatatypeProperty ;
    rdfs:label "redacted_hierarchy_artifact_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identity of the corresponding hierarchy output, not an executed sanitization claim." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:redacted_screenshot_artifact_id
    a owl:DatatypeProperty ;
    rdfs:label "redacted_screenshot_artifact_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identity of the paired screenshot output, not an executed sanitization claim." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:redaction_justification
    a owl:DatatypeProperty ;
    rdfs:label "redaction_justification" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied per-redaction textual justification (ODIM device route, PDF p. 8 section 4.4); no web prompt or mandatory response is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:redaction_record_id
    a owl:DatatypeProperty ;
    rdfs:label "redaction_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized identity of one paired redaction record." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:redaction_selection_basis
    a owl:ObjectProperty ;
    rdfs:label "redaction_selection_basis" ;
    rdfs:range chron:InteractionRedactionSelectionId ;
    skos:definition "Element selection versus drawn-region/IoU selection; no undisclosed cutoff is supplied." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:reentered_text
    a owl:DatatypeProperty ;
    rdfs:label "reentered_text" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied reentered text segment, independently preserved without normalization or correction classification." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:release_profile_id
    a owl:DatatypeProperty ;
    rdfs:label "release_profile_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable measurement-release profile identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:released_data_granularity
    a owl:DatatypeProperty ;
    rdfs:label "released_data_granularity" ;
    rdfs:range xsd:string ;
    skos:definition "Event, interval, bin, day, participant, or other released granularity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:removed_text
    a owl:DatatypeProperty ;
    rdfs:label "removed_text" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied removed text segment, not inferred by comparing action states; empty/null/omission preserved." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:response_observability
    a owl:ObjectProperty ;
    rdfs:label "response_observability" ;
    rdfs:range chron:NotificationResponseObservabilityId ;
    skos:definition "Supplied observation availability required for normalized response_stage evidence, independent of response value, device-use context and recorded/inferred provenance (Reachable p.4 Section3.2.1)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:response_role_label
    a owl:DatatypeProperty ;
    rdfs:label "response_role_label" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied answer-role designation such as before/during/after; not a computed sampling phase or a claim that all phases occur in one app instance." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:response_stage_id
    a owl:DatatypeProperty ;
    rdfs:label "response_stage_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied nonblank stage label required for normalized response_stage evidence. Variable/merged stages are permitted; not a recovered source field, ordinal or inferred chronology (Reachable pp.3-4)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:restart_behavior
    a owl:DatatypeProperty ;
    rdfs:label "restart_behavior" ;
    rdfs:range xsd:string ;
    skos:definition "Behavior across collector or device restart." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:result_record
    a owl:ObjectProperty ;
    rdfs:label "result_record" ;
    rdfs:range chron:UsageEventRecord ;
    skos:definition "The event record produced by the logging observation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ringer_mode
    a owl:ObjectProperty ;
    rdfs:label "ringer_mode" ;
    rdfs:range chron:RingerModeId ;
    skos:definition "Supplied normalized setting occupied over denotes_interval; no numeric-code conversion or phone-use inference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ringer_state_interval_id
    a owl:DatatypeProperty ;
    rdfs:label "ringer_state_interval_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized interval record identity scoped by profile and participant." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:root_entity_member_reference
    a owl:DatatypeProperty ;
    rdfs:label "root_entity_member_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied root member ID resolved within the same inferred group; omission/null is unknown, never the first member by convention." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:rubric_component_id
    a owl:DatatypeProperty ;
    rdfs:label "rubric_component_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable C01-C21 measurement-component identifier when applicable." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:rule_annotation_json
    a owl:DatatypeProperty ;
    rdfs:label "rule_annotation_json" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied lexical JSON rule annotations such as printed category/type, separate from quality values, inferred action or classification execution." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:rule_definition_count
    a owl:DatatypeProperty ;
    rdfs:label "rule_definition_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of composed conditional or validation rules transported for the selected version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:rule_quality_values_json
    a owl:DatatypeProperty ;
    rdfs:label "rule_quality_values_json" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied lexical JSON quality values with their source labels/units/qualifications. Not computed from supplied sessions or silently treated as a normalized proportion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sampled_observation_id
    a owl:DatatypeProperty ;
    rdfs:label "sampled_observation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied observation identity local to profile/participant/device; equal time or entity tokens do not merge records." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sampled_observation_reference
    a owl:DatatypeProperty ;
    rdfs:label "sampled_observation_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied target observation identity. Nonblank positive IDs resolve unambiguously within the relation's source-authorized owner scope; null/omission is unknown." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:schedule_rule_count
    a owl:DatatypeProperty ;
    rdfs:label "schedule_rule_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of composed diary schedule rules transported for the selected version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screen_description
    a owl:DatatypeProperty ;
    rdfs:label "screen_description" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied description of this labelled screen interaction (ODIM PDF p. 9 section 4.5), owned by the event within its trace, not by a reusable screenshot payload. Independent of the whole trace description and redaction justification; preserve verbatim empty/null/omission without inferring an annotator or generation route." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screen_gating_rule
    a owl:ObjectProperty ;
    rdfs:label "screen_gating_rule" ;
    rdfs:range chron:ScreenGatingRuleId ;
    skos:definition "The typed rule that decided which parts of the app session earned credit. Replaces the former free-text coverage_policy, which named a policy vocabulary that never existed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screen_state
    a owl:ObjectProperty ;
    rdfs:label "screen_state" ;
    rdfs:range chron:ScreenStateId ;
    skos:definition "Supplied screen component only, independent of keyguard state; omission/null remains unknown." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screen_text
    a owl:DatatypeProperty ;
    rdfs:label "screen_text" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied flat screen-text string, preserved without splitting, joining, trimming or verifying original delimiter grammar." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_instant
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied screenshot capture-time token; no encoding, timezone or duration is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_record_id
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied screenshot identity local to its owning session, independent of capture time or image equality." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_record_reference
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_record_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied screenshot child within its explicitly referenced screenshot-session parent. A known child requires that parent; missing/null child remains unknown. No timestamp equality, inferred nearest image, padding inference or recovered serializer." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_redaction_effect
    a owl:ObjectProperty ;
    rdfs:label "screenshot_redaction_effect" ;
    rdfs:range chron:ScreenshotRedactionEffectId ;
    skos:definition "Supplied pixel-side effect of this paired redaction." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_sequence_position
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_sequence_position" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:integer

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions (

                        [
                            xsd:minInclusive 0 ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied nonnegative sequence position, unique within session; sparse positions do not reveal index base or equal-time sorting." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_session_id
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_session_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied screenshot-container identity scoped by profile/participant/device, source-defined phone-use or foreground-app ownership; not inferred from app or unlock timing." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_session_reference
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_session_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied cross-carrier screenshot-session parent. TimeKilling CHI2023 pp6–7 supplies a real phone-use parent distinct from prediction sequences; importer resolves source/profile/participant/compatible known device without constructing sessions or joins." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:selection_response_status
    a owl:DatatypeProperty ;
    rdfs:label "selection_response_status" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied nonblank open response-state label, not a source-code enum, timer execution or inferred negative response." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:selection_rule
    a owl:ObjectProperty ;
    rdfs:label "selection_rule" ;
    rdfs:range chron:GroupedRecordSelectionRuleId ;
    skos:definition "Source-declared group member disposition, independent of the unrecovered ordering or marker implementation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sensor_control_action
    a owl:ObjectProperty ;
    rdfs:label "sensor_control_action" ;
    rdfs:range chron:SensorControlActionId ;
    skos:definition "Supplied enable/disable occurrence label; not observed service status or a reconstructed disabled interval." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sensor_control_id
    a owl:DatatypeProperty ;
    rdfs:label "sensor_control_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied logged-control record identity local to profile/participant/device; equal times do not merge instances." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sensor_label
    a owl:DatatypeProperty ;
    rdfs:label "sensor_label" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied sensor identifier/label, not normalized into an Android package or an inferred deployed build." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sequence_encoding_rule
    a owl:ObjectProperty ;
    rdfs:label "sequence_encoding_rule" ;
    rdfs:range chron:SequenceEncodingRuleId ;
    skos:definition "Closed encoding rule applied to every ordered occurrence within each declared partition." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sequence_first_symbol_setting_id
    a owl:ObjectProperty ;
    rdfs:label "sequence_first_symbol_setting_id" ;
    rdfs:range chron:MethodSettingAssertion ;
    skos:definition "Profile-local source assertion of the literal symbol emitted for a first occurrence in the partition." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sequence_repeat_symbol_setting_id
    a owl:ObjectProperty ;
    rdfs:label "sequence_repeat_symbol_setting_id" ;
    rdfs:range chron:MethodSettingAssertion ;
    skos:definition "Profile-local source assertion of the literal symbol emitted for an identity previously encountered in the partition." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_construction_policy_id
    a owl:DatatypeProperty ;
    rdfs:label "session_construction_policy_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable target-typed session-construction identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_construction_policy_reference
    a owl:DatatypeProperty ;
    rdfs:label "session_construction_policy_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Local profile-owned policy ID whose output is device_setting_state_interval; not an execution receipt." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_input_layer
    a owl:ObjectProperty ;
    rdfs:label "session_input_layer" ;
    rdfs:range chron:MethodTargetLayerId ;
    skos:definition "Layer consumed by the constructor." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_output_layer
    a owl:ObjectProperty ;
    rdfs:label "session_output_layer" ;
    rdfs:range chron:MethodTargetLayerId ;
    skos:definition "Layer asserted by the constructor." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_transaction_id
    a owl:DatatypeProperty ;
    rdfs:label "session_transaction_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied transaction identity unique within its database, not inferred from equal times or app sets." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:sharing_status
    a owl:ObjectProperty ;
    rdfs:label "sharing_status" ;
    rdfs:range chron:DeviceSharingStatus ;
    skos:definition "Whether the participant's device is declared shared, as read from the device-sharing support file." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:snapshot_instant
    a owl:DatatypeProperty ;
    rdfs:label "snapshot_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized observation-time representation; original encoding and epoch are not inferred or converted here." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:snapshot_record_id
    a owl:DatatypeProperty ;
    rdfs:label "snapshot_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized snapshot identity scoped by profile and device; not a generated transmission counter." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:snapshot_record_origin
    a owl:ObjectProperty ;
    rdfs:label "snapshot_record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Explicit example versus supplied normalized record status; neither authenticates source serialization." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:snapshot_transmission_id_token
    a owl:DatatypeProperty ;
    rdfs:label "snapshot_transmission_id_token" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied opaque textual representation of the source transmission ID, separate from normalized snapshot identity (Clear All PDF p.4 filtering rule4). No numeric coercion, monotonicity, missing-counter inference or original serialization is asserted." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_artifact_provenance_id
    a owl:DatatypeProperty ;
    rdfs:label "source_artifact_provenance_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identity of a source-artifact provenance assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_artifact_provenance_object_digest
    a owl:DatatypeProperty ;
    rdfs:label "source_artifact_provenance_object_digest" ;
    rdfs:range xsd:string ;
    skos:definition "JCS SHA-256 digest of the exact registered provenance object." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_artifact_provenance_object_json
    a owl:DatatypeProperty ;
    rdfs:label "source_artifact_provenance_object_json" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical JSON serialization of the exact registered provenance object." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_clause_end
    a owl:DatatypeProperty ;
    rdfs:label "source_clause_end" ;
    rdfs:range xsd:integer ;
    skos:definition "End offset of the clause within the preserved source value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_clause_label
    a owl:DatatypeProperty ;
    rdfs:label "source_clause_label" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the accounted source clause." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_clause_path
    a owl:DatatypeProperty ;
    rdfs:label "source_clause_path" ;
    rdfs:range xsd:string ;
    skos:definition "Stable structural path of the clause within the source extraction." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_clause_start
    a owl:DatatypeProperty ;
    rdfs:label "source_clause_start" ;
    rdfs:range xsd:integer ;
    skos:definition "Start offset of the clause within the preserved source value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_clause_text
    a owl:DatatypeProperty ;
    rdfs:label "source_clause_text" ;
    rdfs:range xsd:string ;
    skos:definition "Exact extracted clause text represented by this atomic setting." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_component_id
    a owl:DatatypeProperty ;
    rdfs:label "source_component_id" ;
    rdfs:range xsd:string ;
    skos:definition "Source extraction component or auxiliary axis identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_coverage_status
    a owl:DatatypeProperty ;
    rdfs:label "source_coverage_status" ;
    rdfs:range xsd:string ;
    skos:definition "Source-ledger coverage status preserved independently from applicability and implementation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_evidence_work_id
    a owl:DatatypeProperty ;
    rdfs:label "source_evidence_work_id" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical identity of the exact source supplying the evidence when it differs from the reviewed work." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_method_branch
    a owl:DatatypeProperty ;
    rdfs:label "source_method_branch" ;
    rdfs:range xsd:string ;
    skos:definition "Source-declared analysis, sensitivity, ablation, or protocol branch represented by this profile." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_method_cohort
    a owl:DatatypeProperty ;
    rdfs:label "source_method_cohort" ;
    rdfs:range xsd:string ;
    skos:definition "Cohort or population slice to which this exact method variant applies." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_method_platform
    a owl:DatatypeProperty ;
    rdfs:label "source_method_platform" ;
    rdfs:range xsd:string ;
    skos:definition "Platform or device slice to which this exact method variant applies." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_method_variant_label
    a owl:DatatypeProperty ;
    rdfs:label "source_method_variant_label" ;
    rdfs:range xsd:string ;
    skos:definition "Source-facing label for this exact method variant." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_observed_setting
    a owl:DatatypeProperty ;
    rdfs:label "source_observed_setting" ;
    rdfs:range xsd:string ;
    skos:definition "Source-located statement from which this atomic setting was extracted." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_output_position
    a owl:DatatypeProperty ;
    rdfs:label "source_output_position" ;
    rdfs:range xsd:integer ;
    skos:definition "Zero-based position of this field in the source-declared output tuple." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_sequence_semantics
    a owl:DatatypeProperty ;
    rdfs:label "source_sequence_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Preserved acquisition or source-row order." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_session_id
    a owl:DatatypeProperty ;
    rdfs:label "source_session_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized identity of the session represented by this transaction, unique within the database; not authentication of an original raw key or recovered session constructor." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_sha256
    a owl:DatatypeProperty ;
    rdfs:label "source_sha256" ;
    rdfs:range xsd:string ;
    skos:definition "SHA-256 of the source bytes accepted by the diary source adapter." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_value_json
    a owl:DatatypeProperty ;
    rdfs:label "source_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical JSON serialization of the complete pre-atomization source value for reversible audit." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:start_action_reference
    a owl:DatatypeProperty ;
    rdfs:label "start_action_reference" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "^.*\\S.*$" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied start action ID for a Chang attending-action gap, resolving only inside its containing ringer occupancy. Null/omission is unknown; array order and timestamps never infer the reference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:start_condition
    a owl:DatatypeProperty ;
    rdfs:label "start_condition" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied start-condition token validated against the local constructor definition; not an inferred event occurrence." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:start_instant
    a owl:DatatypeProperty ;
    rdfs:label "start_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Interval start instant." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:start_observation_ref
    a owl:DatatypeProperty ;
    rdfs:label "start_observation_ref" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied start state-record ID, resolved within profile/participant/known device; null/omission is unknown, not reconstructed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:start_status
    a owl:ObjectProperty ;
    rdfs:label "start_status" ;
    rdfs:range chron:EndpointStatus ;
    skos:definition "Endpoint status of the start." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:started_at
    a owl:DatatypeProperty ;
    rdfs:label "started_at" ;
    rdfs:range xsd:string ;
    skos:definition "Execution start." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:state_interval_id
    a owl:DatatypeProperty ;
    rdfs:label "state_interval_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized interval-record ID local to profile/participant/device; equal bounds do not merge records." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:state_observation_id
    a owl:DatatypeProperty ;
    rdfs:label "state_observation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized state-record ID local to profile/participant/device; never derived from a timestamp." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_id
    a owl:DatatypeProperty ;
    rdfs:label "strategy_id" ;
    rdfs:range xsd:string ;
    skos:definition "Strategy identifier (unique key)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_kind
    a owl:ObjectProperty ;
    rdfs:label "strategy_kind" ;
    rdfs:range chron:ReconstructionStrategyId ;
    skos:definition "Canonical strategy category (IRI-bearing enum value)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_version
    a owl:DatatypeProperty ;
    rdfs:label "strategy_version" ;
    rdfs:range xsd:string ;
    skos:definition "Strategy version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:structured_protocol_candidate_json
    a owl:DatatypeProperty ;
    rdfs:label "structured_protocol_candidate_json" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical JSON preserving an evidence-derived candidate for a first-class acquisition, diary, session, duration, timestamp, release, or notification protocol object." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:synthetic_order_provenance
    a owl:DatatypeProperty ;
    rdfs:label "synthetic_order_provenance" ;
    rdfs:range xsd:string ;
    skos:definition "Provenance for a timestamp or order introduced by processing." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:target_region_id
    a owl:DatatypeProperty ;
    rdfs:label "target_region_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied identity of the drawn web pixel region, without invented geometry." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:task_action_id
    a owl:DatatypeProperty ;
    rdfs:label "task_action_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied action identity unique within the containing task or session; labels or equal times are not identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:task_label
    a owl:DatatypeProperty ;
    rdfs:label "task_label" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied task designation, including which script is meant when a source-setting definition contains multiple scripts." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:task_occurrence_id
    a owl:DatatypeProperty ;
    rdfs:label "task_occurrence_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied task identity scoped by profile/participant/device, not reconstructed from equal app/time tokens." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:task_occurrence_reference
    a owl:DatatypeProperty ;
    rdfs:label "task_occurrence_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied task identity within the same profile/source/participant/device; omission/null is unknown. Not a timing anchor, inferred original join, classifier input construction or questionnaire-answer reference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:terminal_sample_policy
    a owl:DatatypeProperty ;
    rdfs:label "terminal_sample_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Treatment of the last or incomplete observation in a run or window." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:text_capture_id
    a owl:DatatypeProperty ;
    rdfs:label "text_capture_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized saved-text record identity local to profile/participant/device, not a timestamp or text hash." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:text_change_case_id
    a owl:DatatypeProperty ;
    rdfs:label "text_change_case_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied case identity unique within its typing trial, independent of equal text." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:text_change_cases
    a owl:ObjectProperty ;
    rdfs:label "text_change_cases" ;
    rdfs:range chron:TextChangeCaseRecord ;
    skos:definition "Optional supplied case members in an action-membership trial; omission/null/[] remain distinct and no change extraction runs." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:tie_break_policy
    a owl:DatatypeProperty ;
    rdfs:label "tie_break_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Ordering or multiplicity policy within a tie group." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:tie_group_semantics
    a owl:DatatypeProperty ;
    rdfs:label "tie_group_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Identity of observations sharing an effective timestamp." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:timestamp_policy_id
    a owl:DatatypeProperty ;
    rdfs:label "timestamp_policy_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable timestamp-policy identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:timestamp_resolution
    a owl:DatatypeProperty ;
    rdfs:label "timestamp_resolution" ;
    rdfs:range xsd:string ;
    skos:definition "Source or effective timestamp resolution." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:title_annotation_id
    a owl:DatatypeProperty ;
    rdfs:label "title_annotation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized shared annotation identity scoped by profile/participant, not a recovered raw title/sender key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:title_annotation_reference
    a owl:DatatypeProperty ;
    rdfs:label "title_annotation_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied annotation ID resolved in the owning profile/participant; omission/null is unknown association. No app/title equality, device identity, sender parser or location join is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:token_evaluation_case_id
    a owl:DatatypeProperty ;
    rdfs:label "token_evaluation_case_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied word-evaluation identity unique within its containing trial, independent of equal token text." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:token_evaluation_cases
    a owl:ObjectProperty ;
    rdfs:label "token_evaluation_cases" ;
    rdfs:range chron:TokenEvaluationCaseRecord ;
    skos:definition "Optional supplied word-evaluation cases distinct from text-change cases; no tokenization or classifier runs, and omission/null/[] remain distinct." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:token_text
    a owl:DatatypeProperty ;
    rdfs:label "token_text" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied selected word text, optionally withheld; not reconstructed from keyboard actions or removed/reentered segments." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:trace_description
    a owl:DatatypeProperty ;
    rdfs:label "trace_description" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied semantic description of this whole trace/task (ODIM PDF p. 9 section 4.5), separate from event/screen descriptions and redaction justifications. Preserve text verbatim, including empty versus null/omission. No author, original serializer or manual/LLM generation route is inferred; the source's manual annotation implementation remains distinct from its illustrative LLM augmentation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:trace_record_origin
    a owl:ObjectProperty ;
    rdfs:label "trace_record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Distinguishes constructed examples from supplied normalized data without claiming source authentication." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:transaction_definition_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "transaction_definition_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional compatible local binary session-transaction definition, not a reference to duration-weighted features." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:trial_questionnaire_responses
    a owl:ObjectProperty ;
    rdfs:label "trial_questionnaire_responses" ;
    rdfs:range chron:TypingQuestionnaireResponseRecord ;
    skos:definition "Independent supplied trial-local questionnaire answers, not case follow-up feedback or recovered ESM joins; omission/null/[] remain distinct." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:typing_trial_id
    a owl:DatatypeProperty ;
    rdfs:label "typing_trial_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized typing-trial identity local to profile/participant/device; not a recovered trial constructor or timestamp key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:unknown_minutes
    a owl:DatatypeProperty ;
    rdfs:label "unknown_minutes" ;
    rdfs:range xsd:float ;
    skos:definition "Admitted minutes on this participant-day with no resolved person. In the denominator, never in the numerator, and never dropped." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:upload_policy
    a owl:DatatypeProperty ;
    rdfs:label "upload_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Upload trigger, batching, retry, and transport behavior." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:used_in_month
    a owl:DatatypeProperty ;
    rdfs:label "used_in_month" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:integer

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions (

                        [
                            xsd:minInclusive 0 ;
                        ]
                    ) ;
                ]

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions (

                        [
                            xsd:maxInclusive 1 ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Supplied binary cell: 1 used during month, 0 otherwise. Missing/null is unknown and never converted to zero; no installed-app inference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:verb
    a owl:DatatypeProperty ;
    rdfs:label "verb" ;
    rdfs:range xsd:string ;
    skos:definition "Action the operation performs." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:version_definition_id
    a owl:DatatypeProperty ;
    rdfs:label "version_definition_id" ;
    rdfs:range xsd:string ;
    skos:definition "Exact authoritative diary version definition selected for replication." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:zero_eligible_usage
    a owl:DatatypeProperty ;
    rdfs:label "zero_eligible_usage" ;
    rdfs:range xsd:boolean ;
    skos:definition "True when no App Usage or Non-Target Participant App Usage row on this participant-day was aggregate-eligible with nonzero minutes, so the share was 0/0. The engine's zero_real_usage column." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:DeviceSharingStatus
    a owl:Class ;
    rdfs:label "DeviceSharingStatus" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/DeviceSharingStatus#shared>
        <https://w3id.org/chronicle-usage-ontology/core/DeviceSharingStatus#non_shared>
    ) ;
    skos:definition "Whether a participant's device is declared shared, as the compliance step reads it from the device-sharing support file. Emitted verbatim in the `sharing_status` column of the `compliance_csv`." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/DeviceSharingStatus#non_shared> ,
        <https://w3id.org/chronicle-usage-ontology/core/DeviceSharingStatus#shared> ;
.

chron:DeviceStateIntervalKindId
    a owl:Class ;
    rdfs:label "DeviceStateIntervalKindId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/DeviceStateIntervalKindId#screen_bout>
        <https://w3id.org/chronicle-usage-ontology/core/DeviceStateIntervalKindId#unlock_cost_upper_bound>
    ) ;
    skos:definition "Distinct supplied interval meanings, not reconstruction algorithms or raw codes." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/DeviceStateIntervalKindId#screen_bout> ,
        <https://w3id.org/chronicle-usage-ontology/core/DeviceStateIntervalKindId#unlock_cost_upper_bound> ;
.

chron:HierarchyRedactionEffectId
    a owl:Class ;
    rdfs:label "HierarchyRedactionEffectId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#corresponding_text_content_tagged>
        <https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#qualifying_element_metadata_removed>
    ) ;
    skos:definition "Tagging corresponding text/content and removing qualifying metadata are not interchangeable." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#corresponding_text_content_tagged> ,
        <https://w3id.org/chronicle-usage-ontology/core/HierarchyRedactionEffectId#qualifying_element_metadata_removed> ;
.

chron:InteractionRedactionSelectionId
    a owl:Class ;
    rdfs:label "InteractionRedactionSelectionId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/InteractionRedactionSelectionId#selected_ui_element>
        <https://w3id.org/chronicle-usage-ontology/core/InteractionRedactionSelectionId#drawn_region_sufficient_iou>
    ) ;
    skos:definition "ODIM's distinct device and web selection relations (PDF pp. 8-9, section 4.4); no IoU cutoff is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/InteractionRedactionSelectionId#drawn_region_sufficient_iou> ,
        <https://w3id.org/chronicle-usage-ontology/core/InteractionRedactionSelectionId#selected_ui_element> ;
.

chron:KeyguardStateId
    a owl:Class ;
    rdfs:label "KeyguardStateId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#LOCKED>
        <https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#UNLOCKED>
    ) ;
    skos:definition "Normalized supplied keyguard state; screen-off does not imply locked (Hard Lock Life, printed p218 Figure1)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#LOCKED> ,
        <https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#UNLOCKED> ;
.

chron:MaximumDurationThresholdSourceId
    a owl:Class ;
    rdfs:label "MaximumDurationThresholdSourceId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#strategy_native>
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#chronicle_legacy_config>
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#fixed_parameter>
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#b12_adaptive_participant>
    ) ;
    skos:definition "Where the selected policy's threshold comes from. Each policy accepts exactly one pairing: strategy_native with strategy_native, chronicle_observed_close_rejection_v1 with chronicle_legacy_config, and post_reconstruction_strict_max_v1 with fixed_parameter or b12_adaptive_participant. Any other pairing refuses with request_shape_invalid; no missing sibling is filled in." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#b12_adaptive_participant> ,
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#chronicle_legacy_config> ,
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#fixed_parameter> ,
        <https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#strategy_native> ;
.

