{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzaira0:semantic-federation:protocol:projection-loss:0.1",
  "title": "Declared loss in a derived projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_id", "source_digest", "projection_version", "losses"],
  "properties": {
    "projection_id": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projection_version": { "type": "string", "minLength": 1 },
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["omitted", "aggregated", "redacted", "approximated", "renamed"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
