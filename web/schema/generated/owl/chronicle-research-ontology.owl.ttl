chron:assessment_case_token
    a owl:DatatypeProperty ;
    rdfs:label "assessment_case_token" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied case identity scoped to profile/source, independent of rater, text label, description or response. Meaningful primary339–354 has authored app-use cases followed by independent ratings of shared cases. DynamicSecurity layout874–896 supplies shared question/options identities across legitimate/adversarial responders, without requiring literal role-varying wording equality. This token preserves a supplied relationship across completions without recovering original IDs or declaring a case catalog. Null/omission is unknown identity; equal labels do not imply equal cases." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

