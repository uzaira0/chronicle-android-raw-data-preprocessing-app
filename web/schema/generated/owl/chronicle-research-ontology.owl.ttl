.

<https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#recomputed>
    a owl:Class ;
    rdfs:label "recomputed" ;
    rdfs:subClassOf chron:QueryExecutionStatus ;
    skos:definition "Evaluated during this run." ;
.

<https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#skipped>
