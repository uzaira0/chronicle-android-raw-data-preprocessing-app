            sh:description "Settings specific to this level or branch." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:branch_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source statements retained for audit but not treated as selectable method values." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:documentary_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-facing label for the level." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_configuration_level_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Settings shared by every level in this group." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:common_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one source-declared configuration level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_configuration_level_id ;
        ] ;
    sh:targetClass chron:MethodConfigurationLevel ;
.

chron:MethodConfigurationSelection
    a sh:NodeShape ;
    rdfs:comment "One exact selection from a source-declared configuration space." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one exact source configuration selection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_configuration_selection_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact levels included in this source-enumerated combination." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:selected_method_configuration_level_ids ;
        ] ,
        [
            sh:description "Exactness and source authorization state of the selection." ;
            sh:in (
                "exact"
                "incomplete"
                "prohibited"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path chron:method_configuration_selection_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Fail-closed reasons preventing an exact selection." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:method_configuration_selection_blockers ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact setting inventory active under this selection." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:effective_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Configuration-space identity from which this selection was made." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_configuration_space_reference ;
        ] ;
    sh:targetClass chron:MethodConfigurationSelection ;
.

chron:MethodConfigurationSpace
    a sh:NodeShape ;
    rdfs:comment "The complete source-declared choice space for one retained method. Levels and combinations are explicit; absence of an allowed combination forbids inventing a Cartesian product." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Settings that apply to every selectable configuration in this space." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:invariant_method_setting_ids ;
        ] ,
        [
            sh:description "Relationship among this source's method specifications; never infer unreported cross-products." ;
            sh:in (
                "fixed"
                "full_factorial"
                "one_factor_at_a_time"
                "coherent_joint_specifications"
                "ablation"
                "cross_study_catalog"
                "source_declared_axes"
                "enumerated_combinations"
                "conditional"
                "documentary_only"
                "evidence_blocked"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path chron:method_configuration_structure ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Evidence-blocked settings preventing complete configuration selection." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:unresolved_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Settings explicitly reported as not applicable to this source method." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:not_applicable_method_setting_ids ;
        ] ,
        [
            sh:class chron:MethodConfigurationCombination ;
            sh:description "Only combinations explicitly enumerated by the source." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path chron:allowed_method_combinations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source statements retained for audit but not treated as selectable method values." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:documentary_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of a source method's configuration space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_configuration_space_id ;
        ] ,
        [
            sh:class chron:MethodConfigurationGroup ;
            sh:description "Source-declared configuration groups; group relationships do not imply a cross-product." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path chron:method_configuration_groups ;
        ] ;
    sh:targetClass chron:MethodConfigurationSpace ;
.

chron:MethodContractBinding
    a sh:NodeShape ;
    rdfs:comment "One exact compilation target for a method setting. It binds one generated runtime slot to one canonical JSON value. Candidate semantic mappings stay in mapped_contract_slot; only this class authorizes compilation." ;
