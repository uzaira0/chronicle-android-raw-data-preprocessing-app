            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:GlanceAssertion ;
.

chron:InteractionTraceRecord
    a sh:NodeShape ;
    rdfs:comment "A supplied normalized current interaction trace, not a device-use session, prospective method plan or claimed ODIM serialization. Events belong to this trace in explicit sequence positions; absent events are not current members. ODIM PDF pp. 6-7 sections 4.2-4.3 supports sequential events and manual removal. No timestamp-sort predicate, edit journal or payload-byte verification is implied." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied semantic description of this whole trace/task (ODIM PDF p. 9 section 4.5), separate from event/screen descriptions and redaction justifications. Preserve text verbatim, including empty versus null/omission. No author, original serializer or manual/LLM generation route is inferred; the source's manual annotation implementation remains distinct from its illustrative LLM augmentation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:trace_description ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied trace participant identity. Known identities constrain linked tasks; unknown identity is not inferred from payloads or accounts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized identity of one current interaction trace." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:interaction_trace_id ;
        ] ,
        [
            sh:class chron:InteractionEventRecord ;
            sh:description "Current members only; their explicit sequence positions define order independently of JSON array ordering or timestamps." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path chron:interaction_events ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:description "Distinguishes constructed examples from supplied normalized data without claiming source authentication." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:trace_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:InteractionTraceRecord ;
.

chron:KeyboardTransactionRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied keyboard action independent of any reconstructed trial. Preserve both text states, the opaque timestamp, application package and supplied normalized boolean flags independently. Figure4 prints 0/1 flags but does not disclose its deployed raw serializer or timestamp unit. Trial membership may remain unknown; no source row key, correction verdict or sequence position is inferred from equal time/text values." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Supplied normalized boolean password-field flag; password phrases are not reconstructed from masked source data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:is_password ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Supplied normalized boolean deletion flag, not a recovered 0/1 source serialization or an edit classifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:is_deleted ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied keyboard-event timestamp token; Figure4 prints 13-digit examples but formal source storage unit is unreported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:keyboard_timestamp ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Whole field text after this keyboard action; not a screen-text snapshot or inferred token/correction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:current_text ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Whole field text before this keyboard action, independently preserved from current_text; null, empty and omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:before_text ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local source-located keyboard before/after transaction schema, distinct from an Accessibility text snapshot." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:keyboard_schema_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied action identity local to profile/participant/device, not inferred from equal time, text or package." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:keyboard_transaction_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:app_package_name ;
        ] ;
    sh:targetClass chron:KeyboardTransactionRecord ;
.

chron:LiteratureInputAdapterContract
    a sh:NodeShape ;
    rdfs:comment "A closed, versioned registration that promotes source-backed method settings only when an existing Chronicle upload role can carry the observations and a named Rust adapter validates or transforms them. The setting inventory is exact: unregistered settings remain blocked and no missing values are synthesized." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Existing raw or support-file role consumed by the adapter." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:literature_input_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact raw or support fields required for conformance." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:literature_input_required_fields ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Closed schema identity validated at ingestion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:literature_input_schema_id ;
        ] ,
        [
            sh:description "Protocol-input or native-operator route used by the adapter." ;
            sh:in (
                "native_option_binding"
                "protocol_input"
                "native_operator_parameter"
                "external_named_executor"
                "receipt_conformance"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path chron:literature_input_route_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact promoted method-setting inventory for this adapter registration." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:literature_input_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Existing schema-driven upload surface that supplies this role." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:literature_input_gui_surface ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Audited semantic input artifact group." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:literature_input_semantic_type ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Registered Rust input adapter identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:literature_input_adapter_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact adapter version committed to execution receipts." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:literature_input_adapter_version ;
        ] ;
    sh:targetClass chron:LiteratureInputAdapterContract ;
.

chron:LoggingObservation
    a sh:NodeShape ;
    rdfs:comment "OPTIONAL. The OS logger's act of observing a device property, modeled only if that abstraction is genuinely needed. Do NOT type UsageEventRecord as this." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:class chron:UsageEventRecord ;
            sh:description "The event record produced by the logging observation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:result_record ;
        ] ;
    sh:targetClass chron:LoggingObservation ;
.

chron:MonthlyAppUseCellRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied partial user/app/month binary cell, as distinguished in Sekara et al. Scientific Reports2021 Figure1 and Methods. One means used in that month and zero otherwise, not installed/uninstalled. Omitted/null values are normalized unknowns, never filled with zero. App and user tokens are opaque pseudonymous identifiers, not inferred packages or hash algorithms. No day/session, calendar boundary, complete fingerprint, eligibility or annual maximum/OR computation is inferred from these supplied cells." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Supplied binary cell: 1 used during month, 0 otherwise. Missing/null is unknown and never converted to zero; no installed-app inference." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:used_in_month ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank month token, preserving wording without inferred days, timezone, bounds or calendar conversion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:month_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied app identity, including pseudonymous labels; not necessarily an Android package name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:app_identifier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized app-use cell record identity local to profile/participant/device; not derived by concatenating tensor coordinates." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:cell_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:MonthlyAppUseCellRecord ;
.

chron:NotificationCallbackGroupRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized group of independently recorded notification-posted callbacks, with an optional supplied member designated as an analytic alert proxy. Dismissed! (DOI 10.1145/3229434.3229445), printed pp.3:3–3:4, distinguishes posted-event bursts from usually perceived alerts and retains the last posted event after title filtering. The retained callback itself is the proxy; no third proxy identity or logical notification-item identity is required. Group membership and designation are supplied, not computed. Positive proxy references resolve only within this group at ingress; omission/null is unknown, not observed perception or a negative alert. Ingress admits only recorded posted_callback members, retaining opaque times, lexical payloads, local supporting references and supplied order. Group IDs are scoped by profile/participant/supplied device, not recovered raw keys. No timestamp sorting, LAST selection, title filtering, second bucket, grouping partition, tie rule or notification matching is inferred. Equal times or payloads do not merge independently identified callbacks." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied evidence_record_id of the posted member retained as an analytic alert proxy in this callback group. Null/omission stays unknown. No perception observation, LAST computation, sorting or third proxy identity is asserted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:analytic_alert_proxy_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized posted-callback group identity scoped by profile/participant/supplied device; not a notification item or an automatically computed second bucket." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:callback_group_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:NotificationEvidenceRecord ;
            sh:description "Supplied recorded posted_callback members local to this group; no item owner or automatically reconstructed burst is asserted." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path chron:notification_evidence ;
        ] ,
        [
            sh:description "Example versus supplied normalized history; not authenticated original rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:history_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:NotificationCallbackGroupRecord ;
.

chron:NotificationDrawerSnapshotRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied normalized observation of pending Android drawer state, not a posted/removed callback, image, usage session or prospective method. Clear All PDF pp.4-5. Required empty membership means observed empty; an absent snapshot does not. A normalized ID is not the source ascending transmission ID. No inter-snapshot arrival, removal, dismissal, continuous residence or fixed realized sampling interval is inferred (PDF p.10)." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual manufacturer at this observation (Clear All PDF p.4), without case normalization or eligibility filtering." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:device_manufacturer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied opaque textual representation of the source transmission ID, separate from normalized snapshot identity (Clear All PDF p.4 filtering rule4). No numeric coercion, monotonicity, missing-counter inference or original serialization is asserted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:snapshot_transmission_id_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual Android version at this observation (Clear All PDF p.4); not an inferred numeric version or immutable device attribute. Empty, null and omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:android_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized snapshot identity scoped by profile and device; not a generated transmission counter." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:snapshot_record_id ;
        ] ,
        [
            sh:description "Explicit example versus supplied normalized record status; neither authenticates source serialization." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path chron:snapshot_record_origin ;
        ] ,
        [
            sh:class chron:NotificationItemAppearanceRecord ;
            sh:description "Observed pending membership; an empty array is not a missing or unobserved snapshot." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path chron:pending_item_appearances ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual product name at this observation (Clear All PDF p.4), not an assumed model alias." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:device_product ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Original recording timezone (preserved)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:timezone ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual model at this observation (Clear All PDF p.4), without an inferred model codebook or immutable device attribute." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:device_model ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized observation-time representation; original encoding and epoch are not inferred or converted here." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:snapshot_instant ;
        ] ;
    sh:targetClass chron:NotificationDrawerSnapshotRecord ;
.

chron:NotificationHistoryRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied normalized item history with independently retained evidence, linked subjective responses and supplied acceptance outcomes. My Phone and Me (2016), accepted manuscript pp.3-4 and p.8. Identity is local to the profile, participant and supplied device (when known), not a recovered raw key, Clear All identity definition or a package/title/time match. Inlining scopes references to this item; it does not imply exclusive ownership of a world occurrence such as an unlock shared by multiple pending items. No action matching, timestamp arithmetic, acceptance recode or missing-data completion runs during import. Tokens, omissions and supplied order remain. Optional original-history references distinguish a temporary snooze prompt or retriggered copy from the original item (Snooze DOI 10.1145/3229434.3229436 pp.3–4 Figure2). Supplied references resolve within profile/source/participant/device, including forward references; no package/title matching, chronology or five-second realized interval is inferred." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:NotificationQuestionnaireResponseRecord ;
            sh:description "Supplied answers linked to this item only; omission/null is not a negative answer or complete-response claim." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path chron:questionnaire_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized title text (My Phone and Me p.4 Table1); empty, null and omission remain distinct. Not notification content or an identity key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:notification_title ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied original item-history ID for a temporary snooze prompt or retriggered copy. Positive references resolve to another history within profile/source/participant/device at ingress; forward references are allowed and null/omission is unknown. No identity matching or chronology is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:original_notification_history_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized item-history record identity scoped by profile/participant/known device." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:notification_history_id ;
        ] ,
        [
            sh:description "Example versus supplied normalized history; not authenticated original rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:history_record_origin ;
        ] ,
        [
            sh:class chron:NotificationAcceptanceRecord ;
            sh:description "Independently supplied acceptance outcomes; null means supplied unknown and import calculates none or substitutes recorded behavior." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path chron:acceptance_records ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied annotation ID resolved in the owning profile/participant; omission/null is unknown association. No app/title equality, device identity, sender parser or location join is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:title_annotation_reference ;
        ] ,
        [
            sh:class chron:NotificationEvidenceRecord ;
            sh:description "Independently retained supplied evidence records local to the owning item history or callback group; no ordering or pairing reconstruction." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:notification_evidence ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized item reference scoped by profile/participant/known device; no Clear All basis or source-key recovery is asserted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:notification_item_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:NotificationHistoryRecord ;
.

chron:NotificationOpeningOccurrenceRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied normalized opening occurrence shared by item-specific inferred views. In-Situ notifications (DOI 10.1145/2628363.2628364), p.4 Notification Viewed. Identity is scoped by profile/participant/supplied device, never inferred from equal app/time tokens. Optional membership retains supplied pending app items or shown drawer items; omission/null is unknown and an empty list is explicitly empty. Positive links require a known common device at ingress. No pending queue, matching, time conversion or inference runs. Normalized IDs and relationships do not claim recovered source keys or original rows. Opening is not observed reading, dismissal or response." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied history IDs for pending items associated with the opened app or shown in the opened drawer. Positive members resolve within profile/participant/known device; omission/null is unknown, [] explicitly empty. No pending reconciliation runs." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:pending_history_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized shared opening identity scoped by profile/participant/device; distinct occurrences remain distinct even at equal supplied app/time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:opening_occurrence_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized opening, not original-source authentication." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:opening_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual opening time; omission/null is unknown. No verified epoch, precision, timezone, or equality with inferred view time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path time:inXSDDateTimeStamp ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied app identity for an application opening; null/omission stays unknown. Drawer membership does not require app equality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:description "Application-opening versus drawer-opening proxy, not an OS process launch or actual reading." ;
            sh:in (
                "app_opening"
                "drawer_opening"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path chron:opening_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:NotificationOpeningOccurrenceRecord ;
.

chron:NotificationTitleAnnotationRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied participant-relative multi-label annotation of a communication title, shared by referenced notification items; not a permanent category, globally identified sender or deduplicated notification. Content-driven notifications (DOI 10.1145/2750858.2807544), p.4 Dataset and footnote2. Normalized identity is scoped by profile and participant, not app/device. Labels remain independent of each item's location-resolved category. Optional title allows withheld/discarded raw content (p.4 privacy passage); omission/null is not an invented title hash. No matching, deduplication, normalization, GPS join or category resolution runs during import." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized title text (My Phone and Me p.4 Table1); empty, null and omission remain distinct. Not notification content or an identity key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:notification_title ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied participant-relative relationship labels (Content-driven notifications p.4: work, social, family, other); multiple labels retained in supplied order, not a priority list or inferred category." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:sender_relationship_labels ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized shared annotation identity scoped by profile/participant, not a recovered raw title/sender key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:title_annotation_id ;
        ] ,
        [
            sh:description "Example versus supplied normalized annotation; not authenticated original labels or title matching." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path chron:annotation_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:NotificationTitleAnnotationRecord ;
.

chron:ParticipantDayObservationRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied populated objective aggregate, subjective response or collection-run modality availability owned by a profile/work/participant, an optional explicitly supplied device, and exactly one supplied day, specific-hour, night or collection-run identity. Energy Drain2015 §3.4 distinguishes daily energy per device; device identity is never inferred from participant identity. Same- and cross-period supports stay within the supplied device owner (or the unknown-device owner when omitted/null). The class and day_* transport names are retained for compatibility; an hour or night is never stored in referenced_day_token. CHI2020 Paper36 p5 CCM separately aggregates each retained emotion, application launches and use duration per participant per one-hour period. Hour tokens identify particular periods, not recurring hour-of-day buckets, and do not establish their endpoints. In-Situ notifications pp.3-4 asks about the prior day; p.6 associates daily objective notification logs with subjective responses about that same day. No notification-item identity is required. Each period token is opaque, not an inferred calendar date, cutoff, timezone or raw study join key. Values, units, categories and optional question wording are supplied independently; absence/null is not zero. Subjective supports point only to objective records in the same owner/period kind/token unless an explicit cross-period reference identifies a different target period and the supplied relationship. Murnane2016 pp3,7–8 distinguishes prior-night sleep, following-day use and event counts during that night. No night/day identity or adjacency is inferred. Moodable primary508–517,603–611,685–689 separately permits any subset of contributed modalities. Run-owned modality availability uses its local method definition, not a day or classifier campaign; run tokens do not assert repeated original participation. Unavailable does not infer why data were not contributed. Import neither aggregates, joins timestamps, schedules prompts nor computes correlations. Normalized origin does not authenticate original participant rows or recover the full instrument." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied wording on a subjective response only; omission/null does not recover undisclosed wording." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied category scope, independent of property/value; not a reconstructed app classifier. Null/omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:observation_category ;
        ] ,
        [
            sh:description "Objective period aggregate, subjective response or run-owned modality availability; none substitutes for another. Legacy day-named transport key retains explicitly supplied owner kinds." ;
            sh:in (
                "objective_aggregate"
                "subjective_response"
                "modality_availability"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path chron:day_observation_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied support IDs on a subjective response, resolving to objective records in the same profile/participant/period kind/token. Equal day/hour token strings do not establish the same period. Null/omission is unknown support, [] explicitly empty; no category-equality or correlation is inferred." ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path chron:aggregate_observation_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON value retained without recoding or numeric coercion; zero, JSON null, supplied null and omission stay distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:day_observation_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque collection/assessment-run identity for participant modality availability (Moodable primary508–517,603–611,685–689). Not a day/hour/night, model campaign, clock or original repeated-participation claim; mutually exclusive with period tokens." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:referenced_run_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of the day described, mutually exclusive with hour/night tokens; not substituted from prompt/submission time, parsed, calendar-normalized or timezone-converted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:referenced_day_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of a particular one-hour period, not an hour-of-day bucket, day or night. Mutually exclusive with day/night tokens; no endpoints, timezone or timestamp join inferred (CHI2020 Paper36 p5 CCM)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:referenced_hour_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of the night described, not a calendar day, prompt time, source serializer or inferred sleep interval. Mutually exclusive with day/hour tokens; no endpoints or preceding/following day recovered (Murnane2016 pp3,7–8)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:referenced_night_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied package identity for per-app period observations (Screenomics2024 primary236–257; Energy Drain2015 §4). Independent of observation_category and supplied device; omitted/null identity never implies a category-wide total or a UID/package join, and overlapping categories are not collapsed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:class chron:CrossPeriodAggregateReference ;
            sh:description "Supplied explicit comparisons/supports on a subjective response to objective observations in different periods under the same profile/work/participant. Each target uses its exact period kind/token and observation ID; labels/locators remain supplied. Null/omission is unknown support, [] explicitly empty; no cross-period link is inferred from equal IDs, values or timestamps." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path chron:cross_period_aggregate_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied measured quantity or subjective-property label; not necessarily verbatim question wording or a raw field name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local quality-control definition required only for collection-run modality availability; absent on period aggregates/responses." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied unit for this quantity alone; no numeric conversion or inferred unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:evidence_unit ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized participant-period record; legacy key, not original-source authentication." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path chron:day_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied observation identity scoped by profile/participant/period kind/token, not a raw join key; legacy day-named transport supports explicit hour ownership." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:day_observation_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:ParticipantDayObservationRecord ;
.

chron:RingerStateIntervalRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized ringer-setting occupancy over an interval, not a continuous device-use session, mode-change callback or executed constructor. Chang and Tang (2015), printed p.12 / PDF p.7, defines occupancy until a different mode and calculates attendance gaps within that scope. The local source policy preserves the unknown powered-off duration (printed pp.14-15 / PDF pp.9-10); no bridge, deletion, duration or endpoint is inferred here. IDs and tokens are normalized, not recovered source serialization." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Supplied normalized records versus constructed example; neither authenticates source rows or reconstruction." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path chron:interval_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:description "Supplied normalized setting occupied over denotes_interval; no numeric-code conversion or phone-use inference." ;
            sh:in (
                "Normal"
                "Vibrate"
                "Silent"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path chron:ringer_mode ;
        ] ,
        [
            sh:class chron:TaskActionRecord ;
            sh:description "Supplied device- or tracked-app-session-local action/activity membership in supplied array order; actions need not identify an app. Null/omission is unknown membership, [] supplied empty, never a reconstructed or complete-zero assertion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path chron:session_actions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:SessionQuantityRecord ;
            sh:description "Supplied session-owned quantities in preserved order; null/omission unknown and [] explicitly empty. Local IDs and definition/scope compatibility are checked by ingress, not inferred from action membership." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path chron:session_quantities ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized interval record identity scoped by profile and participant." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:ringer_state_interval_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned policy ID whose output is device_setting_state_interval; not an execution receipt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:session_construction_policy_reference ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:RingerStateIntervalRecord ;
.

chron:SampledQuantityObservationRecord
    a sh:NodeShape ;
    rdfs:comment "TimeKilling CHI2023 additionally retains supplied capture-pair and feature identities distinct from source phone-use screenshot sessions and nonoverlapping seven-pair prediction sequences. Optional parent/child screenshot references retain supplied membership without clock equality, padding inference or tensor/model execution. Explicit padding, unknown membership and captured black images are distinct. Source-qualified quantities retain current/session/past-window scopes and named axes; independently supplied user/group and model summaries do not manufacture participants or calculate outputs. Supplied normalized observation with independently retained quantities and an explicitly typed subject. Falaki et al. IMC2010 Section2 Dataset2 records these every two minutes; Section4's later per-application interval analysis does not disclose cumulative-versus-delta storage or process/app joins. Tokens and IDs are supplied, not inferred packages, PIDs or clocks. Equal subjects, times and values do not merge observation identities. Missing quantities remain unknown; no arithmetic or interval construction. Hush Section3.1 additionally distinguishes process/core CPU readings, core frequency-residency durations, UID network bytes and device battery and signal readings; PID/UID-to-app aggregation is not inferred. CHI2020 Sarsenbayeva p3 supplies participant facial-expression confidence values from 0 to 100, not probabilities, percentages or questionnaire answers. Energy Drain2015 §§3–5 additionally supplies device summaries and distinct application-owned foreground/background/component quantities, independent application-category averages/totals/shares and version-scoped foreground drain rates plus total foreground energy/time/EDR. A category aggregate is not an individual app or evidence of app membership. An app token is not a process or Android UID; its identity and any period token are supplied, never joined. Participant context may be omitted/null only for exact source-compatible across-device Energy app/category summaries, Meaningful pooled U&G shares, Falaki across-user application-category popularity and Next App Table2 application classifications, and exact Mercati DATE2014 per-core reporting records from the hardware-only governor experiment with supplied device/core ownership. The wireless-signal controlled handset, system-call-model and validation observations (doi:10.1145/2465529.2466586) additionally permit unknown human context only with a supplied device; volunteer trace and selected-user what-if observations still require participant ownership. Screen Text and Angry Birds additionally distinguish exact source-scoped participant-group summaries from individual participant observations; unknown original group IDs are not manufactured. Screen Text application and application-category summaries retain their distinct subject kinds. A cohort or hardware device is never manufactured as a participant. Observation time may be omitted for study-wide summaries. Import performs no division, mean, weighting, membership propagation or classifier execution. Energy Drain2015 Section2.5 additionally retains independent dynamic event occurrences, not resulting state snapshots; source event time remains distinct from collection time. Appendix A logged per-core CPU frequency is not a residency duration, and raw screen brightness has an unreported unit, not the later duration-weighted percentage. Its UID-owned Nsnd/Nrcv byte values and T interval in seconds remain independent supplied quantities, without a UID-to-app join, cadence inference or network-call or energy reconstruction. Supplied student-course subjects keep the participant as the student and require a separate opaque course token. Distinct class/attendance evidence observations do not merge on course equality; explicitly supplied same-owner supports retain Wi-Fi-primary, GPS-building fallback and unavailable-evidence distinctions without inferring attendance. Scheduled, attended and effective class time, screen exposure and the class-time denominator remain independent. Source-compatible local definitions constrain entity, property and units. Next App §§3–5 additionally retains separately identified raw action occurrences, independently supplied basic/last-family vector features, app-opening analysis anchors and role-specific sampled supports. A following Gaussian context member is not a preceding last-action feature. Static inventories, cold-app class/prior values and explicit cold-user inventory/history relationships retain their independent owners. Vectors do not establish a dimension, training recipe or computed representation. No callback equivalence, latest selection, time ordering, Gaussian draw, aggregation, class cutoff or cross-user history alignment is inferred. Supplied predictor rows may name a same-owner task explicitly, without asserting an action anchor, original row join, window bounds or calculation. A supplied scan can own ordered AP appearances; a supplied inferred place can own AP/cell members. List position is not a rank or clustering proof. Root membership is an optional local reference, never inferred from order. Device summaries over observed days are not particular-day observations. A current-running-app snapshot owns simultaneous application appearances; a supplied per-user binary feature row owns vocabulary members with independent app-use values. Neither implies launch, foreground attribution or a reconstructed episode. A static installed-app inventory owns installed applications and optionally supplied native versus user-installed origin. Static membership is not a particular-day, monthly-use or running claim. No source cadence, timestamp, binary conversion, inventory count, native proportion or raw-to-derived join is inferred from members. A ranked recent-task snapshot can instead own application members with independently supplied source keys, zero-based ranks, boot-elapsed logging-time tokens, component strings and source values (Gouin-Vallerand2014 p3 Sample1). Per-member times may differ within a list; they are not a parent collection instant or a known launch time. No scalar time unit, boot-to-wall-clock join, unchanged-list filtering, rank reversal or transition is inferred. Mercati DATE2014 Figure2 per-core H/L allocation is distinct from scheduler PID observations, dynamic H-PID lists, foreground episodes and idle frequency context. Experimental seconds and reliability virtual-years quantities remain independent of scheduler/temperature cadences and the accelerated aging definition. H never constructs a maximum-frequency value; the reported budget-exhaustion qualification and unknown raw-to-plot constructor persist. Tapping2024 app/tap observations additionally admit explicitly supplied phone-session and local foreground-period action references. A→B→A visits retain independent identities. Source event time is not collection time; these supports never select a nearest episode or construct app periods. Independent authentication durations need not belong to the usage cohort; configuration booleans are normalized truth values, not recovered codes. PlacesActivities activity reports and CoronaHealth released active-use or inferred-inactivity records may additionally retain a supplied UsageInterval. That optional interval is not a fabricated task, place visit, day, inferred boundary pair or computed duration. Its endpoints and duration remain independent, with omission, null and populated values distinct. Corona submission observations keep ordered optional app blocks and separately permissioned coarse GPS; release windows are not necessarily one day. PlacesActivities context summaries distinguish participant means by activity, place type or characteristic from pooled participant-group summaries. Sleep Prediction daily graphs likewise retain an explicit participant-group owner, directed peer-day edges and independently supplied own previous-day quality. No callback, submission/GPS equality, calendar offset, membership, category, threshold, mean, questionnaire score or prediction is inferred." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied identity of the typed subject, including independently identified applications, categories and student courses. A course token is not a class/attendance occurrence ID; distinct observation IDs preserve those instances. Null/omission remains unknown, not an inferred app package, PID, UID equality, app/category membership or cross-observation join." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:observed_entity_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied screenshot child within its explicitly referenced screenshot-session parent. A known child requires that parent; missing/null child remains unknown. No timestamp equality, inferred nearest image, padding inference or recovered serializer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:screenshot_record_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied cross-carrier screenshot-session parent. TimeKilling CHI2023 pp6–7 supplies a real phone-use parent distinct from prediction sequences; importer resolves source/profile/participant/compatible known device without constructing sessions or joins." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:screenshot_session_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional opaque source-designated event time, distinct from observation_instant collection time. Boredom Table1 has screen on/off/unlock occurrences and timed incoming/outgoing call and receiving/reading/sending SMS occurrences; WhyStop p3 also records timestamped RINGING/SMS_RECEIVED occurrences. Each is independently owned by its source definition, not a state snapshot or an invented task/session group. No point-time conversion, cadence, boundary pairing, temporal order, collector execution or ESM join is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path chron:source_event_time_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied task identity within the same profile/source/participant/device; omission/null is unknown. Not a timing anchor, inferred original join, classifier input construction or questionnaire-answer reference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:task_occurrence_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied action/foreground-period or unlock-attempt ID local to the explicitly referenced parent device session. A nonnull action requires its parent; known app/role contradictions reject without inferring unknown membership or timing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:session_action_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact TimeKilling supplied group summaries additionally permit omitted/null individual context only on their source-authorized pooled route; no individual participant or device is inferred. Optional supplied context only for source-compatible application/application-category Energy Drain2015 aggregates, Meaningful pooled application U&G shares, Falaki across-user application-category popularity, Next App Table2 application classifications, exact Screen Text pooled application/category, participant-group or explicitly scoped place summaries, exact Angry Birds pooled application/category/participant-group and Kim2019 pooled application/participant-group summaries, and exact Mercati DATE2014 hardware-only per-core reporting records with supplied device/core ownership. Exact doi:10.1145/2465529.2466586 controlled handset, system-call-model and validation device/process observations also permit omitted/null human context only with a nonblank device; volunteer trace and selected-user what-if rows still require participant context. Exact PlacesActivities pooled context summaries and Sleep Prediction supplied daily graphs also permit omitted/null human context only as participant-group subjects without an individual participant/device. Exact KeyboardStress pooled participant-group windows/features and HMOG controlled-device energy observations also permit omitted/null human context; the former cannot name an individual participant/device and the latter require the supplied device. The importer retains a required nonblank participant for all other subject/source routes, including named-person Screen Text summaries, ordinary HMOG authentication and Hush CPU cores; it never invents a cohort or hardware participant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied collection-time token; no units, timezone or observed interval bounds inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:observation_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied ordered Screen Text capture membership, source-qualified and local to profile/source/participant/compatible known device. Per-screen density/sentiment admits at most one known capture, sequential phrase difference at most two, and selected-set screen counts admit independently supplied members. Null/omission/empty membership remains distinct; no timestamp selection, chronology, completeness, set arithmetic or aggregate is inferred." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:screen_text_capture_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied tracked-app-session membership for this independently identified observation. Resolve within profile/source/participant and compatible known device; unknown device must not produce an ambiguous join. No session membership, observation timestamp, movement episode or interval is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path chron:app_interruption_session_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied observation identity local to profile/participant/device; equal time or entity tokens do not merge records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:sampled_observation_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied root member ID resolved within the same inferred group; omission/null is unknown, never the first member by convention." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path chron:root_entity_member_reference ;
        ] ,
        [
            sh:class chron:SampledQuantityRecord ;
            sh:description "Independently retained supplied quantities; [] is empty membership, omission/null unknown. No sum, counter difference, reset repair or unit conversion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path chron:quantities ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:class chron:SampledEntityMemberRecord ;
            sh:description "Ordered supplied members of one scan or inferred group; [] is an observed empty membership while omission/null is unknown. No clustering, deduplication or inferred cross-observation join." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path chron:entity_members ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicit subject kind constrained by the local source definition; an application, application category and participant group are distinct subjects, not an individual participant, process, core, Android UID, device, supplied course or inferred place. Participant groups are admitted only for exact source-scoped aggregate definitions. No PID/UID/package identity join, app/category/cohort membership or calendar window is implied." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:observed_entity_kind ;
            sh:pattern "^(process|cpu_core|android_uid|device|participant|participant_group|place|course|application|application_category)$" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied parent device-session ID. Exact source-compatible children resolve one unique same-profile/work/participant parent with compatible known device; unknown device never selects among multiple parents. Null/omission remains unknown. No clock or raw join is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:device_use_session_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:class chron:SampledObservationReferenceRecord ;
            sh:description "Source-compatible role-qualified supplied supports or memberships; omission/null is unknown, [] explicitly empty supplied links. Order is preserved, not temporal chronology. Actual importer validates each source's roles, target definition and ownership without discovering or constructing links." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path chron:sampled_observation_references ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "Optional supplied UsageInterval only for source-compatible PlacesActivities activity reports and CoronaHealth active-use/inferred-inactivity release records. Start/end tokens, duration and endpoint statuses remain independent; no inclusivity, calendar, one-day boundary, clock arithmetic, place visit or session constructor is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path chron:denotes_interval ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:method_profile_id ;
        ] ;
    sh:targetClass chron:SampledQuantityObservationRecord ;
.

chron:ScreenTextCaptureRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized text snapshot, with its raw or derived meaning declared by the referenced local source definition. ScreenTextSensor (10.1145/3613904.3642347) physical pp3–4 Sections3.1–3.2 describes a saved flat string, application package and individually delimited text-node phrases with pixel rectangles from Android Accessibility. JMIR55999 (10.2196/55999) physical p4 describes EasyOCR-derived screenshot text and its confidence filter and normalization; these are not raw Accessibility observations. ScreenTK (10.1145/3675094.3677547) Figures2–3 separately describe capture time and Unix event time; source_event_time_token preserves the latter independently, without assuming units or conversion between them. This record is not screenshot pixels or a UsageStats event, and importing it does not execute OCR or normalization. Equal text/time tokens do not merge captures or phrases. Flat text and phrase membership are independently supplied; no delimiter parsing, concatenation, filtering, tree/visibility inference or time conversion runs at import. Null, empty and omitted membership remain distinct. Normalized IDs do not recover raw keys, serializer or the study build." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied flat screen-text string, preserved without splitting, joining, trimming or verifying original delimiter grammar." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:screen_text ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied opaque text-capture time token; no clock units, ordering or timezone inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:capture_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied opaque source-designated event-time token, independent of capture_instant. ScreenTK Figure3 calls its timestamp Unix event time; numeric unit, precision and conversion to the Figure2 capture-time representation are unreported. No parsing, clock conversion, timezone assignment or equality between the two time fields is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_event_time_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized saved-text record identity local to profile/participant/device, not a timestamp or text hash." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:text_capture_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:ScreenTextPhraseRecord ;
            sh:description "Supplied capture-owned phrase members; null/omission is unknown, empty is supplied empty membership. Equal text never deduplicates children." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:screen_phrases ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:ScreenTextCaptureRecord ;
.

chron:ScreenshotSessionRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized screenshot container with local image identities and annotations. PULSE phone-use sessions are not app episodes or an unlock-to-lock interval. Regret2025 pp5–8 instead supplies foreground-app screenshot ownership, its definition and optional explicit screen-parent/ app-period action links. App and parent identities are not inferred from images, times or equal values. PULSE (2025), printed p.202 Section2.2 and p.203 Figure1b/c, groups screenshots into continuous phone-use sessions and applies labels to selected first/last screenshot ranges. Capture or upload membership may be incomplete (p.203 Section2.3.1); no session construction, timestamp conversion or label propagation runs during import. IDs are normalized, not recovered raw keys." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied screenshot-container identity scoped by profile/participant/device, source-defined phone-use or foreground-app ownership; not inferred from app or unlock timing." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:screenshot_session_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-compatible local foreground-app screenshot-container definition for Regret2025, not a PULSE constructor or inferred screenshot grouping." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied action/foreground-period or unlock-attempt ID local to the explicitly referenced parent device session. A nonnull action requires its parent; known app/role contradictions reject without inferring unknown membership or timing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:session_action_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied app identity, including pseudonymous labels; not necessarily an Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:app_identifier ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized session; neither authenticates source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:session_record_origin ;
        ] ,
        [
            sh:class chron:SessionScreenshotRecord ;
            sh:description "Supplied screenshot members in preserved array order; [] means explicitly empty supplied membership, not a complete original capture claim." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:screenshots ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path chron:denotes_interval ;
        ] ,
        [
            sh:class chron:ScreenshotRangeAnnotationRecord ;
            sh:description "Supplied session-local range annotations in preserved order; omission/null is unknown and [] explicitly empty. Neither entails negative intent labels." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path chron:screenshot_range_annotations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied parent device-session ID. Exact source-compatible children resolve one unique same-profile/work/participant parent with compatible known device; unknown device never selects among multiple parents. Null/omission remains unknown. No clock or raw join is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:device_use_session_reference ;
            sh:pattern "\\S" ;
        ] ;
    sh:targetClass chron:ScreenshotSessionRecord ;
.

chron:SensorControlOccurrenceRecord
    a sh:NodeShape ;
    rdfs:comment "A separately identified supplied normalized logged sensor enable/disable instance, independent of text captures. ScreenTextSensor physical p17 Section6.6 describes AWARE-Light logging these instances. This is neither screen/keyguard state nor an active-collection interval; do not infer success, actor, disabled duration, missing capture or a neighboring join. The profile-owned definition reference identifies the logged-control acquisition claim, not an execution receipt or recovered raw event code." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied logged-control record identity local to profile/participant/device; equal times do not merge instances." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:sensor_control_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "When the occurrence happened." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path time:inXSDDateTimeStamp ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied sensor identifier/label, not normalized into an Android package or an inferred deployed build." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:sensor_label ;
        ] ,
        [
            sh:description "Supplied enable/disable occurrence label; not observed service status or a reconstructed disabled interval." ;
            sh:in (
                "enable"
                "disable"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path chron:sensor_control_action ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:SensorControlOccurrenceRecord ;
.

chron:SessionAssociationDatabaseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied session-transaction database and its mined rules scoped to a profile, participant and analysis run. Habitual Smartphone Use (3447991), physical pp10-12 sections3.2.2-3.2.3, mines each participant's cluster separately; pp20-21 section5 pools Android Socialize sessions without clustering. Group labels are not globally unique or recovered raw keys. Supplied memberships/results do not execute mining or establish exact collector, clock, platform, context join or original-row provenance." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:SessionTransactionRecord ;
            sh:description "Supplied database-local transactions. Omission/null is unknown membership; [] is explicitly supplied empty membership, not complete observed zero." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path chron:session_transactions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional printed or supplied cluster/group label. Null/omission does not assign a cluster or pooled group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:association_group_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional compatible local binary session-transaction definition, not a reference to duration-weighted features." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:transaction_definition_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied analysis-run identity, not an invented date, reconstructed rolling window or proof that an algorithm ran." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:analysis_run_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional compatible local source-definition reference, distinguishing per-user clustering from pooled sessions without executing either." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:grouping_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:AssociationRuleRecord ;
            sh:description "Supplied rules owned by this mining database. Presence does not imply that supplied transactions are complete, generate the rule, or determine its denominator." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:association_rules ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied database identity scoped by profile/participant/device/analysis run, independent of its potentially repeated group label." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:association_database_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:SessionAssociationDatabaseRecord ;
.

chron:StudyMethodProfile
    a sh:NodeShape ;
    rdfs:comment "A versioned, source-located account of one retained method from acquisition through release. A profile is not runnable while any applicable setting is unresolved; semantic coverage never implies executable support." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:integer ;
            sh:description "Number of embedded method settings; must equal the inventory and object count." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:method_setting_count ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Prospective operations needed to reproduce the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path chron:method_operations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:description "Whole-profile execution status; executable requires every replication gate to pass." ;
            sh:in (
                "executable"
                "blocked"
                "specification_only"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 26 ;
            sh:path chron:profile_implementation_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Ordered inventory of embedded method-setting identities for round-trip validation." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:method_setting_ids ;
        ] ,
        [
            sh:class chron:DurationPolicy ;
            sh:description "Target-typed duration rules used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path chron:duration_policies ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Version of this source-to-method interpretation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:method_profile_version ;
        ] ,
        [
            sh:description "Relationship among this source's method specifications; never infer unreported cross-products." ;
            sh:in (
                "fixed"
                "full_factorial"
                "one_factor_at_a_time"
                "coherent_joint_specifications"
                "ablation"
                "cross_study_catalog"
                "source_declared_axes"
                "enumerated_combinations"
                "conditional"
                "documentary_only"
                "evidence_blocked"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:method_configuration_structure ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Source-supported settings in this profile or subprotocol." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path chron:method_settings ;
        ] ,
        [
            sh:class chron:DiaryProtocol ;
            sh:description "Diary instruments and schedules used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path chron:diary_protocols ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the exact cohort, platform, protocol version, branch, or multiverse configuration represented by this profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_method_variant_id ;
        ] ,
        [
            sh:class chron:SessionConstructionPolicy ;
            sh:description "Target-typed session construction policies used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path chron:session_construction_policies ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Platform or device slice to which this exact method variant applies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_method_platform ;
        ] ,
        [
            sh:class chron:AcquisitionProtocol ;
            sh:description "Observation protocols used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path chron:acquisition_protocols ;
        ] ,
        [
            sh:class chron:MethodConfigurationSelection ;
            sh:description "Exact selected source levels for one executable method variant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path chron:method_configuration_selection ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-facing label for this exact method variant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:source_method_variant_label ;
        ] ,
        [
            sh:class chron:NotificationAttributionPolicy ;
            sh:description "Notification-to-behavior attribution policies used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path chron:notification_attribution_policies ;
        ] ,
        [
            sh:class chron:TimestampPolicy ;
            sh:description "Timestamp fidelity and ordering policies used by the method." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path chron:timestamp_policies ;
        ] ,
        [
            sh:class chron:ProtocolMaterializationBlocker ;
            sh:description "Explicit missing-field or shape blockers for protocol fragments." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path chron:protocol_materialization_blockers ;
        ] ,
        [
            sh:class chron:SourceArtifactProvenanceAssertion ;
            sh:description "Exact content-bound source-artifact documentary assertions." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path chron:source_artifact_provenance_assertions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Cohort or population slice to which this exact method variant applies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_method_cohort ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-declared analysis, sensitivity, ablation, or protocol branch represented by this profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_method_branch ;
        ] ,
        [
            sh:class chron:MeasurementReleaseProfile ;
            sh:description "Collected-signal to released-measure provenance." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path chron:release_profiles ;
        ] ,
        [
            sh:class chron:ParameterProvenanceAssertion ;
            sh:description "Documentary and derivation provenance for method parameters." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path chron:parameter_provenance_assertions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:class chron:DiaryReplicationBinding ;
            sh:description "Content-bound diary version and released-layout selections validated without claiming full protocol execution." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path chron:diary_replication_bindings ;
        ] ,
        [
            sh:class chron:MethodConfigurationSpace ;
            sh:description "Complete source-declared configuration space for this method." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path chron:method_configuration_space ;
        ] ;
    sh:targetClass chron:StudyMethodProfile ;
.

chron:TaskOccurrenceRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized occurrence of a task, potentially spanning several apps and screen/notification/unlock actions, not one app session or paired visual trace. S-ADL (2024), physical pp8 Figure2 and25 Table11, supplies expected scripts and subtask roles; p21 AppendixA.1 and p23 Table6 supply independent content-based criteria. Existing source-setting definitions are referenced, not copied. IDs, role assignments, assessments and links are supplied normalization, not recovered source rows or an executed script matcher. Supplied answers may concern the owning task/session, as in ACII2019 text-entry-session emotion reports. A separately identified questionnaire completion can represent condition-level administration (Alt2012 SUS; Böhmer2014 post-condition TLX). It does not create a browser, call or navigation-trial join or imply task-correctness assessment. Anatomy2016 additionally admits explicitly supplied authentication-task links to one parent screen session and one local attempt action. Code success, retry, screen-off abort and keyguard dismissal remain independent supplied evidence; no finite-state execution or timestamp scheduling repair runs. DynamicSecurity layout874–896 separates the answering participant from an optional supplied history subject. Shared question cases span responders; equal wording does not establish identity and role-varying wording does not contradict an explicitly supplied shared case." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied link to the trace assessed by this task/questionnaire completion (ODIM pp12–13 §§5.2–5.3). Resolves within the same profile/source and must match participant identity when known on the trace. Multiple independent questionnaire tasks may assess one trace; null/omission leaves the target unknown. No join, temporal order or participant identity is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:interaction_trace_reference ;
        ] ,
        [
            sh:class chron:TaskActionRecord ;
            sh:description "Supplied task-local actions in supplied array order. Null/omission is unknown membership; [] is explicitly empty supplied membership, not proof of complete zero observation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path chron:task_actions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied response/aggregation day, distinct from the response instant (Digital Nightlife released timeframe R:22 and combination R:89–94). Does not assert calendar containment of every owned window, derive a date from an action time, or merge independently identified tasks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:referenced_day_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional reference to a compatible task-sequence setting within the owning profile/source; null/omission does not assert an expected script. No script matcher runs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:expected_script_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied action/foreground-period or unlock-attempt ID local to the explicitly referenced parent device session. A nonnull action requires its parent; known app/role contradictions reject without inferring unknown membership or timing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:session_action_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:class chron:TaskQuestionnaireResponseRecord ;
            sh:description "Independently supplied answers concerning the owning task/session or a separate questionnaire completion; omission/null/empty membership are distinct and never imply completion, a call join or a navigation-trial join." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path chron:task_questionnaire_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:TaskObservationWindowRecord ;
            sh:description "Supplied task/completion-local windows with source definitions and disclosed local anchor events; STDD alone permits an unknown anchor. Null/omission is unknown membership, [] explicitly empty. No time matching, aggregation or first-response inference runs." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path chron:task_observation_windows ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied task identity scoped by profile/participant/device, not reconstructed from equal app/time tokens." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:task_occurrence_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied assessor identity, distinct from the assessed participant_id. JCP2017 pp867–868 has one live interviewer and two video-review psychiatrists, each independently producing standard and app-incorporated judgments. The assessor belongs to the owning task and its assessments; null/omission leaves identity unknown. No clinician catalog, interview/video join or consensus is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:assessor_id ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied parent device-session ID. Exact source-compatible children resolve one unique same-profile/work/participant parent with compatible known device; unknown device never selects among multiple parents. Null/omission remains unknown. No clock or raw join is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:device_use_session_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied person whose autobiographical history generated a DynamicSecurity challenge, distinct from the owning Task participant_id answering it. Primary layout874–896 presents the same question/options to the legitimate person, paired strong adversary and hidden-stranger naive adversary. Null/omission leaves history identity unknown; no participant assignment, original challenge key or history join is recovered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:history_subject_participant_id ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied task designation, including which script is meant when a source-setting definition contains multiple scripts." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:task_label ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path chron:denotes_interval ;
        ] ,
        [
            sh:class chron:TaskCriterionAssessmentRecord ;
            sh:description "Independently supplied assessments within the task, not one combined task score. Null/omission/empty membership stay distinct." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path chron:criterion_assessments ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:TaskOccurrenceRecord ;
.

chron:TypingTrialRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized trial membership or explicitly selected derived-only cells. Akpinar et al. DOI 10.1145/3577013 physical pp12-13 Figure4/Section4.2 distinguishes raw actions from later trial construction by participant, timestamp order, app switch, text reset and transition-specific pauses. This class retains supplied ordered references, not an executed trial constructor, timestamp tie rule, computed correction verdict or recovered ESM join. IDs and membership are normalized, not recovered source keys. Rodrigues et al. DOI10.1145/3491102.3501908 p5§3.1.2 stores metrics without raw text, touchpoints or app identity. Its released CSV's repeated Index tuples must not be deduplicated or treated as trial identity. Derived-only rows reference their own lifecycle and column definitions, not CABAS boundaries. Optional action-trial-owned token evaluations and text-change cases, independent system verdicts, participant follow-up answers and separately supplied questionnaire answers preserve the pp18–20 follow-up and pp7–8/32–33 ESM relationships without executing a classifier or recovering raw case keys and joins." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:TextChangeCaseRecord ;
            sh:description "Optional supplied case members in an action-membership trial; omission/null/[] remain distinct and no change extraction runs." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path chron:text_change_cases ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Required only for derived_metrics: supplied lexical JSON object with exactly the locally declared column labels and string-valued cells. Preserve codes, blanks and numeric text without coercion, deduplication or time inference; columns are not all metrics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:released_values_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local source-located three transition-specific pause thresholds; comparator equality remains unreported and no pause split runs at import." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:trial_pause_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied ordered normalized action IDs in one trial, resolving to standalone same-owner keyboard transactions. [] is not a valid observed trial; no membership is inferred for unreferenced actions." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:keyboard_transaction_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local source-located app-package switch trial boundary; no app-switch inference runs at import." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:trial_app_switch_setting_reference ;
        ] ,
        [
            sh:description "Explicit derived_metrics branch versus retained action_membership. Omission is legacy action membership; null is invalid at ingress." ;
            sh:in (
                "action_membership"
                "derived_metrics"
            ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path chron:trial_representation ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Required only for derived_metrics: local reconstruction/text_entry_trial start/end or explicit trial-unit definition (such as each prompted answer). It does not supply clocks, action membership or execution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:trial_lifecycle_setting_reference ;
        ] ,
        [
            sh:class chron:TypingQuestionnaireResponseRecord ;
            sh:description "Independent supplied trial-local questionnaire answers, not case follow-up feedback or recovered ESM joins; omission/null/[] remain distinct." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path chron:trial_questionnaire_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized typing-trial identity local to profile/participant/device; not a recovered trial constructor or timestamp key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:typing_trial_id ;
        ] ,
        [
            sh:class chron:TokenEvaluationCaseRecord ;
            sh:description "Optional supplied word-evaluation cases distinct from text-change cases; no tokenization or classifier runs, and omission/null/[] remain distinct." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path chron:token_evaluation_cases ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local source-located participant-partition and timestamp-order rule for trial construction; not by itself the complete boundary method." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:trial_partition_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local source-located nonempty-current then empty-before trial boundary; not a submitted-versus-cleared decision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:trial_reset_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Required only for derived_metrics: local event_schema/analysis_record_set declaration of every supplied column label." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:trial_schema_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:TypingTrialRecord ;
.

chron:UsageSessionAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim of continuous device use between unlock and lock. Derived prov:Entity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:UsageSessionAssertion ;
.

chron:WorkflowPlan
    a sh:NodeShape ;
    rdfs:comment "The prospective processing workflow. A p-plan:Plan / prov:Plan." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:QueryDefinition ;
            sh:description "Physical queries in the workflow." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path chron:queries ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Semantic operations in the workflow." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path chron:operations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Plan identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:plan_id ;
        ] ;
    sh:targetClass chron:WorkflowPlan ;
.

chron:AcquisitionProtocol
    a sh:NodeShape ;
    rdfs:comment "Actual observation semantics, distinct from selecting events after collection. Cadence, lookback, cursoring, overlap, persistence, and failure behavior can each change which occurrences are observable." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Treatment of the last or incomplete observation in a run or window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:terminal_sample_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity and disposition for repeated acquired observations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:acquisition_deduplication ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable acquisition-protocol identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:acquisition_protocol_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Meaning and source of occurrence time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:occurrence_timestamp_semantics ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Behavior under Android doze or battery restrictions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path chron:doze_behavior ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Overlap between acquisition windows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:overlap_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Upload trigger, batching, retry, and transport behavior." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path chron:upload_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Acquisition API and applicable version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:api_and_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Treatment of the first observation in a run or window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:initial_sample_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Requested observation or prompt cadence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:requested_cadence ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Collector, framework, application, or instrument." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:collector ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "On-device or intermediate persistence behavior." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:persistence_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Behavior and provenance when required permission is absent or revoked." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path chron:permission_loss_behavior ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Query interval and bound inclusivity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:query_bounds ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Observed cadence and jitter, kept distinct from the request." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:realized_cadence_and_jitter ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Source-supported settings in this profile or subprotocol." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path chron:method_settings ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Retrospective lookback rule." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:lookback ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Historical backfill rule." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:backfill ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Meaning and source of collection or processing time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:processing_timestamp_semantics ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Callback, broadcast, fixed-cadence poll, retrospective query, snapshot, or aggregate mode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:observation_mode ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Behavior across collector or device restart." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path chron:restart_behavior ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Cursor advancement and resume rule." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:cursor_policy ;
        ] ;
    sh:targetClass chron:AcquisitionProtocol ;
.

chron:AppFeatureOccurrenceRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied feature-use instance local to its owning app session, not merely a feature label, app episode or Accessibility callback. Finesse p.8 Section3.3 preserves each instance's name/start/end. Supplied order, opaque time tokens and unknown endpoints survive without inferring an overlap, adjacency, containment, carry-forward or duration policy." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied instance identity unique within its owning session even at identical feature labels/times." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:feature_occurrence_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied feature label scoped by the owning application; not a global closed vocabulary or an occurrence identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:feature_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:AppFeatureOccurrenceRecord ;
.

chron:AppSessionQuestionnaireResponseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied answer identity local to one tracked-app session, using the existing subjective-answer slots and compatible local source definition. Optional response-role labels retain before/during/after or another supplied designation without reconstructing sampling chronology. Meaningful released Sample.java527-554 cancels only the current prompt: earlier answers survive, current NO_RESPONSE differs from later NA. WhyStop ESQ answers may be partial; no answer is mandatory. An optional supplied interruption reference resolves only within the containing session and does not infer the last interruption, cause or outcome." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied owner-local actions: Chang retrospective event supports or DynamicSecurity answer-local evidence/confidence supports, resolving only within the containing TaskOccurrence. The preceding24h end-of-day event selection horizon remains a method definition; these links do not turn an event into a24h window or infer prompt time/selection. Shared answer supports do not compute confidence or recover missing case identities. Null/omission is unknown, [] explicitly empty; unrelated response carriers reject this field unless their own ingress validates it." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON answer, including structured/multiple selections or explicit null; not recoded or coerced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:response_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied subjective measure designation, not necessarily exact question wording." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied answer identity unique within its owning tracked-app session." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:questionnaire_response_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied questionnaire item label; not an invented raw schema key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied answer-role designation such as before/during/after; not a computed sampling phase or a claim that all phases occur in one app instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:response_role_label ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied case identity scoped to profile/source, independent of rater, text label, description or response. Meaningful primary339–354 has authored app-use cases followed by independent ratings of shared cases. DynamicSecurity layout874–896 supplies shared question/options identities across legitimate/adversarial responders, without requiring literal role-varying wording equality. This token preserves a supplied relationship across completions without recovering original IDs or declaring a case catalog. Null/omission is unknown identity; equal labels do not imply equal cases." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:assessment_case_token ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Reference to a compatible disclosed response-scale definition within the owning profile/source, not an invitation or reported result; unknown instrument details remain on that source definition." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:questionnaire_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied interruption ID resolving only within the containing tracked-app session; null/omission is unknown relationship, not a last-interruption or cause inference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:interruption_record_reference ;
            sh:pattern "\\S" ;
        ] ;
    sh:targetClass chron:AppSessionQuestionnaireResponseRecord ;
.

chron:AssociationRuleRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied rule within its containing mining database, with independently supplied antecedent/consequent app and contextual itemsets. Habitual physical p17 Table5 R6 is WhatsApp=>Instagram for U34's cluster3; reversing the sides changes the rule without changing combined app membership. Printed quality values and category/type annotations remain lexical JSON, not calculated values, temporal order, causes or execution receipts." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied app items on the antecedent side; not chronological previous apps or causal triggers." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:antecedent_app_items ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON rule annotations such as printed category/type, separate from quality values, inferred action or classification execution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:rule_annotation_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied app items on the consequent side, independently retained from antecedent membership." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:consequent_app_items ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied database-local rule identity, potentially a printed label rather than an original key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:association_rule_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON quality values with their source labels/units/qualifications. Not computed from supplied sessions or silently treated as a normalized proportion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:rule_quality_values_json ;
        ] ,
        [
            sh:class chron:AssociationContextItemRecord ;
            sh:description "Supplied contextual antecedent itemset; omitted/null/empty remain distinct." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:antecedent_context_items ;
        ] ,
        [
            sh:class chron:AssociationContextItemRecord ;
            sh:description "Supplied contextual consequent itemset where disclosed; no missing membership is inferred." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path chron:consequent_context_items ;
        ] ;
    sh:targetClass chron:AssociationRuleRecord ;
.

chron:CoverageAssessment
    a sh:NodeShape ;
    rdfs:comment """A coverage/observability judgement over a stream window: expected vs actual data availability, its threshold, bounding events, and best-supported cause. A gap MAY CONCEAL usage — this asserts only how the measurement policy treats the interval, never that the device was inactive.
DESIGN-TIME ONLY, like the CoverageCause it carries: no kernel path emits an expectation, an availability threshold, a policy treatment, or a cause. The coverage judgement this engine ships is the per-day DayCoverageAssessment. Keep the two apart when reading an instance graph — this class describes a window-level cause attribution that is available to an author, not a reading of pipeline output.""" ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether any data was actually present." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:actually_available ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether data was expected to be available (needs a heartbeat/expectation to assert NoData)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:expected_available ;
        ] ,
        [
            sh:description "Best-supported cause." ;
            sh:in (
                "shutdown_boundary"
                "unclean_power_loss"
                "collector_reporting_gap"
                "unknown"
            ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path chron:coverage_cause ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "How the measurement policy treats this interval (e.g. pass / na / exclude)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:policy_treatment ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Coverage threshold applied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:availability_threshold ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The stream window assessed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:assesses_interval ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ;
    sh:targetClass chron:CoverageAssessment ;
.

chron:CrossPeriodAggregateReference
    a sh:NodeShape ;
    rdfs:comment "Explicit support/comparison from a subjective participant-period observation to an objective aggregate in a different supplied period, within the same profile/work/participant. The target observation identity and exact period kind/token both resolve; the relationship label and provenance preserve why the records are compared, not a computed calendar adjacency or causal claim. Murnane2016 p7 compares prior-night reported sleep with following-day use; p8 same-night counts use the separate existing same-period reference." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of a particular one-hour period, not an hour-of-day bucket, day or night. Mutually exclusive with day/night tokens; no endpoints, timezone or timestamp join inferred (CHI2020 Paper36 p5 CCM)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:referenced_hour_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of the day described, mutually exclusive with hour/night tokens; not substituted from prompt/submission time, parsed, calendar-normalized or timezone-converted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:referenced_day_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied opaque identity of the night described, not a calendar day, prompt time, source serializer or inferred sleep interval. Mutually exclusive with day/hour tokens; no endpoints or preceding/following day recovered (Murnane2016 pp3,7–8)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:referenced_night_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied observation identity scoped by profile/participant/period kind/token, not a raw join key; legacy day-named transport supports explicit hour ownership." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:day_observation_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank relationship designation, not inferred causality, chronology or a source storage code." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:relationship_label ;
            sh:pattern "\\S" ;
        ] ;
    sh:targetClass chron:CrossPeriodAggregateReference ;
.

chron:DeviceSessionQuestionnaireResponseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied answer identity local to the containing device-use session, referencing a compatible instrument in its profile. Rabbit Hole physical pp8-9 Figure3 distinguishes intention, completion, deviation, regret and perception questions without establishing complete numeric slider codes. Repeated equal answers remain separate. Optional wording and lexical value do not imply a prompt, completion, observed negative or raw key." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON answer, including structured/multiple selections or explicit null; not recoded or coerced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:response_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied local foreground-period support for Regret2025 intention/daily-regret answers. At most one known visit; null/omission is unknown and [] explicitly empty. Repeated same-app visits remain distinct. No survey eligibility, timing or last-visit selection is inferred." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied measure designation, distinct from optional exact item wording." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied questionnaire item label; not an invented raw schema key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Compatible local instrument definition, not a schedule, suppression rule or invented numeric recode." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:questionnaire_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied answer identity unique within its owning device-use session." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:questionnaire_response_id ;
        ] ;
    sh:targetClass chron:DeviceSessionQuestionnaireResponseRecord ;
.

chron:DiaryItem
    a sh:NodeShape ;
    rdfs:comment "One source-defined diary field or question and its response contract." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether the item may occur more than once per entry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:diary_repeatable ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether the instrument requires a response." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:diary_required ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source wording or stable prompt reference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:diary_prompt ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable item identifier within the diary protocol." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:diary_item_id ;
        ] ,
        [
            sh:description "Response serialization shape." ;
            sh:in (
                "boolean"
                "integer"
                "float"
                "string"
                "enumeration"
                "duration"
                "timestamp"
                "time_window"
                "list"
                "object"
                "expression"
                "artifact_reference"
                "unspecified"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path chron:diary_response_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Event or interval the response refers to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:diary_anchor_event ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Unit attached to the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:method_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Machine-readable field name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:diary_item_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Closed response choices when applicable." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:diary_allowed_values ;
        ] ;
    sh:targetClass chron:DiaryItem ;
.

chron:DiaryProtocol
    a sh:NodeShape ;
    rdfs:comment "A versioned diary setup: item and response schemas, schedule and trigger rules, recall window, timezone behavior, and missing-response policy." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Source-supported settings in this profile or subprotocol." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path chron:method_settings ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable diary-protocol identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:diary_protocol_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source title or label of the diary instrument." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:diary_title ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:DiaryScheduleRule ;
            sh:description "Schedule and trigger rules." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path chron:diary_schedule_rules ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Time interval respondents are asked to recall." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:diary_recall_window ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Timezone and day-boundary convention for prompts and responses." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:diary_response_timezone ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Missing, late, partial, duplicate, and corrected response policy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:diary_missing_response_policy ;
        ] ,
        [
            sh:class chron:DiaryItem ;
            sh:description "Item and response definitions." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path chron:diary_items ;
        ] ;
    sh:targetClass chron:DiaryProtocol ;
.

chron:DiaryReplicationBinding
    a sh:NodeShape ;
    rdfs:comment "Content-bound selection of one Sleep Scoring diary version and released source layout. Chronicle validates this binding and its embedded shared fixture independently while preserving the full profile's blocked state." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:integer ;
            sh:description "Number of composed form elements transported for the selected version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:form_element_count ;
        ] ,
        [
            sh:description "Whole-profile execution status; executable requires every replication gate to pass." ;
            sh:in (
                "executable"
                "blocked"
                "specification_only"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path chron:profile_implementation_status ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Number of composed diary item definitions transported for the selected version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:diary_item_count ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Expected and observed SHA-256 of the shared fixture input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:fixture_input_sha256 ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Number of composed administration schedules transported for the selected version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path chron:administration_schedule_count ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the exact cohort, platform, protocol version, branch, or multiverse configuration represented by this profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_method_variant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Expected and observed SHA-256 of the adapter-normalized shared fixture." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:fixture_normalized_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Complete authoritative fail-closed reasons that keep the full diary profile non-executable." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:blocker_codes ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Number of composed conditional or validation rules transported for the selected version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path chron:rule_definition_count ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Version of the released source-layout mapping profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:mapping_profile_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Versioned source-layout adapter identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:adapter_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 of the canonical generated Chronicle bridge payload." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:bridge_payload_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one source-supported setting assertion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_setting_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 identity declared by the authoritative Sleep Scoring generated diary catalog." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:catalog_source_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Shared conformance fixture executed for this binding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:fixture_id ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Number of composed diary schedule rules transported for the selected version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:schedule_rule_count ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact released source-layout mapping profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:mapping_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact source-layout adapter version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:adapter_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact authoritative diary version definition selected for replication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:version_definition_id ;
        ] ,
        [
            sh:class chron:DiarySourceAdapterReceipt ;
            sh:description "Exact source-layout adapter execution receipt nested in this binding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path chron:diary_source_adapter_receipt ;
        ] ;
    sh:targetClass chron:DiaryReplicationBinding ;
.

chron:DiaryScheduleRule
    a sh:NodeShape ;
    rdfs:comment "One schedule, randomization, or event-contingent diary trigger." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Requested observation or prompt cadence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:requested_cadence ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Daily prompt cap when applicable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:diary_max_prompts_per_day ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Timezone and day-boundary convention for prompts and responses." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:diary_response_timezone ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Latest local or relative time at which the rule applies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:diary_window_end ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Earliest local or relative time at which the rule applies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:diary_window_start ;
        ] ,
        [
            sh:description "Trigger category for this rule." ;
            sh:in (
                "scheduled"
                "random"
                "event_triggered"
                "participant_initiated"
                "completion_relative"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path chron:diary_trigger_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable diary-schedule rule identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:diary_schedule_rule_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Randomization, stratification, or without-replacement rule." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:diary_randomization_policy ;
        ] ;
    sh:targetClass chron:DiaryScheduleRule ;
.

chron:DiarySourceAdapterReceipt
    a sh:NodeShape ;
    rdfs:comment "Exact receipt from one versioned diary source-layout adapter execution. This proves source-layout conformance only; it never upgrades a blocked diary protocol to executable." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Versioned source-layout adapter identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:adapter_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Shared fixture identities registered to the exact adapter and mapping profile." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:conformance_fixture_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Version of the released source-layout mapping profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:mapping_profile_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 of the bytes emitted by the diary source adapter." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:normalized_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact released source-layout mapping profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:mapping_profile_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 of the source bytes accepted by the diary source adapter." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact source-layout adapter version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:adapter_version ;
        ] ;
    sh:targetClass chron:DiarySourceAdapterReceipt ;
.

chron:DurationPolicy
    a sh:NodeShape ;
    rdfs:comment "A duration rule with an explicit target layer. Equal thresholds applied to an app episode, screen bout, device session, pickup, polled run, or daily aggregate are different methods." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Layer affected by the setting." ;
            sh:in (
                "collector"
                "raw_occurrence"
                "raw_record"
                "acquired_snapshot"
                "app_episode"
                "app_session"
                "screen_bout"
                "device_session"
                "device_setting_state_interval"
                "device_setting_actuation"
                "pickup_activation"
                "participant_day"
                "participant_hour"
                "participant_record"
                "participant_measure"
                "study_window"
                "analysis_record_set"
                "text_entry_trial"
                "diary_item"
                "diary_response"
                "derived_feature"
                "model"
                "notification_item"
                "notification_alert"
                "notification_attendance"
                "notification_delivery"
                "intervention_content_state"
                "call_handling"
                "outcome"
                "released_artifact"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:method_target_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Unit attached to the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:method_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON serialization of the complete source-declared value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:method_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Inclusivity, clipping, ordering, or calendar convention required to interpret the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_boundary_convention ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Action on values meeting the duration condition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:duration_action ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Boundary comparator such as less-than, at-most, or inclusive-between." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:method_comparator ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable target-typed duration-policy identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:duration_policy_id ;
        ] ;
    sh:targetClass chron:DurationPolicy ;
.

chron:EffectiveUsageMeasure
    a sh:NodeShape ;
    rdfs:comment """One screen-gated credited app EPISODE — the unit the engine actually emits when `enable_screen_gated_crediting` is on.
An earlier version of this class described a per-participant-day `effective_minutes` figure governed by a free-text `coverage_policy`. No such daily measure exists. `apply_screen_gated_credit_incremental` (pipeline_v2.rs) emits `credited_app_csv`, a side-by-side CSV written by the same `write_app_csv_from_iter` as the headline app output, so a credited measure is an episode row with the app schema's own start, stop, duration and date — not a daily total. Its workflow checkpoint is named `effective_usage`, which is where this class's name comes from.
The rule that decides which parts of a session earn credit is typed: ScreenGatingRuleId, not prose. Its three values select witnessed screen-ON intervals, demonstrably-alive spans, or (the default) their intersection. The numeric bounds around it — `auto_lock_bridge_seconds`, `credited_session_cap_minutes`, `device_liveness_gap_tolerance_minutes`, `no_witness_min_day_apps` — are ordinary ParameterBindings of the cited ParameterSet.
NOT asserted as physical truth, and never a replacement for the headline app-usage output, which no value of the gating rule changes. A daily credited total is an aggregation a consumer performs over these rows under a stated DayBoundaryAttributionId and TimezoneNormalizationPolicyId; it is not something this pipeline emits.""" ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "The typed rule that decided which parts of the app session earned credit. Replaces the former free-text coverage_policy, which named a policy vocabulary that never existed." ;
            sh:in (
                "screen_and_liveness_v1"
                "screen_witness_only"
                "strict_visual_only"
                "device_liveness_only"
            ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path chron:screen_gating_rule ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:description "Local calendar date the row is attributed to, in the run's output timezone (see TimezoneNormalizationPolicyId) and under the selected DayBoundaryAttributionId." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:date ;
        ] ,
        [
            sh:class chron:OperationExecution ;
            sh:description "The operation execution that produced this measure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path chron:produced_by ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet under which this measure was produced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path chron:cites_parameter_set ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:EffectiveUsageMeasure ;
.

chron:InteractionEventRecord
    a sh:NodeShape ;
    rdfs:comment "One normalized trace member with paired visual/structural payload identities and optional gesture. Positions express current trace order, not timestamps. Capture incompleteness and human-detected incorrectness are independent nullable assertions; gesture presence implies neither correctness nor a human assessment. ODIM PDF pp. 6-7 sections 4.2-4.3. IDs and field names are normalized, not recovered." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Supplied human finding of incorrect interaction metadata; false, null and omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:human_detected_incorrect ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Supplied capture-completeness assertion, not inferred here from gesture presence; independent of human correctness review." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:capture_incomplete ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional gesture payload identity; absent or null is not silently completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:gesture_artifact_id ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Nonnegative position in the current trace; unique within the trace. Does not assert a source timestamp-sort algorithm." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:event_sequence_position ;
        ] ,
        [
            sh:class chron:InteractionRedactionRecord ;
            sh:description "Paired redaction records for this owning event only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path chron:interaction_redactions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized event identity, unique within its owning trace." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:interaction_event_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of this event's paired view hierarchy in the supplied ArtifactRef catalog." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:hierarchy_artifact_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of this event's screenshot in the supplied existing ArtifactRef catalog." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:screenshot_artifact_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied description of this labelled screen interaction (ODIM PDF p. 9 section 4.5), owned by the event within its trace, not by a reusable screenshot payload. Independent of the whole trace description and redaction justification; preserve verbatim empty/null/omission without inferring an annotator or generation route." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:screen_description ;
        ] ;
    sh:targetClass chron:InteractionEventRecord ;
.

chron:InteractionRedactionRecord
    a sh:NodeShape ;
    rdfs:comment "A supplied record of paired effects on its owning event's screenshot and hierarchy. ODIM device selection deletes selected-element pixels and tags corresponding text/content; web selection blackens a drawn region and removes metadata for supplied sufficiently-high-IoU elements (PDF pp. 8-9 section 4.4). The actual cutoff, tag spelling, pixel fill and node/pixel correspondence are not inferred. Records do not establish effective sanitization of payload bytes." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Element selection versus drawn-region/IoU selection; no undisclosed cutoff is supplied." ;
            sh:in (
                "selected_ui_element"
                "drawn_region_sufficient_iou"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path chron:redaction_selection_basis ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied corresponding hierarchy elements; web elements are supplied as qualifying, not selected by an invented IoU rule." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:selected_element_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of the paired screenshot output, not an executed sanitization claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:redacted_screenshot_artifact_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of the corresponding hierarchy output, not an executed sanitization claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:redacted_hierarchy_artifact_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied per-redaction textual justification (ODIM device route, PDF p. 8 section 4.4); no web prompt or mandatory response is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:redaction_justification ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized identity of one paired redaction record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:redaction_record_id ;
        ] ,
        [
            sh:description "Supplied pixel-side effect of this paired redaction." ;
            sh:in (
                "selected_element_pixels_deleted"
                "drawn_region_blackened"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path chron:screenshot_redaction_effect ;
        ] ,
        [
            sh:description "Supplied hierarchy-side effect of this paired redaction." ;
            sh:in (
                "corresponding_text_content_tagged"
                "qualifying_element_metadata_removed"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:hierarchy_redaction_effect ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied identity of the drawn web pixel region, without invented geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:target_region_id ;
        ] ;
    sh:targetClass chron:InteractionRedactionRecord ;
.

