.

chron:step_id
    a owl:DatatypeProperty ;
    rdfs:label "step_id" ;
    rdfs:range xsd:string ;
    skos:definition "Step identifier (= graph node id)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_id
    a owl:DatatypeProperty ;
    rdfs:label "strategy_id" ;
    rdfs:range xsd:string ;
    skos:definition "Strategy identifier (unique key)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_kind
    a owl:ObjectProperty ;
    rdfs:label "strategy_kind" ;
    rdfs:range chron:ReconstructionStrategyId ;
    skos:definition "Canonical strategy category (IRI-bearing enum value)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:strategy_version
    a owl:DatatypeProperty ;
    rdfs:label "strategy_version" ;
    rdfs:range xsd:string ;
    skos:definition "Strategy version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:timezone
    a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:range xsd:string ;
    skos:definition "Original recording timezone (preserved)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:verb
    a owl:DatatypeProperty ;
    rdfs:label "verb" ;
    rdfs:range xsd:string ;
    skos:definition "Action the step performs." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ReconstructionExecution
    a owl:Class ;
    rdfs:label "ReconstructionExecution" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterSet ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:follows_strategy ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:follows_strategy ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ReconstructionStrategy ;
            owl:onProperty chron:follows_strategy ;
        ] ;
    skos:broadMatch prov:Activity ;
    skos:definition "The execution that produced a usage assertion. A prov:Activity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:AttributionStatus
    a owl:Class ;
    rdfs:label "AttributionStatus" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#target>
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#known_non_target>
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#unresolved>
    ) ;
    skos:definition "Attribution status of an App-Usage assertion — the compliance denominator contract. Chronicle uses a CLOSED attribution vocabulary: \"Target Child\", \"Other\", or \"None\"/blank (survey answers arrive as \"Other (From Survey)\"). Mirrors classifyAttribution() in web/src/lib/stages/attributePerson.ts (the runtime SSOT). NEVER a null person and NEVER an \"unknown person\" class." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#known_non_target> ,
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#target> ,
        <https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#unresolved> ;
.

chron:ParameterSet
    a owl:Class ;
    rdfs:label "ParameterSet" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:bindings ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterBinding ;
            owl:onProperty chron:bindings ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "A content-addressed configuration entity — a set of ParameterBindings over the plan's variables. NOT a Plan: the plan is the workflow; this binds its variables." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ReconstructionStrategyId
    a owl:Class ;
    rdfs:label "ReconstructionStrategyId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#parry_toth_forward_pairing>
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#fused_matcher>
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#eyes_complement>
    ) ;
    skos:definition "Canonical IRI-bearing identifiers for the named episode-reconstruction algorithms. Forward-pairing is a DISTINCT algorithm, not a knob setting (doc 08). The runtime enum carries the canonical procedure IRI; concrete strategies are versioned individuals of ReconstructionStrategy." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#eyes_complement> ,
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#fused_matcher> ,
        <https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#parry_toth_forward_pairing> ;
.

chron:CoverageCause
    a owl:Class ;
    rdfs:label "CoverageCause" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#shutdown_boundary>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unclean_power_loss>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#collector_reporting_gap>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unknown>
    ) ;
    skos:definition "Best-supported cause of a coverage gap. A gap is an OBSERVABILITY condition — never asserted as physical inactivity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#collector_reporting_gap> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#shutdown_boundary> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unclean_power_loss> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unknown> ;
.

chron:StepDefinition
    a owl:Class ;
    rdfs:label "StepDefinition" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:verb ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:verb ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:verb ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:is_fatal ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:engine ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:step_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:part_of_step ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:step_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:engine ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:is_fatal ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:engine ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:is_fatal ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:part_of_step ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:step_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:consumes ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:depends_on ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:produces ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:consumes ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:StepDefinition ;
            owl:onProperty chron:part_of_step ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:depends_on ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:produces ;
        ] ;
    skos:broadMatch pplan:Step ;
    skos:definition "One processing step in the plan (a graph node) at ANY scale — a p-plan:Step. Steps compose recursively via part_of_step: a coarse step (an execution/memoization unit) and the fine-grained transformations inside it are the SAME kind of thing, because the step boundary is an arbitrary scale choice, not an ontological distinction. Follows the ProcessingStep shape (id/verb/engine/consumes/produces/depends_on)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:app_package_name
    a owl:DatatypeProperty ;
    rdfs:label "app_package_name" ;
    rdfs:range xsd:string ;
    skos:definition "Android package name." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:device_id
    a owl:DatatypeProperty ;
    rdfs:label "device_id" ;
    rdfs:range xsd:string ;
    skos:definition "Device identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:event_code
    a owl:ObjectProperty ;
    rdfs:label "event_code" ;
    rdfs:range chron:EventTypeCode ;
    skos:definition "Canonical event type." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:used_parameter_set
    a owl:ObjectProperty ;
    rdfs:label "used_parameter_set" ;
    rdfs:range chron:ParameterSet ;
    skos:definition "The ParameterSet the execution used." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:UsageInterval
    a owl:Class ;
    rdfs:label "UsageInterval" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:EndpointStatus ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:EndpointStatus ;
            owl:onProperty chron:start_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:start_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:start_status ;
        ] ;
    skos:broadMatch time:ProperInterval ;
    skos:definition "A phenomenon-time interval a usage assertion denotes. A time:ProperInterval." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:EndpointStatus
    a owl:Class ;
    rdfs:label "EndpointStatus" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored>
    ) ;
    skos:definition "Observation-endpoint qualification for a derived interval. Under RDF open-world semantics a missing endpoint is UNKNOWN, not observed-absent — so absence is always an explicit status, never a null result." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved> ;
.

chron:measurement_layer
    a owl:ObjectProperty ;
    rdfs:label "measurement_layer" ;
    rdfs:range chron:MeasurementLayer ;
    skos:definition "Measurement-model layer." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:reconstructed_by
    a owl:ObjectProperty ;
    rdfs:label "reconstructed_by" ;
    rdfs:range chron:ReconstructionExecution ;
    skos:definition "The execution that produced this assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:MeasurementLayer
    a owl:Class ;
    rdfs:label "MeasurementLayer" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#construct>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#validity>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#presence>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#engagement>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#person>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#attribution>
    ) ;
    skos:definition "The measurement-model layer a class/assertion belongs to (doc 13; chronicle-ontology.md)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#attribution> ,
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#construct> ,
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#engagement> ,
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#person> ,
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#presence> ,
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#validity> ;
.

chron:EventTypeCode
    a owl:Class ;
    rdfs:label "EventTypeCode" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_resumed>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_paused>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_stopped>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_interactive>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_non_interactive>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_shown>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_hidden>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_shutdown>
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_startup>
    ) ;
    skos:definition "Canonical Android lifecycle / device-state event vocabulary. Modeled as a SKOS concept scheme. The FULL both-spellings scheme (human labels PLUS \"Unknown importance: N\" importance codes 26/27/28/29 ...) is generated from the engine constants; the values below are the canonical semantic anchors every spelling maps to." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_paused> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_resumed> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_stopped> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_shutdown> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_startup> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_hidden> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_shown> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_interactive> ,
        <https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_non_interactive> ;
.

chron:denotes_interval
    a owl:ObjectProperty ;
    rdfs:label "denotes_interval" ;
    rdfs:range chron:UsageInterval ;
    skos:definition "The phenomenon-time interval this assertion denotes." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:participant_id
    a owl:DatatypeProperty ;
    rdfs:label "participant_id" ;
    rdfs:range xsd:string ;
    skos:definition "Participant/device identifier (string, always)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.
