PREFIX chron: <https://w3id.org/chronicle-usage-ontology/core/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

chron:AttributionAssertionContractShape
    a sh:NodeShape ;
    sh:message "An unresolved attribution (person == None/blank) must not name an attributed_person." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path chron:attributed_person ;
                ] ,
                [
                    sh:hasValue "unresolved" ;
                    sh:minCount 1 ;
                    sh:path chron:attribution_status ;
                ] ;
        ] ;
    sh:targetClass chron:AttributionAssertion ;
.

chron:CoverageAssessmentShape
    a sh:NodeShape ;
    sh:message "A no-data assessment (actually_available = false) requires expected_available to be stated." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:expected_available ;
                ] ,
                [
                    sh:hasValue false ;
                    sh:minCount 1 ;
                    sh:path chron:actually_available ;
                ] ;
        ] ;
    sh:targetClass chron:CoverageAssessment ;
.

chron:EffectiveUsageProvenanceShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "An effective-usage measure must name the operation execution that produced it." ;
            sh:minCount 1 ;
            sh:path chron:produced_by ;
        ] ,
        [
            sh:message "An effective-usage measure must cite the ParameterSet it was produced under." ;
            sh:minCount 1 ;
            sh:path chron:cites_parameter_set ;
        ] ;
    sh:targetClass chron:EffectiveUsageMeasure ;
.

chron:OperationExecutionContractShape
    a sh:NodeShape ;
    sh:message "A node execution that records a start must record its end." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path prov:startedAtTime ;
                ] ,
                [
                    sh:maxCount 0 ;
                    sh:path prov:endedAtTime ;
                ] ;
        ] ,
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path chron:started_at ;
                ] ,
                [
                    sh:maxCount 0 ;
                    sh:path chron:ended_at ;
                ] ;
        ] ;
    sh:property
        [
            sh:message "An operation execution must cite the ParameterSet it ran under." ;
            sh:minCount 1 ;
            sh:path chron:used_parameter_set ;
        ] ,
        [
            sh:message "An operation execution must name the OperationDefinition it realizes." ;
            sh:minCount 1 ;
            sh:path chron:executes_operation ;
        ] ;
    sh:targetClass chron:OperationExecution ;
.

chron:QueryExecutionContractShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A query execution must cite the ParameterSet it ran under." ;
            sh:minCount 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:QueryExecution ;
.

chron:UsageEpisodeProvenanceShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A usage episode assertion must be reconstructed_by an execution." ;
            sh:minCount 1 ;
            sh:path chron:reconstructed_by ;
        ] ;
    sh:targetClass chron:UsageEpisodeAssertion ;
.

chron:UsageIntervalEndpointShape
    a sh:NodeShape ;
    sh:message "An endpoint marked 'observed' must carry its instant." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:end_instant ;
                ] ,
                [
                    sh:hasValue "observed" ;
                    sh:minCount 1 ;
                    sh:path chron:end_status ;
                ] ;
        ] ,
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:start_instant ;
                ] ,
                [
                    sh:hasValue "observed" ;
                    sh:minCount 1 ;
                    sh:path chron:start_status ;
                ] ;
        ] ;
    sh:targetClass chron:UsageInterval ;
.

chron:AppFeatureSessionRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized app session containing individually identified timed feature-use instances and optional instance-selection responses. Finesse (2021), published-layout p.8 Section3.3 and p.3 Figure1, stores session start/duration and each instance's feature name/start/end. Same-label instances are not one occurrence. IDs are supplied normalized identities, not recovered raw keys; no classification, session construction, sampling, timing conversion or regret computation runs during import." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:class chron:SessionFeatureSelectionRecord ;
            sh:description "Supplied session-local response records; null/omission remains unknown, [] explicitly empty. No prompt or sampling eligibility is inferred." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path chron:session_feature_selections ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:AppFeatureOccurrenceRecord ;
            sh:description "Supplied ordered instances in the owning session; [] is explicit empty membership, not missing data. No feature-label deduplication occurs." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path chron:feature_occurrences ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized session; neither authenticates source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:session_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied application label qualifying feature names, distinct from an optional package name; no package inference or taxonomy restriction." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:app_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied app-session identity scoped by profile/participant/device; not an inferred app/time join key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:feature_session_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:AppFeatureSessionRecord ;
.

chron:AppInterruptionSessionRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied tracked-app session containing separately identified interruption intervals, not continuous app use or unlock-to-lock device use. Why Did you Stop (2021), author-copy physical p.3 Section3.2 and p.7 Section4.4.2, records each interruption individually within a learning session. Figure1 p.4 illustrates independent session/interruption times and app labels. Meaningful (3191754) primary279-284 uses one before/during/after sampling timing per app instance, not three waves within every instance. Supplied session answers, optional interruption references and independent quantities retain their own definitions. Package identity is independent of an optional printed app label. IDs and pairing are normalized, not recovered raw serialization. Unknown membership is not observed zero. No timer, constructor, return-to-learning, interruption cause, scoring, last-interruption selection, ESQ eligibility or duration is inferred." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:class chron:TaskActionRecord ;
            sh:description "Supplied device- or tracked-app-session-local action/activity membership in supplied array order; actions need not identify an app. Null/omission is unknown membership, [] supplied empty, never a reconstructed or complete-zero assertion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path chron:session_actions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied tracked-app session identity scoped by profile/participant/device, not reconstructed from app/time equality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:app_interruption_session_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:AppSessionQuestionnaireResponseRecord ;
            sh:description "Supplied answers local to their containing session, in preserved order; the owning class selects device-session or tracked-app answer shape. Null/omission is unknown membership, [] explicitly empty. No prompt eligibility, chronology or interruption join inferred." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path chron:session_questionnaire_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:class chron:DeviceSessionLabelRecord ;
            sh:description "Independent supplied device- or tracked-app-session classifications in preserved order, each retaining its source definition; null/omission is unknown membership." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path chron:session_labels ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied application label qualifying feature names, distinct from an optional package name; no package inference or taxonomy restriction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:app_name ;
        ] ,
        [
            sh:class chron:SessionInterruptionRecord ;
            sh:description "Supplied interruption members local to the containing session; omission/null is unknown and [] explicitly empty supplied membership. Neither establishes complete observation of zero interruptions." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path chron:interruptions ;
        ] ,
        [
            sh:class chron:SessionQuantityRecord ;
            sh:description "Supplied session-owned quantities in preserved order; null/omission unknown and [] explicitly empty. Local IDs and definition/scope compatibility are checked by ingress, not inferred from action membership." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:session_quantities ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized session; neither authenticates source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:session_record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:AppInterruptionSessionRecord ;
.

chron:ComplianceDayAssessment
    a sh:NodeShape ;
    rdfs:comment """One participant-day row of the `compliance_csv` — the compliance measure this engine actually computes. Its slots mirror the CSV columns: the eight-field `ComplianceDayCheckpoint` (pipeline_v2.rs) plus `expected_device_count`, which the writer joins from the enrolled-devices support file at write time; `compliance_threshold_percent` is the scalar input the engine compares against (not a CSV column), and `compliance_value_basis` is this ontology's own name for the imputation distinction, present in no engine output. This term exists because AttributionStatus formerly claimed to BE the compliance denominator contract while nothing described the quantity, its denominator, or its defaults.
WHAT THE DENOMINATOR ADMITS. `accumulate_minutes` (pipeline_v2_incremental.rs) walks the output rows and adds `duration_minutes` to the day's bucket only when the row's interaction type is App Usage or Non-Target Participant App Usage AND `minimum_duration_aggregate_eligible` is set. Numerator = minutes whose username is neither blank, "nan", nor "None"; denominator = numerator plus the rest.
WHAT IT SILENTLY EXCLUDES, in every case without a receipt in this output: (1) Filtered App Usage — excluded packages are RELABELLED rather than deleted, keep their raw evidence, and are then absent from both numerator and denominator, so package-exclusion policy moves this measure; (2) episodes ruled ineligible by the minimum-duration disposition, so a sub-floor episode's minutes are attributed to nobody; (3) any episode whose duration is blank, which contributes 0.0; (4) every non-app row type, including End of Usage Missing — so an episode zeroed by the long-duration cap leaves the denominator entirely. The compliance percent is therefore a share of ADMITTED minutes, never a share of the participant's day.
THE 100.0 DEFAULT IS AN IMPUTATION. When the participant is not in the device-sharing file, or when the admitted total for the day is zero, the engine writes compliance_percent = 100.0 without measuring anything, and `is_valid` then compares that literal against the threshold like any other value — so an unshared participant and a participant with no qualifying usage both count as valid days. The distinction survives only in `sharing_status` and `zero_real_usage`; compliance_value_basis is this ontology's name for it, so a summary of the percent column can state which rows it measured and which it inherited.
The participant-day spine is every (participant, date) pair seen on any APP-output row — the screen output is not consulted — including rows contributing no minutes, so a day can appear here with a zero total and a 100.0 percent.""" ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:integer ;
            sh:description "Enrolled device count for the participant, joined from the enrolled-devices support file; blank when the participant is absent from it. Reported alongside the measure, not used in it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:expected_device_count ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "compliance_percent >= compliance_threshold_percent. The engine's is_valid column, computed over imputed 100.0 values exactly as over measured ones." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:meets_compliance_threshold ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "True when no App Usage or Non-Target Participant App Usage row on this participant-day was aggregate-eligible with nonzero minutes, so the share was 0/0. The engine's zero_real_usage column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:zero_eligible_usage ;
        ] ,
        [
            sh:description "Whether the participant's device is declared shared, as read from the device-sharing support file." ;
            sh:in (
                "shared"
                "non_shared"
            ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path chron:sharing_status ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:description "Local calendar date the row is attributed to, in the run's output timezone (see TimezoneNormalizationPolicyId) and under the selected DayBoundaryAttributionId." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:date ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Admitted minutes on this participant-day with no resolved person. In the denominator, never in the numerator, and never dropped." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:unknown_minutes ;
        ] ,
        [
            sh:description "Whether compliance_percent was measured or imputed, and which imputation applied." ;
            sh:in (
                "measured_share"
                "imputed_non_shared_device"
                "imputed_no_eligible_usage"
            ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path chron:compliance_value_basis ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "known_minutes / (known_minutes + unknown_minutes) as a percentage rounded to two decimals — OR the literal 100.0 imputed for a non-shared participant or a day with no admitted minutes. Always read with compliance_value_basis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:compliance_percent ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "The percent a day must reach to count as valid. Study-specific; the product default is 70." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:compliance_threshold_percent ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Admitted minutes on this participant-day whose username is a real person (neither blank, \"nan\", nor \"None\"). The compliance numerator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:known_minutes ;
        ] ;
    sh:targetClass chron:ComplianceDayAssessment ;
.

chron:DayCoverageAssessment
    a sh:NodeShape ;
    rdfs:comment "One participant-day row of the `day_coverage_csv`: the observability status the engine actually computes, over a spine that is the participant's study window when one is configured and otherwise their first-to-last observed date. Distinct from CoverageAssessment, which models a cause attribution this pipeline does not make (see CoverageCause)." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Observability status for this participant-day." ;
            sh:in (
                "usage"
                "no_activity"
                "no_data"
            ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path chron:day_coverage_status ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:description "Local calendar date the row is attributed to, in the run's output timezone (see TimezoneNormalizationPolicyId) and under the selected DayBoundaryAttributionId." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:date ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:participant_id ;
        ] ;
    sh:targetClass chron:DayCoverageAssessment ;
.

chron:DeviceStateIntervalRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied kind-qualified interval with independently supplied endpoint state-record references. Hard Lock Life printed pp218/220 distinguishes screen bouts from upper-bound unlock cost. Equal time tokens do not equate endpoints or erase kind. Positive references resolve in the same profile, participant and known device; unknown endpoints remain null/omitted. Reuse UsageInterval without sorting, pairing, duration calculation, missing-event repair, or authentication inference. This is not an executed constructor." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied end state-record ID, independent of start and bounds; resolved within profile/participant/known device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:end_observation_ref ;
        ] ,
        [
            sh:description "Supplied interval meaning; upper-bound unlock cost is not authentication-input duration." ;
            sh:in (
                "screen_bout"
                "unlock_cost_upper_bound"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path chron:interval_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied start state-record ID, resolved within profile/participant/known device; null/omission is unknown, not reconstructed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:start_observation_ref ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized interval-record ID local to profile/participant/device; equal bounds do not merge records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:state_interval_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:DeviceStateIntervalRecord ;
.

chron:DeviceStateObservationRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized logged state-entry record, not a real-world occurrence, ringer occupancy or unlock-to-lock session. Hard Lock Life printed p218 Figure1/Section4.1.1 combines screen and keyguard states and timestamps state entry. Preserve independent state components and separately identified records at equal opaque times, including OFF/UNLOCKED. Optional/null values remain unknown, not inferred from the other component or an adjacent row. IDs and tokens are supplied, not recovered raw serialization." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied opaque state-entry time token. Null/omission/empty stay distinct; no clock conversion or chronology inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:observation_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized state-record ID local to profile/participant/device; never derived from a timestamp." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:state_observation_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:description "Supplied screen component only, independent of keyguard state; omission/null remains unknown." ;
            sh:in (
                "ON"
                "OFF"
            ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path chron:screen_state ;
        ] ,
        [
            sh:description "Supplied keyguard component only, independent of screen state; omission/null remains unknown." ;
            sh:in (
                "LOCKED"
                "UNLOCKED"
            ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path chron:keyguard_state ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ;
    sh:targetClass chron:DeviceStateObservationRecord ;
.

chron:DeviceUseSessionRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied normalized device-use session with independently identified questionnaire answers and definition-specific labels. Rabbit Hole (2023) physical p7 Section3.1.1 starts at ON_USERPRESENT and ends at OFF_LOCKED, OFF_UNLOCKED or SHUTDOWN; this is not necessarily unlock-to-lock, one app episode or a screen/keyguard observation. Physical pp8-11 associate ESM answers and original classifications with sessions; pp21-22 separately revise the definition. Source definition references and membership are supplied, not recovered raw joins. No constructor, scheduling, eligibility, scoring, relabeling or inference of missing responses runs during import. Oulasvirta et al. DOI10.1007/s00779-011-0412-2 printed p106 instead preserves separate opener, closer and action-membership definitions in the existing SessionConstructionPolicy. Its supplied record references the opener in one unambiguous profile-local policy; activation and next idle/lock phrases remain intact, not translated into Rabbit state codes. Approximate sampled inputs (p108) do not establish exact idle predicates, sample-to-boundary timestamp assignment or repaired action membership. Supplied session actions retain all-user-action membership and app-launch order independently of equal times (pp106–107). Hush Section3.2/6.1 also distinguishes alternating screen-on/off intervals with app activity and foreground membership in an explicitly supplied immediately following interval. Neither the successor nor app membership is inferred from times; missing membership cannot be classified as no activity. BFC is not computed. Jones DOI10.1145/2750858.2807542 physicalp6 preserves its scalar unlock/lock constructor and session-local repeated application launches with supplied F/B roles. Session-owned supplied quantities and labels remain distinct from actions and intervals; import computes neither ratios nor strategies. APNOMS2011 SectionIII-C independently supplies voice/3G/Wi-Fi sessions, AC/USB charging intervals and battery-change intervals. These are distinct source-defined intervals, not unlock-to-lock use; no raw boundary codes, charging/change equivalence or snapshot membership is inferred. Mathur2016 separately owns the four-member SessionLogger policy (screen-on, screen-off bounds, unlock inclusion gate, inclusive five-second merge and its provenance) versus QuantApp supplied sessions at screen-on/context start with unknown end. Hiniker2016 owns ordered app windows with lock/dark or state-conditioned system/launcher inactivity delimiters; it does not impose universal inactivity. Tapping2024 separately retains phone unlock-to-lock ownership, ordered foreground-change app periods and timestamped taps. Regret2025 instead uses screen-on/off parents and app-local intention, daily regret and screenshot context. Anatomy2016 keeps local key-entry attempts and separate code versus dismissal outcomes; supplied parent/action links are not a constructor, timestamp repair or raw join. AngryBirds2011 owns higher-order application chains separated by standby longer than thirty seconds, distinct from independent sampled app-or-epsilon states and individual foreground episodes. No sample/event construction runs." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:TaskActionRecord ;
            sh:description "Supplied device- or tracked-app-session-local action/activity membership in supplied array order; actions need not identify an app. Null/omission is unknown membership, [] supplied empty, never a reconstructed or complete-zero assertion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path chron:session_actions ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:class chron:DeviceSessionQuestionnaireResponseRecord ;
            sh:description "Supplied answers local to their containing session, in preserved order; the owning class selects device-session or tracked-app answer shape. Null/omission is unknown membership, [] explicitly empty. No prompt eligibility, chronology or interruption join inferred." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path chron:session_questionnaire_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied session identity scoped by profile/participant/device; not inferred from equal times or recovered raw keys." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:device_use_session_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied immediately following interval within the same disclosed family: alternating screen intervals (Hush Section6.1) or uninterrupted T0 sessions (Van Berkel Analysis). Scoped by profile/source/participant/known device; distinct and acyclic. Known on/off consistency applies only to alternating intervals. Never inferred from equal timestamps, gaps or continuation labels. Null/omission is unknown, not no successor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:following_device_use_session_reference ;
        ] ,
        [
            sh:class chron:DeviceSessionLabelRecord ;
            sh:description "Independent supplied device- or tracked-app-session classifications in preserved order, each retaining its source definition; null/omission is unknown membership." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path chron:session_labels ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied start-condition token validated against the local constructor definition; not an inferred event occurrence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:start_condition ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied terminal-condition token validated against the local constructor definition; not an inferred event occurrence or reconstructed closing time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:end_condition ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Compatible combined constructor, flat alternating-screen definition or opener of one complete separate-definition policy; references do not execute session construction." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:SessionQuantityRecord ;
            sh:description "Supplied session-owned quantities in preserved order; null/omission unknown and [] explicitly empty. Local IDs and definition/scope compatibility are checked by ingress, not inferred from action membership." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path chron:session_quantities ;
        ] ,
        [
            sh:description "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
            sh:in (
                "analyst_constructed_example"
                "supplied_normalized_records"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path chron:record_origin ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identifier for the versioned method profile." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_profile_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:DeviceUseSessionRecord ;
.

chron:GlanceAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim that the screen activated then deactivated without an unlock. Derived prov:Entity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
