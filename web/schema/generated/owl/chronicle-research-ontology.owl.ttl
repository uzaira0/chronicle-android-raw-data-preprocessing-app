    rdfs:range xsd:dateTime ;
    skos:definition "Evidence timestamp for the query execution." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:executor_id
    a owl:DatatypeProperty ;
    rdfs:label "executor_id" ;
