    "n supplied nonempty literal-space tokens, preserving repeated occurrences",
    "cardinality(unique current words minus unique prior-five-second words)",
    "H=-sum over256 nonzero bins of(count/total)*log2(count/total), in bits",
    "abs(Hcurrent-HimmediatelyPrior)"
  ],
