<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#call_handling>
    a owl:Class ;
    rdfs:label "call_handling" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "Source-controlled incoming-call alert presentation and handling, including accept/decline/repeated-postpone actions, call/conversation transitions and scripted call-arrival or caller-hangup rules. Distinct from intervention-tool availability/unlocking, device-setting actuation, outbound notification delivery and observed notification-record identity. Böhmer et al. DOI 10.1145/2556288.2557066, PDF pp. 3–4, 7–9; source-defined behavior does not establish raw event keys or an executable call-state implementation." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#collector>
    a owl:Class ;
    rdfs:label "collector" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#derived_feature>
    a owl:Class ;
    rdfs:label "derived_feature" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#device_session>
    a owl:Class ;
    rdfs:label "device_session" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#device_setting_actuation>
    a owl:Class ;
    rdfs:label "device_setting_actuation" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "Source-controlled behavior that changes a device setting, including action eligibility, calibration guards and triggering conditions; distinct from observed setting-change occurrences, occupancy intervals, intervention-content availability and predictive models. Pielot DOI 10.1145/2632048.2632060, author PDF p. 2, The Silencer Application: per-call acceleration calibration gates conditional temporary ringer muting." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#device_setting_state_interval>
    a owl:Class ;
    rdfs:label "device_setting_state_interval" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "An observed occupancy interval for a device setting such as ringer mode, bounded by state changes; not a device-use session or proof of occupancy during unobserved power-off time. Chang and Tang DOI 10.1145/2785830.2785852, PDF pp. 11–12, 14–15." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#diary_item>
    a owl:Class ;
    rdfs:label "diary_item" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#diary_response>
    a owl:Class ;
    rdfs:label "diary_response" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#intervention_content_state>
    a owl:Class ;
    rdfs:label "intervention_content_state" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "Intervention tool availability and unlock transitions; not a released artifact or measured outcome." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#model>
    a owl:Class ;
    rdfs:label "model" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#notification_alert>
    a owl:Class ;
    rdfs:label "notification_alert" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "An analytic alert proxy inferred from inbound Android notification callbacks, not an observed perceptible alert. Dismissed! retains the last posted callback in a same-second burst because it usually contains the perceived alert; it does not establish one-to-one callback/alert identity (DOI 10.1145/3229434.3229445, PDF pp. 3:3–3:4). An Annotif annotation candidate is a filtered record, not an alert claim." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#notification_attendance>
    a owl:Class ;
    rdfs:label "notification_attendance" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "An inferred per-notification seen, checked, consumed, or related attendance state, not direct observation of human reading (Dismissed! DOI 10.1145/3229434.3229445, PDF p. 3:6; My Phone and Me DOI 10.1145/2858036.2858566, accepted manuscript pp. 4–5)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#notification_delivery>
    a owl:Class ;
    rdfs:label "notification_delivery" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "Outbound intervention notification scheduling, triggering, and payload selection; not an observed Android notification event." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#notification_item>
    a owl:Class ;
    rdfs:label "notification_item" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "A source-defined notification identity that can persist across observed snapshots or repeated snoozes; distinct from a posted callback, an analytic alert proxy, and each item appearance or user action. Clear All DOI 10.1145/3340764.3340765, PDF p. 5; Snooze! DOI 10.1145/3229434.3229436, PDF p. 5. Identity keys remain source-specific and may be undisclosed." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#outcome>
    a owl:Class ;
    rdfs:label "outcome" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#participant_day>
    a owl:Class ;
    rdfs:label "participant_day" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#participant_hour>
    a owl:Class ;
    rdfs:label "participant_hour" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "A supplied participant-specific one-hour period, distinct from a participant day or pooled hour-of-day bucket. CHI2020 Paper36 CCM, DOI 10.1145/3313831.3376163 pp5–6, aggregates each retained emotion independently alongside app-launch counts and total use duration; period endpoints and clocks remain source-specific." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#participant_measure>
    a owl:Class ;
    rdfs:label "participant_measure" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#participant_record>
    a owl:Class ;
    rdfs:label "participant_record" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#pickup_activation>
    a owl:Class ;
    rdfs:label "pickup_activation" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#raw_occurrence>
    a owl:Class ;
    rdfs:label "raw_occurrence" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#raw_record>
    a owl:Class ;
    rdfs:label "raw_record" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#released_artifact>
    a owl:Class ;
    rdfs:label "released_artifact" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#screen_bout>
    a owl:Class ;
    rdfs:label "screen_bout" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#study_window>
    a owl:Class ;
    rdfs:label "study_window" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodTargetLayerId#text_entry_trial>
    a owl:Class ;
    rdfs:label "text_entry_trial" ;
    rdfs:subClassOf chron:MethodTargetLayerId ;
    skos:definition "One source-defined typing-analysis trial, distinct from app/device-use sessions or an analysis subset. Akpinar et al. DOI 10.1145/3577013 p13§4.2 reconstructs action sequences; Rodrigues et al. DOI 10.1145/3491102.3501908 p5§3.1.2 retains derived metrics for first-letter-to-keyboard-closure trials without retaining raw actions." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#artifact_reference>
    a owl:Class ;
    rdfs:label "artifact_reference" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#boolean>
    a owl:Class ;
    rdfs:label "boolean" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#duration>
    a owl:Class ;
    rdfs:label "duration" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#enumeration>
    a owl:Class ;
    rdfs:label "enumeration" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#expression>
    a owl:Class ;
    rdfs:label "expression" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#float>
    a owl:Class ;
    rdfs:label "float" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#integer>
    a owl:Class ;
    rdfs:label "integer" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#list>
    a owl:Class ;
    rdfs:label "list" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#object>
    a owl:Class ;
    rdfs:label "object" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#string>
    a owl:Class ;
    rdfs:label "string" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#time_window>
    a owl:Class ;
    rdfs:label "time_window" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#timestamp>
    a owl:Class ;
    rdfs:label "timestamp" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/MethodValueKindId#unspecified>
    a owl:Class ;
    rdfs:label "unspecified" ;
    rdfs:subClassOf chron:MethodValueKindId ;
.

chron:MicroUseClassificationPolicyId
    a owl:Class ;
    rdfs:label "MicroUseClassificationPolicyId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#none>
        <https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#okoshi_lt_5s>
    ) ;
    skos:definition "Canonical identifiers for a non-destructive classification of an already reconstructed app episode. Classification never changes duration, boundaries, inclusion, grouping, or aggregate credit." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#none> ,
        <https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#okoshi_lt_5s> ;
.

<https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#none>
    a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf chron:MicroUseClassificationPolicyId ;
    skos:definition "Compatibility default: do not classify episodes and do not add a micro-use column to the default scientific CSV." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MicroUseClassificationPolicyId#okoshi_lt_5s>
    a owl:Class ;
    rdfs:label "okoshi_lt_5s" ;
    rdfs:subClassOf chron:MicroUseClassificationPolicyId ;
    skos:definition "Okoshi et al. (2025) source-aligned component: a positive, bounded raw reconstructed duration strictly below five seconds is micro-use; equality is not micro-use and an unbounded or zero-length artifact is not classifiable." ;
.

chron:MinimumDurationComparatorId
    a owl:Class ;
    rdfs:label "MinimumDurationComparatorId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#strict_lt>
        <https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#inclusive_le>
    ) ;
    skos:definition "Comparator applied once to immutable raw reconstructed episode duration at the post-materialization, pre-concurrency checkpoint." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#inclusive_le> ,
        <https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#strict_lt> ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#inclusive_le>
    a owl:Class ;
    rdfs:label "inclusive_le" ;
    rdfs:subClassOf chron:MinimumDurationComparatorId ;
    skos:definition "Qualify a bounded episode when raw duration is less than or exactly equal to the configured minimum_usage_duration." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationComparatorId#strict_lt>
    a owl:Class ;
    rdfs:label "strict_lt" ;
    rdfs:subClassOf chron:MinimumDurationComparatorId ;
    skos:definition "Qualify a bounded episode only when raw duration is strictly less than the configured minimum_usage_duration; compatibility default." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationDispositionId#chronicle_blank_keep_row>
    a owl:Class ;
    rdfs:label "chronicle_blank_keep_row" ;
    rdfs:subClassOf chron:MinimumDurationDispositionId ;
    skos:definition "Compatibility default: retain the row and its boundaries but blank duration_seconds and duration_minutes." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationDispositionId#drop_row>
    a owl:Class ;
    rdfs:label "drop_row" ;
    rdfs:subClassOf chron:MinimumDurationDispositionId ;
    skos:definition "Remove the app output row while retaining its exact bounds, duration, reason, and source ranges in a dedicated excluded-lineage artifact." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationDispositionId#retain_and_credit>
    a owl:Class ;
    rdfs:label "retain_and_credit" ;
    rdfs:subClassOf chron:MinimumDurationDispositionId ;
    skos:definition "Retain raw timing and credit the episode while recording that it qualified as below the declared floor." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MinimumDurationDispositionId#retain_but_exclude>
    a owl:Class ;
    rdfs:label "retain_but_exclude" ;
    rdfs:subClassOf chron:MinimumDurationDispositionId ;
    skos:definition "Retain raw timing and lineage but mark the episode ineligible for headline aggregates." ;
.

chron:NotificationAcceptanceRecord
    a owl:Class ;
    rdfs:label "NotificationAcceptanceRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:acceptance_record_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:questionnaire_response_references ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:acceptance_record_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:integer

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:integer ;
                            owl:withRestrictions (

                                [
                                    xsd:minInclusive 0 ;
                                ]
                            ) ;
                        ]

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:integer ;
                            owl:withRestrictions (

                                [
                                    xsd:maxInclusive 1 ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:acceptance_code ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:questionnaire_response_references ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:acceptance_record_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:acceptance_code ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:evidence_references ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:acceptance_code ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:evidence_references ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Independently supplied binary acceptance outcome, separate from clicked or dismissed evidence. My Phone and Me p.8 recodes a dismissal as accepted when its handling answer says no further action was required; the clicked branch need not have that answer. Import preserves supplied references and code without applying this formula, enrolling an item in the questionnaire analysis, or filling an absent response/outcome with zero." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:NotificationAttributionPolicy
    a owl:Class ;
    rdfs:label "NotificationAttributionPolicy" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_target_behavior ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_temporal_direction ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_target_behavior ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_attribution_confidence ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_temporal_direction ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_target_behavior ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_temporal_direction ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_window ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_attribution_confidence ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_evidence_mode ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_attribution_confidence ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_attribution_policy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_attribution_policy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_window ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_window ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_evidence_mode ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_evidence_mode ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:notification_attribution_policy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:method_comparator ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_package_scope ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:notification_disposition ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:method_comparator ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_package_scope ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:method_comparator ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_package_scope ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:notification_disposition ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:notification_disposition ;
        ] ;
    skos:definition "A policy relating notification evidence to behavior or artifact disposition, distinct from generic foreground/background attribution." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#arrival>
    a owl:Class ;
    rdfs:label "arrival" ;
    rdfs:subClassOf chron:NotificationContextSamplingBoundaryId ;
    skos:definition "Collected at arrival (My Phone and Me accepted manuscript p.4 Table1); no exact clock alignment or GPS join is implied." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#interruption>
    a owl:Class ;
    rdfs:label "interruption" ;
    rdfs:subClassOf chron:NotificationContextSamplingBoundaryId ;
    skos:definition "Interruption-relative context alignment, not necessarily a sensor sample exactly at interruption (Reachable p.6 Section4.2: closest screen reading within plus/minus0.5s). No alignment or tie handling runs on import." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#posting>
    a owl:Class ;
    rdfs:label "posting" ;
    rdfs:subClassOf chron:NotificationContextSamplingBoundaryId ;
    skos:definition "Posting-relative feature anchor, not a sensor sample exactly at posting. Beyond Interruptibility (DOI 10.1145/3130956, pp.8,11–12) starts sensor collection 30 seconds earlier and describes independent retrospective windows. Neither sample-time equality nor a reducer is inferred." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#removal>
    a owl:Class ;
    rdfs:label "removal" ;
    rdfs:subClassOf chron:NotificationContextSamplingBoundaryId ;
    skos:definition "Collected at removal (My Phone and Me accepted manuscript p.4 Table1); not a response, swipe or seen-time boundary." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#source_unreported>
    a owl:Class ;
    rdfs:label "source_unreported" ;
    rdfs:subClassOf chron:NotificationContextSamplingBoundaryId ;
    skos:definition "The inspected source does not disclose context sampling alignment (Content-driven notifications p.3 Table1/NotifyMe); previous-minute features do not supply it." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#action_occurrence>
    a owl:Class ;
    rdfs:label "action_occurrence" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Separately identified supplied item-owned action with an open action label; repeated postpones and widget moves are distinct from call endings (Interrupted by a Phone Call pp.3,7–8). No raw action code or intent is inferred." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#arrival>
    a owl:Class ;
    rdfs:label "arrival" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#assumed_seen>
    a owl:Class ;
    rdfs:label "assumed_seen" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#category>
    a owl:Class ;
    rdfs:label "category" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Supplied item-specific information category, not a participant/title multi-label annotation or a category computed on import (Content-driven notifications p.4 Dataset)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#clicked>
    a owl:Class ;
    rdfs:label "clicked" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#context>
    a owl:Class ;
    rdfs:label "context" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "A supplied item-linked context value, distinct from a lifecycle/action event or response classification (My Phone and Me p.4 Table1; Content-driven notifications p.3 Table1)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#corresponding_app_launch>
    a owl:Class ;
    rdfs:label "corresponding_app_launch" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#dismissed>
    a owl:Class ;
    rdfs:label "dismissed" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#notification_bar_click>
    a owl:Class ;
    rdfs:label "notification_bar_click" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#phone_unlock>
    a owl:Class ;
    rdfs:label "phone_unlock" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#posted_callback>
    a owl:Class ;
    rdfs:label "posted_callback" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Separately identified supplied NotificationListenerService posted callback, not a logical item arrival or perceived alert (Dismissed! printed pp.3:3–3:4). Populated ingress requires a supplied callback-group owner, not an item history." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#quantity>
    a owl:Class ;
    rdfs:label "quantity" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Independently supplied named item-owned quantity, distinct from context, seen latency or response classification. Call to Action (DOI 10.3390/s24082612, pp.7–8) defines Interaction Delay from appearance to removal. Import retains a supplied value/unit/supports without endpoint pairing, arithmetic, rounding or eligibility filtering." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#removal>
    a owl:Class ;
    rdfs:label "removal" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#response_endpoint>
    a owl:Class ;
    rdfs:label "response_endpoint" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Supplied graded response endpoint, separate from evidence availability: Reachable pp.3-4/p.6 distinguishes null, partial and complete responses. No endpoint is inferred." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#response_objective_label>
    a owl:Class ;
    rdfs:label "response_objective_label" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Independently supplied named response-objective label (Reachable p.4/p.6: reachability, engageability, receptivity), not a universal acceptance recode or computed truth table." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#response_stage>
    a owl:Class ;
    rdfs:label "response_stage" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
    skos:definition "Supplied stage-specific response evidence with independent observability; unobservable does not mean no decision or negative response (Reachable pp.3-4 Sections3.1-3.2.1/Figure1)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#seen_latency>
    a owl:Class ;
    rdfs:label "seen_latency" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceKindId#swipe_dismiss>
    a owl:Class ;
    rdfs:label "swipe_dismiss" ;
    rdfs:subClassOf chron:NotificationEvidenceKindId ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceRoleId#inferred>
    a owl:Class ;
    rdfs:label "inferred" ;
    rdfs:subClassOf chron:NotificationEvidenceRoleId ;
    skos:definition "Explicitly inferred assertion or derived quantity, not directly observed attention or an executed inference here." ;
.

<https://w3id.org/chronicle-usage-ontology/core/NotificationEvidenceRoleId#recorded>
    a owl:Class ;
    rdfs:label "recorded" ;
    rdfs:subClassOf chron:NotificationEvidenceRoleId ;
    skos:definition "Supplied recorded event or source-recorded classification; clicked/dismissed can incorporate inference." ;
.

