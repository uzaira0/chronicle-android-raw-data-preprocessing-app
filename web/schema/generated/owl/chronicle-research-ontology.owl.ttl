chron:keyguard_state
    a owl:ObjectProperty ;
    rdfs:label "keyguard_state" ;
    rdfs:range chron:KeyguardStateId ;
    skos:definition "Supplied keyguard component only, independent of screen state; omission/null remains unknown." ;
