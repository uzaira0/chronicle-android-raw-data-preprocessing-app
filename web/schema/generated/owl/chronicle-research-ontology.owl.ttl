.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#attribution>
    a owl:Class ;
    rdfs:label "attribution" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#construct>
    a owl:Class ;
    rdfs:label "construct" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#engagement>
    a owl:Class ;
    rdfs:label "engagement" ;
    rdfs:subClassOf chron:MeasurementLayer ;
    skos:definition "Device/app usage-engagement measurement (screen-on, app-in-foreground). RELATED to, but deliberately NOT equated with, BCIO \"participant engagement with behaviour change intervention\" (BCIO:013000): BCIO engagement is intervention-scoped whereas a chronicle app is generally not a behaviour-change intervention — hence relatedMatch, not closeMatch (doc 13 D3)." ;
    skos:relatedMatch BCIO:013000 ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#person>
    a owl:Class ;
    rdfs:label "person" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#presence>
    a owl:Class ;
    rdfs:label "presence" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#validity>
    a owl:Class ;
    rdfs:label "validity" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

chron:NodeExecution
    a owl:Class ;
    rdfs:label "NodeExecution" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:ended_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:ended_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:ended_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:executes_step ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterSet ;
            owl:onProperty chron:used_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:started_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:executes_step ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:started_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:started_at ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:StepDefinition ;
            owl:onProperty chron:executes_step ;
        ] ;
    skos:broadMatch prov:Activity ;
    skos:definition "A retrospective execution of a StepDefinition. A prov:Activity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ParameterBinding
    a owl:Class ;
    rdfs:label "ParameterBinding" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:knob_value ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:knob_value ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:knob_value ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:knob_key ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:knob_key ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:knob_key ;
        ] ;
    skos:definition "One knob = value binding within a ParameterSet." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:PlatformEventOccurrence
    a owl:Class ;
    rdfs:label "PlatformEventOccurrence" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:occurrence_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:occurrence_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:occurrence_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:event_code ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:EventTypeCode ;
            owl:onProperty chron:event_code ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:event_code ;
        ] ;
    skos:definition "The real-world Android lifecycle/system occurrence (an app resuming, the screen turning off, a shutdown). This is the thing that happened in the world — NOT the logged record and NOT an observation. Deliberately untyped as sosa:Observation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ReconstructionStrategy
    a owl:Class ;
    rdfs:label "ReconstructionStrategy" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:strategy_version ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:strategy_version ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:strategy_version ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:strategy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:strategy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:canonical_iri ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ReconstructionStrategyId ;
            owl:onProperty chron:strategy_kind ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:strategy_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:strategy_kind ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:canonical_iri ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty chron:canonical_iri ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:strategy_kind ;
        ] ;
    skos:broadMatch sosa:Procedure ;
    skos:definition "A named, versioned episode-reconstruction algorithm (semantic category + canonical IRI). Subclass only where formal restrictions genuinely differ." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#eyes_complement>
    a owl:Class ;
    rdfs:label "eyes_complement" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "EYES complement-based device-state segmentation (ACTIVE = not(SHUTDOWN or IDLE or GAP or GLANCE))." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#fused_matcher>
    a owl:Class ;
