PREFIX BCIO: <http://humanbehaviourchange.org/ontology/BCIO_>
PREFIX chron: <https://w3id.org/chronicle-usage-ontology/core/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pplan: <http://purl.org/net/p-plan#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://w3id.org/chronicle-usage-ontology/core.owl.ttl>
    a owl:Ontology ;
    rdfs:label "chronicle-usage-ontology-core" ;
    dcterms:license "MIT" ;
    dcterms:title "Chronicle Android Usage Measurement — Research Ontology (core module)" ;
    rdfs:seeAlso <https://doi.org/10.1177/21522715261417288> ;
    skos:definition """Core entity model for the Android UsageStatsManager event-log -> usage-measurement research ontology. Implements the D4 five-way split from docs/pipeline-graph/13-research-ontology-design.md (occurrence / record / optional logging-observation / assertion / execution / interval) so provenance can always distinguish what was OBSERVED from what was RECONSTRUCTED, and so absence and unresolved attribution can never silently drop from denominators.
Backbone (D2, upper-neutral): SOSA/SSN + OWL-Time + PROV-O + P-Plan. BFO-vs-DOLCE is deliberately deferred and, when needed, bridged via SSSOM — this module asserts only the free, standards-grounded mappings. This is the FOUNDATION module: SHACL axioms, BCIO/Shaleha close-mappings, DQV quality, and generator wiring are later build-order steps (doc 13 §"Prioritized build order").""" ;
    skos:note "Screen-use measurement framework alignment (Shaleha, Roque, Andrews, Calfee & Lee 2026, doi:10.1177/21522715261417288): this ontology's measures sit on the framework's OBJECTIVE-LOG / passive-sensing modality axis. Referenced, not class-mapped, because the framework has no stable class IRIs." ;
.

chron:CoverageAssessment
    a owl:Class ;
    rdfs:label "CoverageAssessment" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:expected_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:expected_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:actually_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:expected_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:policy_treatment ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:actually_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:actually_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:CoverageCause ;
            owl:onProperty chron:coverage_cause ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:availability_threshold ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:device_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:policy_treatment ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:policy_treatment ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:coverage_cause ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:device_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:availability_threshold ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:device_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty chron:availability_threshold ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:coverage_cause ;
        ] ;
    skos:definition "A coverage/observability judgement over a stream window: expected vs actual data availability, its threshold, bounding events, and best-supported cause. A gap MAY CONCEAL usage — this asserts only how the measurement policy treats the interval, never that the device was inactive." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:EffectiveUsageMeasure
    a owl:Class ;
    rdfs:label "EffectiveUsageMeasure" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:effective_minutes ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:produced_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:effective_minutes ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:cites_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty chron:effective_minutes ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:produced_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:cites_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty chron:date ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:date ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:NodeExecution ;
            owl:onProperty chron:produced_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:coverage_policy ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterSet ;
            owl:onProperty chron:cites_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:date ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:coverage_policy ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:coverage_policy ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:denotes_interval ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "The effective-usage duration (episode interval intersected with active coverage, per a named policy). Cites the ParameterSet and execution that produced it. NOT asserted as physical truth — carries the coverage policy that produced it." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:GlanceAssertion
    a owl:Class ;
    rdfs:label "GlanceAssertion" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:MeasurementLayer ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ReconstructionExecution ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:denotes_interval ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "A claim that the screen activated then deactivated without an unlock. Derived prov:Entity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:LoggingObservation
    a owl:Class ;
    rdfs:label "LoggingObservation" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:result_record ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageEventRecord ;
            owl:onProperty chron:result_record ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:observed_property ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:result_record ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:observed_property ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:observed_property ;
        ] ;
    skos:broadMatch sosa:Observation ;
    skos:definition "OPTIONAL. The OS logger's act of observing a device property, modeled only if that abstraction is genuinely needed. Do NOT type UsageEventRecord as this." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:PipelinePlan
    a owl:Class ;
    rdfs:label "PipelinePlan" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:plan_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:plan_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:plan_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:steps ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:StepDefinition ;
            owl:onProperty chron:steps ;
        ] ;
    skos:broadMatch pplan:Plan ;
    skos:definition "The prospective processing workflow. A p-plan:Plan / prov:Plan." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:UsageEpisodeAssertion
    a owl:Class ;
    rdfs:label "UsageEpisodeAssertion" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:attribution ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:app_package_name ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:attribution ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:MeasurementLayer ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:app_package_name ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:app_package_name ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:AttributionAssertion ;
            owl:onProperty chron:attribution ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ReconstructionExecution ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:denotes_interval ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "A claim that one app was in continuous use over an interval. A derived prov:Entity (what the pipeline asserts, not a ground truth)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:UsageSessionAssertion
    a owl:Class ;
    rdfs:label "UsageSessionAssertion" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:MeasurementLayer ;
            owl:onProperty chron:measurement_layer ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ReconstructionExecution ;
            owl:onProperty chron:reconstructed_by ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:denotes_interval ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "A claim of continuous device use between unlock and lock. Derived prov:Entity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:AttributionAssertion
    a owl:Class ;
    rdfs:label "AttributionAssertion" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:on_shared_device ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:on_shared_device ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:AttributionStatus ;
            owl:onProperty chron:attribution_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty chron:on_shared_device ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:attribution_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:attributed_person ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:attribution_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:attributed_person ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:attributed_person ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Attribution of usage to a person. Exactly one status is required; an actual person is attached only when known. The participant-device-day denominator must satisfy duration conservation: target + known_non_target + unresolved = eligible." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

<https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#known_non_target>
    a owl:Class ;
    rdfs:label "known_non_target" ;
    rdfs:subClassOf chron:AttributionStatus ;
    skos:definition "Attributed to a known person other than the target child (label \"Other\"). Counts as known/attributed." ;
.

<https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#target>
    a owl:Class ;
    rdfs:label "target" ;
    rdfs:subClassOf chron:AttributionStatus ;
    skos:definition "Attributed to the enrolled target child (label \"Target Child\")." ;
.

<https://w3id.org/chronicle-usage-ontology/core/AttributionStatus#unresolved>
    a owl:Class ;
    rdfs:label "unresolved" ;
    rdfs:subClassOf chron:AttributionStatus ;
    skos:definition "Usage occurred but the person is unresolved (label \"None\"/blank). Counts toward the compliance denominator; never dropped." ;
.

<https://w3id.org/chronicle-usage-ontology/core/CoverageCause#collector_reporting_gap>
    a owl:Class ;
    rdfs:label "collector_reporting_gap" ;
    rdfs:subClassOf chron:CoverageCause ;
    skos:definition "Device on but the collector did not report." ;
.

<https://w3id.org/chronicle-usage-ontology/core/CoverageCause#shutdown_boundary>
    a owl:Class ;
    rdfs:label "shutdown_boundary" ;
    rdfs:subClassOf chron:CoverageCause ;
    skos:definition "Gap opens with a clean shutdown-class event." ;
.

<https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unclean_power_loss>
    a owl:Class ;
    rdfs:label "unclean_power_loss" ;
    rdfs:subClassOf chron:CoverageCause ;
    skos:definition "Gap ends with a startup-class event but no clean shutdown (battery death / forced off)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unknown>
    a owl:Class ;
    rdfs:label "unknown" ;
    rdfs:subClassOf chron:CoverageCause ;
    skos:definition "Cause not determinable from events." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored>
    a owl:Class ;
    rdfs:label "interval_censored" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint known only to lie within bounds set by later evidence (e.g. a fallback close)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed>
    a owl:Class ;
    rdfs:label "observed" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint directly observed in the event stream." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored>
    a owl:Class ;
    rdfs:label "right_censored" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Observation ended while usage was believed still open." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved>
    a owl:Class ;
    rdfs:label "unobserved" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint not observed and not bounded by later evidence." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_paused>
    a owl:Class ;
    rdfs:label "activity_paused" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "App moved to background (Move to Background / UI:2)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_resumed>
    a owl:Class ;
    rdfs:label "activity_resumed" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "App moved to foreground (Move to Foreground / UI:1)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_stopped>
    a owl:Class ;
    rdfs:label "activity_stopped" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Activity stopped (UI:23) — proximity/fallback close." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_shutdown>
    a owl:Class ;
    rdfs:label "device_shutdown" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Device shutdown boundary (UI:26 / importance 26)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_startup>
    a owl:Class ;
    rdfs:label "device_startup" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Device startup boundary (UI:27 / importance 27)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_hidden>
    a owl:Class ;
    rdfs:label "keyguard_hidden" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Keyguard hidden / device unlocked (UI:18)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#keyguard_shown>
    a owl:Class ;
    rdfs:label "keyguard_shown" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Keyguard shown / device locked (UI:17)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#screen_interactive>
    a owl:Class ;
