{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzaira0:semantic-federation:protocol:semantic-profile-lock:0.1",
  "title": "Resolved semantic profile dependency closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "root_profile", "root_version", "root_manifest_digest", "entries", "closure_digest"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "root_profile": { "type": "string", "minLength": 1 },
    "root_version": { "type": "string", "minLength": 1 },
    "root_manifest_digest": { "$ref": "#/$defs/digest" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "version", "manifest_digest", "resources"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "manifest_digest": { "$ref": "#/$defs/digest" },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest", "media_type", "role"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "digest": { "$ref": "#/$defs/digest" },
                "media_type": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "closure_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
