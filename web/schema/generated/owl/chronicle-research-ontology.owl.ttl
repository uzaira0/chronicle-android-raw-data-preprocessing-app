chron:expected_script_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "expected_script_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional reference to a compatible task-sequence setting within the owning profile/source; null/omission does not assert an expected script. No script matcher runs." ;
