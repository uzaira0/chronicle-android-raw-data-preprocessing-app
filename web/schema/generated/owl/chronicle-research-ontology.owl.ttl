chron:compliance_percent
    a owl:DatatypeProperty ;
    rdfs:label "compliance_percent" ;
    rdfs:range xsd:float ;
    skos:definition "known_minutes / (known_minutes + unknown_minutes) as a percentage rounded to two decimals — OR the literal 100.0 imputed for a non-shared participant or a day with no admitted minutes. Always read with compliance_value_basis." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:compliance_threshold_percent
    a owl:DatatypeProperty ;
    rdfs:label "compliance_threshold_percent" ;
    rdfs:range xsd:float ;
    skos:definition "The percent a day must reach to count as valid. Study-specific; the product default is 70." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:compliance_value_basis
    a owl:ObjectProperty ;
    rdfs:label "compliance_value_basis" ;
