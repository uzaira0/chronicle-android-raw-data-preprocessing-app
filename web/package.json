{
  "name": "chronicle-preprocessing-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-clean-env.mjs vite build",
    "generate:contract": "node scripts/run-clean-env.mjs vite-node scripts/generate_contract_artifacts.mts",
    "preview": "node scripts/run-clean-env.mjs vite preview --host 127.0.0.1 --port 4173",
    "host:local": "npm run build && npm run preview",
    "prepare:github-pages": "node scripts/run-clean-env.mjs vite-node scripts/prepare_github_pages_artifact.mts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-clean-env.mjs vitest run",
    "test:coverage:critical": "../scripts/check-web-critical-coverage.sh",
    "check:contract": "node scripts/run-clean-env.mjs vite-node scripts/generate_contract_artifacts.mts --check && node scripts/run-clean-env.mjs vite-node scripts/check_contract_consistency.mts",
    "check:deploy-artifact": "node scripts/run-clean-env.mjs vite-node scripts/check_deploy_artifact.mts",
    "check:github-pages-artifact": "node scripts/run-clean-env.mjs vite-node scripts/check_deploy_artifact.mts github-pages",
    "test:e2e": "node scripts/run-clean-env.mjs playwright test",
    "test:e2e:headed": "node scripts/run-clean-env.mjs playwright test --headed",
    "test:e2e:smoke": "node scripts/run-clean-env.mjs playwright test --grep @smoke",
    "test:e2e:visual": "node scripts/run-clean-env.mjs playwright test --grep '@visual'",
    "test:e2e:all-browsers": "node scripts/run-clean-env.mjs playwright test --grep '@smoke'",
    "process:browser": "vite-node scripts/run_browser_processing.mts",
    "benchmark:browser": "node scripts/benchmark_browser_processing.mjs",
    "build:wasm": "wasm-pack build ../rust/chronicle_app_usage_wasm --target web --out-dir src/wasm/chronicle_app_usage_wasm/pkg",
    "check:size": "size-limit",
    "check:dead-code": "knip",
    "lint:complexity": "eslint src --ext .ts,.tsx --ignore-pattern 'src/wasm/**'",
    "check:licenses": "license-checker --production --onlyAllow 'MIT;MIT*;BSD-2-Clause;BSD-3-Clause;Apache-2.0;ISC;CC0-1.0;Unlicense;CC-BY-4.0;Python-2.0;0BSD;BlueOak-1.0.0' --excludePrivatePackages --excludePackages 'buffers@0.1.1' --summary"
  },
  "dependencies": {
    "@sentry/browser": "^10.51.0",
    "comlink": "^4.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^5.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-app": "^11.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.7.0",
    "knip": "^5.0.0",
    "license-checker": "^25.0.1",
    "size-limit": "^11.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "size-limit": [
    {
      "path": "dist/**/*.js",
      "limit": "2 MB"
    }
  ]
}
