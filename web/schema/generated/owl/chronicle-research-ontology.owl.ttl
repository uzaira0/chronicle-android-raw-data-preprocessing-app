            owl:onProperty chron:end_action_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:quantity_setting_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:quantity_setting_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:string

                        [
