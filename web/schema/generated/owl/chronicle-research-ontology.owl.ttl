.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored>
    a owl:Class ;
    rdfs:label "interval_censored" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint known only to lie within bounds set by later evidence (e.g. a fallback close)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed>
    a owl:Class ;
    rdfs:label "observed" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint directly observed in the event stream." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored>
    a owl:Class ;
    rdfs:label "right_censored" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Observation ended while usage was believed still open." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved>
    a owl:Class ;
    rdfs:label "unobserved" ;
    rdfs:subClassOf chron:EndpointStatus ;
    skos:definition "Endpoint not observed and not bounded by later evidence." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventRetentionSetId#foreground_background_only>
    a owl:Class ;
    rdfs:label "foreground_background_only" ;
    rdfs:subClassOf chron:EventRetentionSetId ;
    skos:definition "Types 1 and 2 only. The minimal set: reconstruction sees the foreground/background pair and nothing else, so every close is an observed app transition. It is a strict subset of usage_logger_5 and toth_trifonova_app, but NOT of parry_toth_7, which drops type 2." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventRetentionSetId#none>
    a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf chron:EventRetentionSetId ;
    skos:definition "Retain every interaction type; the engine's own filtering still applies (default)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventRetentionSetId#parry_toth_7>
    a owl:Class ;
    rdfs:label "parry_toth_7" ;
    rdfs:subClassOf chron:EventRetentionSetId ;
    skos:definition "Parry & Toth: types 1, 15, 16, 17, 18, 26, 27. Activity Paused (type 2) is NOT retained — the paper closes on screen and device events instead. This differs from the parry_toth_forward_pairing reconstruction arm, which ports Culverhouse's adaptation and does close on type 2." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventRetentionSetId#toth_trifonova_app>
    a owl:Class ;
    rdfs:label "toth_trifonova_app" ;
    rdfs:subClassOf chron:EventRetentionSetId ;
    skos:definition "Toth & Trifonova: types 1, 2, 17, 26 — the foreground pair plus keyguard-shown and shutdown. Type 17 is Keyguard Shown (the screen locking), NOT screen-on, which is type 15 and is not in this set; an earlier version of this description said screen-on and disagreed with the code it documents." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventRetentionSetId#usage_logger_5>
    a owl:Class ;
    rdfs:label "usage_logger_5" ;
    rdfs:subClassOf chron:EventRetentionSetId ;
    skos:definition "Usage Logger: types 1, 2, 7, 26, 27. The only set that retains User Interaction (type 7)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_paused>
    a owl:Class ;
    rdfs:label "activity_paused" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "App moved to background (Move to Background / UI:2)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_resumed>
    a owl:Class ;
    rdfs:label "activity_resumed" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "App moved to foreground (Move to Foreground / UI:1)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#activity_stopped>
    a owl:Class ;
    rdfs:label "activity_stopped" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Activity stopped (UI:23) — proximity/fallback close." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#continue_previous_day>
    a owl:Class ;
    rdfs:label "continue_previous_day" ;
    rdfs:subClassOf chron:EventTypeCode ;
    skos:definition "Continue Previous Day (UI:4). App-scoped; named by the gesis_app_scoped_starts opener set." ;
.

<https://w3id.org/chronicle-usage-ontology/core/EventTypeCode#device_shutdown>
    a owl:Class ;
    rdfs:label "device_shutdown" ;
    rdfs:subClassOf chron:EventTypeCode ;
