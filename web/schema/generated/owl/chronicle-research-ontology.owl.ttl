    rdfs:label "diary_source_adapter_receipt" ;
    rdfs:range chron:DiarySourceAdapterReceipt ;
    skos:definition "Exact source-layout adapter execution receipt nested in this binding." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_title
    a owl:DatatypeProperty ;
    rdfs:label "diary_title" ;
    rdfs:range xsd:string ;
    skos:definition "Source title or label of the diary instrument." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_trigger_kind
    a owl:ObjectProperty ;
    rdfs:label "diary_trigger_kind" ;
    rdfs:range chron:DiaryTriggerKindId ;
    skos:definition "Trigger category for this rule." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_window_end
    a owl:DatatypeProperty ;
    rdfs:label "diary_window_end" ;
    rdfs:range xsd:string ;
    skos:definition "Latest local or relative time at which the rule applies." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_window_start
