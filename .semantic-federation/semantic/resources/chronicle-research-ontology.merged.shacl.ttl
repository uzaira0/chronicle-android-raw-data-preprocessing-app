            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:questionnaire_item_label ;
        ] ;
    sh:targetClass chron:NotificationQuestionnaireResponseRecord ;
.

chron:ParameterBinding
    a sh:NodeShape ;
    rdfs:comment """One knob = value binding within a ParameterSet: a key and its canonical JSON value, and nothing else.
THIS IS FLAT AND UNTYPED, DELIBERATELY AND COMPLETELY. The runtime provenance builder (`workflow_provenance.rs`) emits one of these nodes per entry of the request's parameter object with only `chron:knob_key` and `chron:knob_value`. No binding declares what kind of consequence its knob has, and that is true of the named research axes as well: selecting `zerrer_60s` reaches the sidecar as the string pair ("session_grouping_policy", "zerrer_60s"), carrying no link to SessionGroupingPolicyId. A reader recovers axis identity by matching knob_key against the option slots that carry a `research_axis_enum` annotation in `chronicle-local-contract.linkml.yaml`, and recovers nothing for the rest.
THE SHAPE OF WHAT IS LEFT OVER. Some keys the contract classifies as computational (`COMPUTATIONAL_BROWSER_OPTION_KEYS`) carry a `research_axis_enum`; `timezone_handling`, via `research_ontology_enum`, also binds an ontology enum. The remaining computational keys have no term here at all. That set is not a residue of presentation knobs — it includes keys that change measured quantities: `use_app_codebook` (DEFAULT ON) RESTATES WHAT EACH ROW'S APP IS — `join_codebook` attaches a second, codebook-sourced identity (`application_label` arrives as `codebook_application_label` beside the row's own label) and the whole category/genre block, then `derive_broad_category` and `collapse_app_genre` write the row's reported broad category and `genre_id_scraped`, each defaulting to "Unknown" when the codebook offers nothing. The package key is untouched, but every category-level analysis of the output is a reading of the codebook rather than of the device; `proximity_interval_seconds` MOVES EPISODE BOUNDARIES by treating an Activity Stopped within its grace as an intra-app teardown rather than a close; `timezone_handling` can delete rows outright (see TimezoneNormalizationPolicyId, the one such key this ontology now names); `interaction_type_remap` rewrites the event vocabulary at ingest, BEFORE reconstruction sees it, while `interaction_types_to_remove` deletes output rows AFTER it — two knobs that read alike and sit on opposite sides of the reconstruction; `long_duration_threshold_hours` decides which episodes surface as End of Usage Missing; `minimum_usage_duration` blanks durations; `model_concurrent_usage` splits overlapping episodes.
WHY THEY STAY UNTYPED, rather than each becoming an axis. Every named axis in this ontology is an enumerated PUBLISHED-METHOD vocabulary whose values are alternatives a study could have chosen and a paper can be cited for. A continuous grace in seconds, a float threshold, or a boolean has no such value set; minting one would mean inventing permissible values no source declares, which is the failure mode the EventRetentionSetId provenance warning already guards against. `proximity_interval_seconds` is the clearest case: the kernel implements exactly one proximity rule with a numeric grace, so there is no vocabulary to name, and calling it an axis would assert a choice between methods that does not exist. These keys are declared and described in the local contract instead, which is where a non-vocabulary parameter belongs.
Two consequences a consumer must not overlook. A ParameterSet digest is identical whether a knob was set deliberately or left at its default, so the sidecar answers "what ran" and never "what was chosen". And two knob keys with equal consequence — one an axis, one not — are indistinguishable here, so a provenance graph must not be read as ranking them.""" ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Option/knob key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:knob_key ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Bound value (canonical JSON string)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:knob_value ;
        ] ;
    sh:targetClass chron:ParameterBinding ;
.

chron:ParameterProvenanceAssertion
    a sh:NodeShape ;
    rdfs:comment "Documentary and derivation provenance for one method parameter. A citation, a default, an author-set value, and a data-derived value are not aliases." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Layer affected by the setting." ;
            sh:in (
                "collector"
                "raw_occurrence"
                "raw_record"
                "acquired_snapshot"
                "app_episode"
                "app_session"
                "screen_bout"
                "device_session"
                "device_setting_state_interval"
                "device_setting_actuation"
                "pickup_activation"
                "participant_day"
                "participant_hour"
                "participant_record"
                "participant_measure"
                "study_window"
                "analysis_record_set"
                "text_entry_trial"
                "diary_item"
                "diary_response"
                "derived_feature"
                "model"
                "notification_item"
                "notification_alert"
                "notification_attendance"
                "notification_delivery"
                "intervention_content_state"
                "call_handling"
                "outcome"
                "released_artifact"
            ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path chron:method_target_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON serialization of the complete source-declared value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:method_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Author-set, data-derived, conventional, engineering, repository-default, or unresolved origin." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:derivation_type ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Direct, inherited, or unresolved parameter transfer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:inheritance ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Primary, secondary, cited-unverified, unstated, or unresolved documentary basis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:documentary_support ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Inclusivity, clipping, ordering, or calendar convention required to interpret the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:method_boundary_convention ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source or canonical parameter name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_parameter_key ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable parameter-provenance assertion identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:parameter_provenance_id ;
        ] ;
    sh:targetClass chron:ParameterProvenanceAssertion ;
.

chron:PlatformEventOccurrence
    a sh:NodeShape ;
    rdfs:comment "The real-world Android lifecycle/system occurrence (an app resuming, the screen turning off, a shutdown). This is the thing that happened in the world — NOT the logged record and NOT an observation. Deliberately untyped as sosa:Observation." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "When the occurrence happened." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path time:inXSDDateTimeStamp ;
        ] ,
        [
            sh:description "Canonical event type." ;
            sh:in (
                "activity_resumed"
                "activity_paused"
                "continue_previous_day"
                "user_interaction"
                "notification_seen"
                "standby_bucket_changed"
                "notification_interruption"
                "slice_pinned_app"
                "screen_interactive"
                "screen_non_interactive"
                "keyguard_shown"
                "keyguard_hidden"
                "foreground_service_start"
                "rollover_foreground_service"
                "activity_stopped"
                "device_shutdown"
                "device_startup"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:event_code ;
        ] ;
    sh:targetClass chron:PlatformEventOccurrence ;
.

chron:ProtocolMaterializationBlocker
    a sh:NodeShape ;
    rdfs:comment "One source-grounded reason a typed protocol fragment is partial or withheld. The canonical setting remains authoritative; this object prevents the missing protocol field from disappearing at profile assembly." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether the partial but shape-conformant protocol object is attached to its typed slot." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:protocol_object_attached ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON of a withheld shape-invalid protocol fragment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:partial_protocol_object_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical method settings supporting or affected by this blocker." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:blocked_method_setting_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Protocol field affected by the blocker." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:protocol_blocker_field ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "StudyMethodProfile slot to which the fragment belongs." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:protocol_profile_slot ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Intended typed ontology class for the protocol fragment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:protocol_ontology_class ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the protocol fragment this blocker concerns." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:protocol_materialization_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-grounded reason the field could not be populated." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:protocol_blocker_reason ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one protocol materialization blocker." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:protocol_materialization_blocker_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable missing-field or materialization blocker code." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:protocol_blocker_code ;
        ] ;
    sh:targetClass chron:ProtocolMaterializationBlocker ;
.

chron:QueryExecution
    a sh:NodeShape ;
    rdfs:comment "Retrospective evidence for one physical query. Kept distinct from OperationExecution because a fused query can realize several semantic operations with different applicability." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Observed physical execution state." ;
            sh:in (
                "cached"
                "recomputed"
                "error"
                "skipped"
                "bypassed"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path chron:query_execution_status ;
        ] ,
        [
            sh:class chron:QueryDefinition ;
            sh:description "The QueryDefinition this execution realizes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path chron:executes_query ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:description "Evidence timestamp for the query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:startedAtTime ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content identity of the query's exact effective inputs." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:query_input_key ;
        ] ,
        [
            sh:class chron:OperationExecution ;
            sh:description "Root workflow execution containing this query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:isPartOf ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content identity of the query output." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:query_output_digest ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:description "Evidence timestamp for the query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:endedAtTime ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the evidence supporting the state." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:query_reason_id ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:QueryExecution ;
.

chron:SampledEntityMemberRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied AP appearance, cell/AP member, or application member owned by one observation. Application meaning comes from the local source definition: simultaneous running appearance, supplied app-vocabulary feature member, static installed membership, or ranked recent-task member are distinct. Its local record identity is distinct from an optional recurring entity token and independently retained CID/LAC or anonymized MAC/SSID readings. Equal tokens/values do not merge members. RSSI/frequency belong to the scan appearance, not a stable AP property or an inferred place fingerprint. Omitted/null quantities remain unknown; an empty list is explicitly empty. Membership does not recover a scan-to-place join, ranking, geographic coordinate, hash algorithm, clustering execution, visit or session context. An application token is a supplied opaque identifier, not an inferred package/name mapping. Installation origin is an optional member-owned categorical quantity, not a device/cohort mean or inferred app use. Ranked recent-task source rank/key, boot-elapsed token, component and source value remain independent member quantities. Same-package/different- activity appearances retain distinct member IDs and ordered source keys; list position does not synthesize rank." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied identity of the typed subject, including independently identified applications, categories and student courses. A course token is not a class/attendance occurrence ID; distinct observation IDs preserve those instances. Null/omission remains unknown, not an inferred app package, PID, UID equality, app/category membership or cross-observation join." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_entity_token ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied member record ID unique within its owning observation; distinct from an optional recurring AP/cell identity token." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:entity_member_id ;
        ] ,
        [
            sh:class chron:SampledQuantityRecord ;
            sh:description "Independently retained supplied quantities; [] is empty membership, omission/null unknown. No sum, counter difference, reset repair or unit conversion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:quantities ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicit member kind constrained by the local source definition; not inferred from token/value formatting." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:member_entity_kind ;
            sh:pattern "^(access_point|cell|application)$" ;
        ] ;
    sh:targetClass chron:SampledEntityMemberRecord ;
.

chron:SampledObservationReferenceRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied role-qualified relationship to another normalized observation, not a matcher or temporal selection. Next App pp4–5 distinguishes one AppOpen anchor, six independently named last-action supports and a separate before/after Gaussian-context membership. Same-owner links resolve within profile/work/participant and compatible known device. Sections5.2.1–5.2.2 separately permit explicit cross-participant input inventories and surrogate-history members; target identities retain their source participant, never an inferred identity merge. Omitted/null target leaves this role's support unknown. Equal timestamps or values do not establish linkage, latest/nearest selection or order." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied target observation identity. Nonblank positive IDs resolve unambiguously within the relation's source-authorized owner scope; null/omission is unknown." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:sampled_observation_reference ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank relationship designation, not inferred causality, chronology or a source storage code." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:relationship_label ;
            sh:pattern "\\S" ;
        ] ;
    sh:targetClass chron:SampledObservationReferenceRecord ;
.

chron:ScreenTextPhraseRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied normalized text-node member of its owning capture, with its own capture-local identity. ScreenTextSensor physical p4 Section3.2 and Figure2 distinguishes individual phrases and their top-left/bottom-right pixel coordinates. Equal phrase strings do not merge children. Bounds denote node rectangles, not glyph coordinates, visibility or a tree relation (physical p17 Section6.6). Optional partial values remain unknown; importer preserves supplied child order without asserting source chronology." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:float ;
            sh:description "Supplied top-left node-rectangle y coordinate in pixels; offscreen/overlapping/zero-size rectangles are not filtered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:phrase_top_px ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied literal phrase text; empty, null and omission are distinct, with no normalization or inferred relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:phrase_text ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Supplied bottom-right node-rectangle x coordinate in pixels, independent of the supplied top-left coordinate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:phrase_right_px ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized child identity local to its owning capture, not text equality or a recovered raw node key." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:phrase_id ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Supplied bottom-right node-rectangle y coordinate in pixels; no screen extent or text location is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:phrase_bottom_px ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Supplied top-left node-rectangle x coordinate in pixels, not glyph position or visibility; partial values remain unknown." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:phrase_left_px ;
        ] ;
    sh:targetClass chron:ScreenTextPhraseRecord ;
.

chron:ScreenshotRangeAnnotationRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied annotation of a first/last screenshot range within the owning phone-use session, not whole-session intent or a populated app-feature selection. PULSE printed p.202 Section2.2 and p.203 Figure1b/c allows labels in any order and study-specific dimensions. Positive endpoint references resolve only within that session; null/omission retains unknown endpoints. The open lexical label object preserves partial/unknown dimensions rather than enforcing the later analysis completeness filter (p.204 Section3.3). Endpoint inclusion, overlap/relabel handling and stack expansion remain unknown. No range membership, duration or missing labels are inferred. Regret2025 pp6–8 additionally uses source-bound single-image descriptions, classifier category/justification, independent human categories and consensus. Optional supplied assessor identity is not the participant. Description context has at most one known prior image; classification and human context at most four within the same app-owned container. Partial supports do not fill missing images or execute models/consensus." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied first endpoint resolving within the owning session; unknown is not the session's first screenshot." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:first_screenshot_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON object of open dimension labels to values, or JSON null. Partial, empty, omitted and supplied-null objects stay distinct; no codebook, completeness or relabel rule is imposed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:range_label_values_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional opaque supplied human/model/consensus assessor, distinct from the assessed participant and independent of other judgments; no rater identity or agreement is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:assessor_id ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional ordered supplied prior-context image IDs local to the same screenshot container. Null/omission is unknown and [] explicitly empty; no missing image, timestamp, model execution or inferred previousness is reconstructed." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:support_screenshot_references ;
            sh:pattern "\\S" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional source-qualified local screenshot-analysis definition; distinct descriptions, model judgments, human judgments and consensus are not collapsed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied last endpoint resolving within the owning session; unknown is not the session's last screenshot." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:last_screenshot_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied annotation identity local to the owning screenshot session, not inferred from equal endpoints or labels." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:range_annotation_id ;
        ] ;
    sh:targetClass chron:ScreenshotRangeAnnotationRecord ;
.

chron:SessionConstructionPolicy
    a sh:NodeShape ;
    rdfs:comment "A target-typed session constructor. App sessions, screen bouts, device sessions, pickup activations, and runs of polled samples are not aliases." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Layer asserted by the constructor." ;
            sh:in (
                "collector"
                "raw_occurrence"
                "raw_record"
                "acquired_snapshot"
                "app_episode"
                "app_session"
                "screen_bout"
                "device_session"
                "device_setting_state_interval"
                "device_setting_actuation"
                "pickup_activation"
                "participant_day"
                "participant_hour"
                "participant_record"
                "participant_measure"
                "study_window"
                "analysis_record_set"
                "text_entry_trial"
                "diary_item"
                "diary_response"
                "derived_feature"
                "model"
                "notification_item"
                "notification_alert"
                "notification_attendance"
                "notification_delivery"
                "intervention_content_state"
                "call_handling"
                "outcome"
                "released_artifact"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path chron:session_output_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable target-typed session-construction identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:session_construction_policy_id ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Source-supported settings in this profile or subprotocol." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path chron:method_settings ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:description "Layer consumed by the constructor." ;
            sh:in (
                "collector"
                "raw_occurrence"
                "raw_record"
                "acquired_snapshot"
                "app_episode"
                "app_session"
                "screen_bout"
                "device_session"
                "device_setting_state_interval"
                "device_setting_actuation"
                "pickup_activation"
                "participant_day"
                "participant_hour"
                "participant_record"
                "participant_measure"
                "study_window"
                "analysis_record_set"
                "text_entry_trial"
                "diary_item"
                "diary_response"
                "derived_feature"
                "model"
                "notification_item"
                "notification_alert"
                "notification_attendance"
                "notification_delivery"
                "intervention_content_state"
                "call_handling"
                "outcome"
                "released_artifact"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path chron:session_input_layer ;
        ] ,
        [
            sh:class chron:ReconstructionStrategy ;
            sh:description "Named reconstruction strategy used by the constructor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path chron:reconstruction_strategy ;
        ] ;
    sh:targetClass chron:SessionConstructionPolicy ;
.

chron:SessionFeatureSelectionRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied response state and optional membership of selected feature-use occurrences in the owning app session. Finesse p.8 Section3.3 asks users to select individual instances; p.3 Figure1 illustrates SUBMIT and SKIP. Submitted empty membership differs from an unanswered or expired prompt. Status labels are supplied normalized descriptions, not recovered stored codes; SKIP's deployed storage mapping remains unknown. Unknown wording, answers and membership are never manufactured from a status." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON answer, including structured/multiple selections or explicit null; not recoded or coerced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:response_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied submitted-answer membership, not provisional clicks: distinct occurrence IDs resolving only within the owning session. [] is explicit empty selection; null/omission is unknown. Unanswered/expired states do not assert submitted membership; SKIP's stored mapping is unknown. Selection of one same-label occurrence does not label every such occurrence." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:selected_feature_occurrence_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied questionnaire item label; not an invented raw schema key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank open response-state label, not a source-code enum, timer execution or inferred negative response." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:selection_response_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized response identity local to the owning app session, not a notification history." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:questionnaire_response_id ;
        ] ;
    sh:targetClass chron:SessionFeatureSelectionRecord ;
.

chron:SessionInterruptionRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied interruption identity local to its containing app session, independent of label or equal time tokens. Why Did you Stop physical p.4 Figure1 prints APP_SWITCH and a visited-app label list containing repeated Google. These labels are not package IDs, classified causes, complete app histories or independently timed visits. Preserve supplied order and optional/null/empty descriptors; no sorting, deduplication, containment arithmetic, resumption or terminating/suspending outcome is inferred." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied notification-item associations supporting this interruption, scoped to the same profile/source/participant and compatible known device. Unknown devices must not create ambiguous joins. No nearest-time selection, prior-notification matching or causal attribution is inferred." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:notification_history_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied ordered visited-app label list; duplicates, empty strings and unknown/empty membership retained without converting labels to packages or inferring complete timed transitions." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:visited_app_labels ;
        ] ,
        [
            sh:class chron:DeviceSessionLabelRecord ;
            sh:description "Independently supplied automatic labels, final ESQ-confirmed labels, or suspending/terminating outcomes local to one interruption, distinguished by observed property and source definition. Kept separate from event type and subjective ESQ responses; no classifier, rule or causal join is executed. Omission/null is unknown and [] explicitly empty supplied labels." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:interruption_classifications ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional open supplied event-type descriptor, such as the illustrated APP_SWITCH; not automatically an internal/device/external cause or suspending/terminating outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:interruption_type ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied interruption identity unique within its containing session, independent of label or equal bounds." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:interruption_record_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:SessionInterruptionRecord ;
.

chron:SessionScreenshotRecord
    a sh:NodeShape ;
    rdfs:comment "One supplied screenshot identity local to its owning source-defined screenshot container (PULSE phone use or Regret foreground-app use). Optional supplied sequence position, capture-time token and existing ArtifactRef identity remain independent; equal times or shared payloads do not collapse captures. PULSE printed pp.202-203 Section2.2 describes chronological display and visual stacking, not underlying row deletion. Missing payload metadata does not require fabricated size/digest/hierarchy. No image bytes, raw serialization or complete capture stream is verified." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:integer ;
            sh:description "Optional supplied nonnegative sequence position, unique within session; sparse positions do not reveal index base or equal-time sorting." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:screenshot_sequence_position ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied screenshot capture-time token; no encoding, timezone or duration is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:screenshot_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of this event's screenshot in the supplied existing ArtifactRef catalog." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:screenshot_artifact_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied screenshot identity local to its owning session, independent of capture time or image equality." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:screenshot_record_id ;
        ] ;
    sh:targetClass chron:SessionScreenshotRecord ;
.

chron:SessionTransactionRecord
    a sh:NodeShape ;
    rdfs:comment "A supplied transaction for a separately identified phone-use session in its containing database. Habitual physical p12 section3.2.3 and p14 Figure5 distinguish binary app/context presence, explicit absence and undisclosed columns. This is not the preceding duration-weighted TF-IDF Bag-of-Apps representation. Unknown bounds/membership stay unknown; no missing item becomes zero. The illustrated Session i is not linked to U34 or Table5's clusters by the source." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied absent app items, distinct from omitted, unknown or unobserved items." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:absent_app_items ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicitly supplied present app item labels/identities, not necessarily package IDs. Unlisted items are not inferred absent; supplied order is not usage order." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:present_app_items ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied transaction identity unique within its database, not inferred from equal times or app sets." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:session_transaction_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied normalized identity of the session represented by this transaction, unique within the database; not authentication of an original raw key or recovered session constructor." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:source_session_id ;
        ] ,
        [
            sh:class chron:AssociationContextItemRecord ;
            sh:description "Explicitly supplied absent contextual items; undisclosed columns never become absent values." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path chron:absent_context_items ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:denotes_interval ;
        ] ,
        [
            sh:class chron:AssociationContextItemRecord ;
            sh:description "Explicitly supplied present contextual items, independent of app itemsets and with no context join inferred." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path chron:present_context_items ;
        ] ;
    sh:targetClass chron:SessionTransactionRecord ;
.

chron:SourceArtifactProvenanceAssertion
    a sh:NodeShape ;
    rdfs:comment "Exact, content-bound documentary provenance registered for a source artifact. Registration verifies identity and bytes. `documentary_only` maps to `executionEligible=false` at the browser and Rust receipt boundaries." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Closed documentary-only eligibility; the referenced artifact is never executed." ;
            sh:in (
                "documentary_only"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path chron:execution_eligibility ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content digest of the passing conformance result for this exact setting and executor value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:conformance_result_digest ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "JCS SHA-256 digest of the exact registered provenance object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_artifact_provenance_object_digest ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact key set of the registered provenance object." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:provenance_keys ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 identity of the complete preserved source value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_value_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of a source-artifact provenance assertion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:source_artifact_provenance_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one source-supported setting assertion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:method_setting_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Closed-registry adjudication status." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:candidate_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the source or source-derived fixture proving this exact executor binding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:conformance_fixture_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON serialization of the exact registered provenance object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_artifact_provenance_object_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Evidence-row identity from which this atomic setting was derived." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:source_extraction_id ;
        ] ;
    sh:targetClass chron:SourceArtifactProvenanceAssertion ;
.

chron:TaskCriterionAssessmentRecord
    a sh:NodeShape ;
    rdfs:comment "Independently supplied assessment of a designated criterion for the owning task. S-ADL physical p23 Table6 has separate registration-number and spoken information criteria. Supplied content evidence, result and supporting task actions remain distinct. A definition reference does not recover the actual stimulus or demonstrate automated correctness. No scoring runs at import. Password Entry Usability (2012) pp4–6 also supplies performance criteria: first-to-last-character entry time in milliseconds, guess-to-target Levenshtein distance and participant/password-local best-attempt selection. A supplied value and supporting action identities do not execute those calculations or make the later Send action an entry-time endpoint. Murnane2016 p4 supplies participant-baseline-relative PVT performance; its record does not recover trial granularity or a percentage convention. Source-defined questionnaire summaries, including affect means and PHQ-9 scores/classifications, are assessments rather than individual answers. Supplied summaries remain independent of item values; no scoring, classification or missing-item policy is inferred during import." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON content supporting the assessment, distinct from its result or action/time evidence; omitted content may be withheld or unreported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:assessment_content_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied designation of the criterion/subtask being assessed, not an inferred selection or result." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:criterion_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied TaskActionRecord IDs resolving only within the containing task or session, as selected by the owning class. Null/omission is unknown support, [] explicitly empty. No matching, score calculation, temporal anchoring or cross-owner join runs." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied supporting assessment IDs within the containing task, distinct from action IDs. Brain Disorders medRxiv2020 beginning/end PHQ-9 change names its two score assessments without inferring subtraction direction. Null/omission is unknown support, [] explicitly empty; duplicate, self and foreign references reject. These are supplied relationships, not an executed derivation DAG or array-order calculation." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:support_criterion_assessment_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON assessment result. Does not compute correctness; zero, JSON null, supplied null and omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:assessment_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied assessment identity unique within the task, independent of repeated criterion labels." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:criterion_assessment_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Reference to a compatible task-correctness, task-performance or questionnaire-summary definition within the owning profile/source; criterion designation remains separate from this potentially composite definition. Referencing a metric does not execute it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:criterion_setting_reference ;
        ] ;
    sh:targetClass chron:TaskCriterionAssessmentRecord ;
.

chron:TaskObservationWindowRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied observation/summary window anchored to an explicitly identified action in its containing task or questionnaire completion. Personality states (2020) printed697 ends its preceding30-minute window at the first photographic-affect-meter response, not later personality submission. Sarsenbayeva (2020) p5 compares ESM valence against1/5/60-minute Affectiva windows; only the1-minute case explicitly says preceding. Local source definitions preserve that distinction; unspecified sidedness and endpoints are never inferred. Supplied answer links designate comparisons, not the anchor event or equality of their timestamps. Quantities are supplied, not computed; valence does not inherit raw emotion-confidence scale bounds. Local references preserve normalization but do not authenticate firstness, reconstruct time, match raw rows or establish observation completeness. Murnane2016 p7 preserves a one-hour window surrounding a PVT assessment and independent mean-session-seconds, distinct-app and switch summaries; surrounding does not specify centered offsets or a phone-session closer." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied local action anchor. STDD's preceding-EMA alignment does not disclose receipt/open/submission semantics and alone permits an omitted/null anchor. Established action-anchored policies retain their required local action in source validation; no action is fabricated to satisfy the structure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:anchor_task_action_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Nonempty unique references to compatible window/span/anchor definitions within the owning profile and source. Ambiguous sidedness remains on its source definition, not inherited from another window." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:window_setting_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied ordered Screen Text Sensor capture IDs, resolved within the same profile/source/participant and compatible known device. Null/omission is unknown membership, [] explicitly empty. The five-minute policy is anchored to questionnaire receipt, not response; no timestamp matching, sorting or text-equality deduplication is performed." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:screen_text_capture_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied compared/supporting answer IDs resolving only within the containing task completion. Null/omission is unknown support, [] explicitly empty; the anchor event remains separately identified." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:questionnaire_response_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied window identity unique within its containing task, not inferred from duration or equal endpoints." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:observation_window_id ;
        ] ,
        [
            sh:class chron:SampledQuantityRecord ;
            sh:description "Independently retained supplied quantities; [] is empty membership, omission/null unknown. No sum, counter difference, reset repair or unit conversion." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path chron:quantities ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:TaskObservationWindowRecord ;
.

chron:TaskQuestionnaireResponseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied subjective response concerning its owning task/session or a separately identified questionnaire completion, independently referencing the owning profile's disclosed categorical answers, response scale or instrument definition. Oh App (2013) physical p2 Procedure and p3 Self-Assessment distinguish completing the post-study instrument from logged navigation and from issuing its invitation. This is not task correctness, a navigation-trial link or a reconstructed questionnaire row. Property designation is not exact question wording; endpoints do not supply the complete offered labels, numeric codes or missing-response policy. ACII2019 explicit No Response is a supplied skip, not absent membership or a fifth modeled emotion. Alt2012 physical p3 specifies SUS per condition without administered items/endpoints; Böhmer2014 p5 specifies post-condition dimensions and a 20-point scale without anchors. These omissions do not justify invented instrument details. Import preserves lexical answers without scoring or recoding." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
        chron:interruption_record_reference
        chron:response_role_label
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON answer, including structured/multiple selections or explicit null; not recoded or coerced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:response_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional explicitly supplied owner-local actions: Chang retrospective event supports or DynamicSecurity answer-local evidence/confidence supports, resolving only within the containing TaskOccurrence. The preceding24h end-of-day event selection horizon remains a method definition; these links do not turn an event into a24h window or infer prompt time/selection. Shared answer supports do not compute confidence or recover missing case identities. Null/omission is unknown, [] explicitly empty; unrelated response carriers reject this field unless their own ingress validates it." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied subjective measure designation, not necessarily exact question wording." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied answer identity unique within the owning task; repeated labels or values do not merge answers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:questionnaire_response_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied questionnaire item label; not an invented raw schema key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Reference to a compatible disclosed response-scale definition within the owning profile/source, not an invitation or reported result; unknown instrument details remain on that source definition." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:questionnaire_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied case identity scoped to profile/source, independent of rater, text label, description or response. Meaningful primary339–354 has authored app-use cases followed by independent ratings of shared cases. DynamicSecurity layout874–896 supplies shared question/options identities across legitimate/adversarial responders, without requiring literal role-varying wording equality. This token preserves a supplied relationship across completions without recovering original IDs or declaring a case catalog. Null/omission is unknown identity; equal labels do not imply equal cases." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:assessment_case_token ;
            sh:pattern "\\S" ;
        ] ;
    sh:targetClass chron:TaskQuestionnaireResponseRecord ;
.

chron:TextChangeCaseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied text-change case local to an action-membership typing trial. Akpinar et al. DOI10.1145/3577013 pp18–19 §4.4.1–4.4.2 provides overall, removed and reentered text for independent system-verdict and participant follow-up comparison. Withheld text remains null/omitted. Equal content does not merge case IDs. Optional action supports resolve within the trial, not an inferred segmentation, exhaustive membership or disjoint partition. Array order is preserved but does not establish case or revision chronology." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied action supports resolving uniquely within the owning trial's membership; [] means explicit empty support, null/omission unknown. No boundary extraction or disjointness inferred." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:support_keyboard_transaction_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied removed text segment, not inferred by comparing action states; empty/null/omission preserved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:removed_text ;
        ] ,
        [
            sh:class chron:TextChangeVerdictRecord ;
            sh:description "Independent supplied case-local verdicts with their own definition/version references; no classifier, revision ordering or participant-agreement calculation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path chron:system_verdicts ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied case identity unique within its typing trial, independent of equal text." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:text_change_case_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied case-context text, optionally withheld; not reconstructed from keyboard actions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:overall_text ;
        ] ,
        [
            sh:class chron:TypingQuestionnaireResponseRecord ;
            sh:description "Supplied case-local participant feedback distinct from system verdicts and trial ESM; lexical F/T is not boolean correctness." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path chron:followup_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied reentered text segment, independently preserved without normalization or correction classification." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:reentered_text ;
        ] ;
    sh:targetClass chron:TextChangeCaseRecord ;
.

chron:TextChangeVerdictRecord
    a sh:NodeShape ;
    rdfs:comment "Independently supplied text-change verdict, referencing a profile-local classification definition. Akpinar et al. pp18–20 §4.4 distinguishes initial and revised verdicts; printed Algorithm2's version placement remains unresolved. No verdict is computed from supplied feedback or assigned to a version by array position. Supporting answer IDs, when supplied, resolve only within this case's follow-up answers, not ESM or another case." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied supporting answer IDs local to the case's follow-up responses; no causal or temporal inference." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:questionnaire_response_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied verdict identity unique within the containing text-change case, not a device session." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:label_record_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Compatible classification-defining local method setting, not a constructor, result statistic or execution receipt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:label_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON classification value; no scoring, coercion or missing-to-negative conversion. Omission, supplied null and lexical JSON null remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:label_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ;
    sh:targetClass chron:TextChangeVerdictRecord ;
.

chron:TimestampPolicy
    a sh:NodeShape ;
    rdfs:comment "Timestamp fidelity, ordering, multiplicity, and synthetic-order provenance. Original and effective time remain separate." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Preserved acquisition or source-row order." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:source_sequence_semantics ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity and disposition for repeated acquired observations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:acquisition_deduplication ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable timestamp-policy identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:timestamp_policy_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Provenance for a timestamp or order introduced by processing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:synthetic_order_provenance ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source or effective timestamp resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:timestamp_resolution ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Identity of observations sharing an effective timestamp." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:tie_group_semantics ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Ordering or multiplicity policy within a tie group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:tie_break_policy ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Timestamp used by later operations after correction or normalization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:effective_timestamp_semantics ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Preserved source timestamp meaning and representation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:original_timestamp_semantics ;
        ] ;
    sh:targetClass chron:TimestampPolicy ;
.

chron:TokenEvaluationCaseRecord
    a sh:NodeShape ;
    rdfs:comment "Supplied word-evaluation case local to an action-membership typing trial, distinct from removed/reentered text. Akpinar et al. DOI10.1145/3577013 pp18–19 Section4.4.1–4.4.2 presents selected words with overall text and independently retained system judgments and participant F/T feedback. F means participant-reported typo, not correction or system disagreement. Withheld text remains unknown. Equal words do not merge case identities; supplied ownership does not recover original word/action/trial joins." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied selected word text, optionally withheld; not reconstructed from keyboard actions or removed/reentered segments." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:token_text ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied case-context text, optionally withheld; not reconstructed from keyboard actions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:overall_text ;
        ] ,
        [
            sh:class chron:TypingQuestionnaireResponseRecord ;
            sh:description "Supplied case-local participant feedback distinct from system verdicts and trial ESM; lexical F/T is not boolean correctness." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path chron:followup_responses ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied word-evaluation identity unique within its containing trial, independent of equal token text." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:token_evaluation_case_id ;
        ] ,
        [
            sh:class chron:TokenEvaluationVerdictRecord ;
            sh:description "Independent supplied case-local verdicts with their own definition/version references; no classifier, revision ordering or participant-agreement calculation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:system_verdicts ;
        ] ;
    sh:targetClass chron:TokenEvaluationCaseRecord ;
.

chron:TokenEvaluationVerdictRecord
    a sh:NodeShape ;
    rdfs:comment "Independently supplied word-correctness judgment referencing a profile-local token classification definition, not an edit/correction definition. Akpinar et al. pp18–19 Section4.4 keeps judgments separate from first-task F/T answers. Optional supporting answers resolve only within this token case. No classifier, version assignment, chronology or agreement recoding." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied answer IDs local to this token case, not a text-change case or trial questionnaire." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:questionnaire_response_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Compatible classification-defining local method setting, not a constructor, result statistic or execution receipt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:label_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON classification value; no scoring, coercion or missing-to-negative conversion. Omission, supplied null and lexical JSON null remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:label_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied verdict identity unique within its containing token-evaluation case." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:label_record_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ;
    sh:targetClass chron:TokenEvaluationVerdictRecord ;
.

chron:UsageEpisodeAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim that one app was in continuous use over an interval. A derived prov:Entity (what the pipeline asserts, not a ground truth)." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:AttributionAssertion ;
            sh:description "Person attribution for this episode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path chron:attribution ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:UsageEpisodeAssertion ;
.

chron:UsageEventRecord
    a sh:NodeShape ;
    rdfs:comment "The logged information artifact for one Android usage event. A prov:Entity, not an observation." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android activity class name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:app_class_name ;
        ] ,
        [
            sh:description "Canonical event type." ;
            sh:in (
                "activity_resumed"
                "activity_paused"
                "continue_previous_day"
                "user_interaction"
                "notification_seen"
                "standby_bucket_changed"
                "notification_interruption"
                "slice_pinned_app"
                "screen_interactive"
                "screen_non_interactive"
                "keyguard_shown"
                "keyguard_hidden"
                "foreground_service_start"
                "rollover_foreground_service"
                "activity_stopped"
                "device_shutdown"
                "device_startup"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:event_code ;
        ] ,
        [
            sh:class chron:PlatformEventOccurrence ;
            sh:description "The real-world occurrence this record logs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path chron:records_occurrence ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Original recording timezone (preserved)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:timezone ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Event timestamp in nanoseconds since epoch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:event_timestamp_ns ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:app_package_name ;
        ] ;
    sh:targetClass chron:UsageEventRecord ;
.

chron:AttributionAssertion
    a sh:NodeShape ;
    rdfs:comment "Attribution of usage to a person. Exactly one status is required; an actual person is attached only when known. The participant-device-day denominator must satisfy duration conservation: target + known_non_target + unresolved = eligible." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether the device is shared." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:on_shared_device ;
        ] ,
        [
            sh:description "Required attribution status." ;
            sh:in (
                "target"
                "known_non_target"
                "unresolved"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path chron:attribution_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The actual person, attached only when known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:attributed_person ;
        ] ;
    sh:targetClass chron:AttributionAssertion ;
.

chron:NotificationEvidenceRecord
    a sh:NodeShape ;
    rdfs:comment "One owner-local event, classification or inferred quantity with independent provenance and optional local supporting evidence. Arrival, removal, unlock-derived assumed-seen, already-unlocked zero seen latency and clicked status are not interchangeable (My Phone and Me pp.3-4). Removal alone is not swipe, rejected content or accepted outcome; clicked may include app launch. Missing time/basis/value means not supplied, not a negative event. An instant is a supplied representation, not a verified epoch/precision. Context evidence requires a property label and independent collection boundary at normalized ingress. My Phone and Me p.4 Table1 records arrival/removal context; Content-driven notifications p.3 Table1 has unknown sampling alignment and separately described last-minute features. Null/omitted value and optional lookback/unit/time remain unknown; no context reducer, alert/ringer equivalence or sensor/location join runs. Optional shared-opening reference supports an inferred seen/latency only with positively supplied owner-local pending membership; it does not replace item-local supporting references or compute the view. Response stages carry independent observability and open stage identifiers: Reachable pp.3-4 allows variable/merged decisions, not a fixed D1-D3 enum. Unobservable is neither a negative response nor a prohibition on supplied inferred annotations. Endpoint and named objective labels are independent; string-valued null endpoint is not an unknown JSON null or omitted value. Import does not infer stages, labels, chronological order or truth tables. Item-owned action occurrences retain open source-qualified labels and an optional supplied ordinal, distinct from array position, event time and supporting references. Interrupted by a Phone Call pp.3,7–8 distinguishes repeated postpones, widget moves and accepted/declined/unanswered endings. Non-null ordinals are unique among actions in one history at ingress; neither zero-based indexing, contiguity nor complete capture is asserted. No action sorting, time conversion, raw-key recovery or outcome recode runs. The callback-group carrier reuses only the recorded posted_callback variant and its lexical time/value/basis/supports; it does not assign item ownership or action, context, response, opening or attention semantics to a callback. Named quantities retain independent lexical values, units and local supporting events. In Call to Action pp.7–8, IDL is an appearance-to-removal difference, not seen latency or observed attention; neither endpoint arithmetic nor positive/one-day analysis filtering runs during import." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Collection boundary for context evidence or explicit source-unreported status; required by normalized context ingress, never inferred from lookback, timestamp or reference. My Phone and Me p.4 Table1 versus Content-driven notifications p.3 Table1." ;
            sh:in (
                "arrival"
                "removal"
                "interruption"
                "posting"
                "source_unreported"
            ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path chron:context_sampling_boundary ;
        ] ,
        [
            sh:description "Supplied evidence quantity or classification kind." ;
            sh:in (
                "arrival"
                "removal"
                "phone_unlock"
                "corresponding_app_launch"
                "notification_bar_click"
                "swipe_dismiss"
                "assumed_seen"
                "seen_latency"
                "clicked"
                "dismissed"
                "context"
                "category"
                "response_stage"
                "response_endpoint"
                "response_objective_label"
                "quantity"
                "action_occurrence"
                "posted_callback"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path chron:evidence_kind ;
        ] ,
        [
            sh:description "Recorded record/classification versus explicitly inferred assertion; not an observed-action guarantee." ;
            sh:in (
                "recorded"
                "inferred"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path chron:evidence_role ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Optional supplied nonnegative integer ordering token on action_occurrence evidence only; unique among actions in the owning history at ingress. Null/omission is unknown, not array position or time. No assumed ordinal base, contiguous sequence, complete capture or sorting." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path chron:occurrence_ordinal ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional shared opening ID supporting inferred seen/latency in the owning history. A positive reference requires that history in supplied opening membership and a known common device; null/omission does not assert a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:opening_occurrence_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Lexical JSON token for a supplied evidence value; literal false/zero/null/string-false tokens and a supplied-unknown null field remain distinct without casts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:evidence_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank stage label required for normalized response_stage evidence. Variable/merged stages are permitted; not a recovered source field, ordinal or inferred chronology (Reachable pp.3-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:response_stage_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied supporting evidence IDs resolved only within the owning history or callback group; optional null means unknown support and no cross-owner matching or constructor execution occurs." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:evidence_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied nonblank action label required only for action_occurrence evidence. Repeated labels identify separate occurrences, not a recovered raw enum, response stage or call-ending classification (Interrupted by a Phone Call pp.3,7–8)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:action_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:description "Supplied observation availability required for normalized response_stage evidence, independent of response value, device-use context and recorded/inferred provenance (Reachable p.4 Section3.2.1)." ;
            sh:in (
                "observable"
                "unobservable"
            ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path chron:response_observability ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied retrospective context-feature scope independent of collection boundary; last one minute in Content-driven notifications p.3 Table1 does not disclose a reducer or timestamp anchor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:lookback ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied inference or recording basis; omission/null leaves the basis unknown rather than reconstructed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:evidence_basis ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied textual time token for this evidence alone; no endpoint equality or conversion is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:evidence_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied unit for this quantity alone; no numeric conversion or inferred unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:evidence_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied context property, item-owned quantity name or independent response-objective name; required for those evidence kinds at ingress, not a computed value or recovered raw key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Normalized evidence identity local to its owning item history or supplied callback group; duplicated world-occurrence evidence across histories does not assert distinct unlocks. Equal callback times/payloads do not imply equal identities." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:evidence_record_id ;
        ] ;
    sh:targetClass chron:NotificationEvidenceRecord ;
.

chron:ReconstructionStrategy
    a sh:NodeShape ;
    rdfs:comment "A named, versioned episode-reconstruction algorithm (semantic category + canonical IRI). Subclass only where formal restrictions genuinely differ." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Canonical strategy category (IRI-bearing enum value)." ;
            sh:in (
                "parry_toth_forward_pairing"
                "fused_matcher"
                "eyes_complement"
                "gesis_start_stop_repair"
                "foreground_background_pairing"
                "draxler_interruption_aware"
                "morrison_lock_tolerant"
                "schoedel_2026_app_within_screen_prose_v1"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:strategy_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Strategy version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:strategy_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Strategy identifier (unique key)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:strategy_id ;
        ] ,
        [
            sh:datatype xsd:anyURI ;
            sh:description "Canonical IRI carried by the runtime enum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:canonical_iri ;
        ] ;
    sh:targetClass chron:ReconstructionStrategy ;
.

chron:DeviceSessionLabelRecord
    a sh:NodeShape ;
    rdfs:comment "Independently supplied classification local to a device-use session or tracked-app interruption, referencing its applicable profile-owned label definition. Rabbit Hole physical p11 original intention-deviation and regret classifications are not the revised RH/negative-RH definitions at pp21-22 Figure14/Section6. Supplied lexical labels and local answer supports remain separate; missing is not negative. Import does not apply formulas, recover thresholds or fabricate an absent-answer truth table or original-to-revised mapping. Jones physicalp8/Table3 separately supplies whole-session strategy classes bound to the profile's analysis/derived-feature pattern definitions. Those labels are not action-local F/B roles; no regex execution is implied. APNOMS2011 also supplies network-modality and charging-power-source labels; those interval descriptors are not questionnaire-derived classifications." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied action/foreground-period IDs resolving only within the containing session. Repeated visits to the same app remain distinct by local action ID; null/omission is unknown support, [] explicitly empty. No EEG join, app matching, classifier or weighted vote runs." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied supporting answer IDs resolving only within the containing device-use session; null/omission is unknown support, [] explicitly empty." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:questionnaire_response_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied label identity unique within its owning session, independent of equal property or value tokens." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:label_record_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied designation of the independent session classification or source-defined app-period classification; whole-session and app-period scopes are not interchangeable." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Compatible classification-defining local method setting, not a constructor, result statistic or execution receipt." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:label_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied lexical JSON classification value; no scoring, coercion or missing-to-negative conversion. Omission, supplied null and lexical JSON null remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:label_value_json ;
        ] ;
    sh:targetClass chron:DeviceSessionLabelRecord ;
.

chron:OperationExecution
    a sh:NodeShape ;
    rdfs:comment "A retrospective execution of an OperationDefinition. A prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Stable workflow-execution identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:execution_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Execution end." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:ended_at ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Execution start." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:started_at ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "The OperationDefinition this execution realizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path chron:executes_operation ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:OperationExecution ;
.

chron:QueryDefinition
    a sh:NodeShape ;
    rdfs:comment "One physical computation and memoization boundary. Its realizes_operations links are prospective mappings and do not imply that those semantic operations were applied in a particular run." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Independently identified output artifacts or ports." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:query_outputs ;
        ] ,
        [
            sh:class chron:QueryDefinition ;
            sh:description "Direct upstream physical queries." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path chron:query_dependencies ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable physical-query identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:query_id ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Semantic operations this query may realize." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path chron:realizes_operations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact request fields read by the query." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:query_request_fields ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Presentation-only query-group identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:query_group_id ;
        ] ;
    sh:targetClass chron:QueryDefinition ;
.

chron:ReconstructionExecution
    a sh:NodeShape ;
    rdfs:comment "The execution that produced a usage assertion. A prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:ReconstructionStrategy ;
            sh:description "The reconstruction strategy followed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path chron:follows_strategy ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:ReconstructionExecution ;
.

chron:SampledQuantityRecord
    a sh:NodeShape ;
    rdfs:comment "One independently supplied quantity owned by its observation or window. Window summary values do not inherit raw-emotion confidence bounds. Traffic byte directions occur at most once per observation and require bytes. Hush frequency-residency members may have distinct opaque frequency qualifiers; unknown qualifiers never merge members or require inference. CPU/residency/signal units are undisclosed and remain omitted/null; UID network bytes and battery percent remain distinct. Emotion confidence has no inferred physical unit and its components need not sum to 100. Lexical JSON retains zero, quoted numeric text and JSON null separately from an omitted or null field. The source's raw serializer and counter reset/interval interpretation remain unknown; values are not converted." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
        chron:app_identifier
        chron:end_action_reference
        chron:observation_category
        chron:quantity_record_id
        chron:quantity_scope
        chron:quantity_setting_reference
        chron:questionnaire_response_references
        chron:source_locators
        chron:start_action_reference
        chron:support_task_action_references
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Lexical JSON token for a supplied evidence value; literal false/zero/null/string-false tokens and a supplied-unknown null field remain distinct without casts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:evidence_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied unit for this quantity alone; no numeric conversion or inferred unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:evidence_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied source-defined quantity variant: a core-residency frequency designation (Hush Section3.1), a session feature's absolute/frequency/normalization/state designation (Rabbit Hole Section4.1), or an explicitly named activity/component/connectivity/radio stratum for an Energy Drain2015 summary. No frequency, unit, weighting, group boundary or formula is inferred. Omission/null is unknown and does not merge members." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:quantity_qualifier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:observed_property ;
        ] ;
    sh:targetClass chron:SampledQuantityRecord ;
.

chron:SessionQuantityRecord
    a sh:NodeShape ;
    rdfs:comment "Independently identified supplied quantity local to one device-use or tracked-app session, linked to its source feature or record-field definition. Jones physicalpp6,8 distinguishes session-string length and B/length from physical duration and strategy. Rabbit Hole physicalp11 Section4.1 distinguishes per-app and per-category counts/time/interactions from session-wide features. Explicit scope survives unknown app/category identity; missing identity is not a session total. Qualifiers preserve absolute counts, time-relative frequencies, supplied state and normalization variants. Figure7 seconds/session/minute and Figure11 normalized-by-session-length do not establish a universal fraction, percentage, formula or missing-unit conversion. No aggregation, app join, timestamp inference, normalization or repair runs during import. APNOMS2011 Figure7 supplies separate start/end battery levels in percent for charging or battery-change intervals, not computed energy consumption. Meaningful (3191754) released Event.java103-117 separately preserves four millisecond duration fields, including lexical NA; sample duration is not silently added to duration_total. WhyStop net length excludes suspending interruption time but supplies no overlap/union algorithm. Values remain independent rather than being derived from containing intervals. Chang printedpp9,12 additionally preserves each ringer-occupancy-local attending-action gap with independently supplied ordered endpoints, its ordinal attendance category and its separate supplied mean. No arithmetic, within-boundary selection, chronology or completeness is asserted." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied category scope, independent of property/value; not a reconstructed app classifier. Null/omission remain distinct." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:observation_category ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Lexical JSON token for a supplied evidence value; literal false/zero/null/string-false tokens and a supplied-unknown null field remain distinct without casts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path chron:evidence_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied answer IDs resolving only within the containing session. Hiniker2016 Table4 retains each response-specific context row independently of unresolved displayed/collected/submitted timing; this relation is not a clock anchor. Null/omission is unknown support, [] explicitly empty." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:questionnaire_response_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Profile-local feature or record-field definition with compatible role, target, property, unit and scope; not a request to compute the value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:quantity_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied unit for this quantity alone; no numeric conversion or inferred unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path chron:evidence_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied action/foreground-period IDs resolving only within the containing session, not app identity or a derived join. A→B→A retains separate visits; supports do not execute raw-to-period construction, clipping or feature calculation." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:support_task_action_references ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied source-defined quantity variant: a core-residency frequency designation (Hush Section3.1), a session feature's absolute/frequency/normalization/state designation (Rabbit Hole Section4.1), or an explicitly named activity/component/connectivity/radio stratum for an Energy Drain2015 summary. No frequency, unit, weighting, group boundary or formula is inferred. Omission/null is unknown and does not merge members." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:quantity_qualifier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Explicit session/app/app-category subject scope, independent of whether the app/category identity is known." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:quantity_scope ;
            sh:pattern "^(session|app|app_category)$" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied start action ID for a Chang attending-action gap, resolving only inside its containing ringer occupancy. Null/omission is unknown; array order and timestamps never infer the reference." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:start_action_reference ;
            sh:pattern "^.*\\S.*$" ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied app identity, including pseudonymous labels; not necessarily an Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:app_identifier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied quantity identity unique within its owning session; repeated equal properties/values remain independent." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:quantity_record_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied end action ID for the same gap, resolving locally and distinct from a known start. Not an aggregation support or mean endpoint; no duration calculation or cross-boundary matching." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:end_action_reference ;
            sh:pattern "^.*\\S.*$" ;
        ] ;
    sh:targetClass chron:SessionQuantityRecord ;
.

chron:TypingQuestionnaireResponseRecord
    a sh:NodeShape ;
    rdfs:comment "Individually identified supplied answer owned either by a token or text-change case's follow-up or separately by its typing trial's questionnaire association. Akpinar et al. pp18–19 §4.4.1 uses F for participant-reported error correction and T otherwise in the change task; the distinct word task uses F for a participant-reported typo and T otherwise. Neither means system agreement. ESM context and subjective-error instruments on pp7–8/32–33 are separate. Each answer references its own local definition. Null/omission/lexical JSON null and repeated values remain distinct; no raw join, scoring or recoding." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Supplied lexical JSON answer, including structured/multiple selections or explicit null; not recoded or coerced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:response_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Local compatible task-specific word/change follow-up or questionnaire instrument definition, not a prompt cadence or reported statistic." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:questionnaire_setting_reference ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied questionnaire item label; not an invented raw schema key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:questionnaire_item_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied answer identity unique within its containing case or trial; equal IDs in separate owners do not merge." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:questionnaire_response_id ;
        ] ;
    sh:targetClass chron:TypingQuestionnaireResponseRecord ;
.

chron:AssociationContextItemRecord
    a sh:NodeShape ;
    rdfs:comment "Context item value with an optional supplied dimension. Habitual physical p14 Figure5 distinguishes notification, period, time, location and activity from app labels. Missing dimension is not inferred from a label; equal labels in different dimensions remain distinct. Array order is preserved as supplied, never interpreted as chronology." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied context dimension, such as time, location or activity; no dimension or mutually-exclusive value policy is inferred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:context_dimension ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied context value label, preserved without coercion, case folding or inferred sensor encoding." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:context_item_label ;
        ] ;
    sh:targetClass chron:AssociationContextItemRecord ;
.

chron:ParameterSet
    a sh:NodeShape ;
    rdfs:comment "A content-addressed configuration entity — a set of ParameterBindings over the plan's variables. NOT a Plan: the plan is the workflow; this binds its variables." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Content-addressed hash of the canonical parameter set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:parameter_set_sha256 ;
        ] ,
        [
            sh:class chron:ParameterBinding ;
            sh:description "Knob=value bindings." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:bindings ;
        ] ;
    sh:targetClass chron:ParameterSet ;
.

chron:TaskActionRecord
    a sh:NodeShape ;
    rdfs:comment "Individually supplied member of its containing task or device-use session with optional action label, app identity, time, role labels and lexical content. S-ADL physical p25 Table11 distinguishes observed app/screen actions from extracted subtask roles. Missing/extra/tied-event handling and the automatic constructor are not inferred. Same labels or times do not merge members or create order. Supplied array order remains intact. Oulasvirta pp106–107 distinguishes all-user-action session membership from app-launch order; app identity is independently supplied, never extracted from labels. Hush Section6.1 distinguishes active-in-off from foreground-in-following-on membership." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Optional lexical JSON content evidence attached to a task/session action. Null, JSON null and omission stay distinct; no comparison or scoring runs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:action_content_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional open supplied action descriptor, not a required recovered event code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:action_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Opaque supplied app identity, including pseudonymous labels; not necessarily an Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:app_identifier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Optional supplied role labels relative to the containing task/session, retained in order without automatic assignment, matching, deduplication or expected-script completion." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:assigned_role_labels ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Supplied action identity unique within the containing task or session; labels or equal times are not identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:task_action_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:TaskActionRecord ;
.

chron:OperationDefinition
    a sh:NodeShape ;
    rdfs:comment "One semantic operation in the workflow at any useful scale. Operations compose recursively via part_of_operation so a coarse responsibility and its independently invalidatable transformations share one model without forcing presentation and execution boundaries to coincide." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether a failure fails the whole workflow." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:is_fatal ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Upstream operations defining enclosing partitions for a group-to-subset rule; may be transitive rather than direct dependencies. Does not establish exact group construction, ordering, ties, row lineage or execution. Source assertions remain linked through configuration_dependencies." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path chron:group_scope_operation_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Operations that must precede this one." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:depends_on ;
        ] ,
        [
            sh:description "Direction and source-declared association of payloads within one interaction event; no undisclosed temporal predicate is implied." ;
            sh:in (
                "gesture_to_most_recent_paired_snapshot"
            ) ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path chron:event_payload_association ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Channels or inputs the operation reads." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:consumes ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Named algorithm or engine the operation realizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:engine ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether gesture presence alone establishes correctness. False means presence is insufficient evidence, not that every gesture is wrong. Completeness and correctness remain independent; no particular instance is assessed here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path chron:gesture_presence_implies_correctness ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Whether the operation observes, infers, applies policy, or presents." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:epistemic_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable semantic operation identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:operation_id ;
        ] ,
        [
            sh:description "Whether groups are declared or constructed by field equality or ordered raw string concatenation." ;
            sh:in (
                "declared_group_membership"
                "field_equality"
                "raw_string_concatenation"
            ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path chron:grouping_basis ;
        ] ,
        [
            sh:description "Payloads that may be absent from the produced interaction-event record, disjoint from its required payloads." ;
            sh:in (
                "screenshot"
                "view_hierarchy"
                "gesture"
            ) ;
            sh:order 19 ;
            sh:path chron:optional_event_payload_roles ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Channels or outputs the operation produces." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:produces ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Semantic responsibility of the operation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:operation_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Declared effects such as preserve, drop, split, classify, or encode." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:data_effects ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Profile-local source assertion of the literal symbol emitted for an identity previously encountered in the partition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path chron:sequence_repeat_symbol_setting_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Action the operation performs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:verb ;
        ] ,
        [
            sh:description "Payloads required together within each interaction-event record produced by this operation. These are event composition, not unrelated output channels or literal serialized field names. Does not establish instance identities." ;
            sh:in (
                "screenshot"
                "view_hierarchy"
                "gesture"
            ) ;
            sh:order 18 ;
            sh:path chron:required_event_payload_roles ;
        ] ,
        [
            sh:description "Closed encoding rule applied to every ordered occurrence within each declared partition." ;
            sh:in (
                "first_vs_previously_seen_in_partition"
            ) ;
            sh:maxCount 1 ;
            sh:order 23 ;
            sh:path chron:sequence_encoding_rule ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Ordered profile-local source field assertions concatenated without separator when grouping_basis is raw_string_concatenation. This is a sequence, not a conjunctive equality-field set; repeated operands remain meaningful." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path chron:concatenated_key_setting_ids ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "The coarser semantic operation this operation is a proper part of. Referenced by operation_id, not inlined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Direct configuration fields read by this operation." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:configuration_dependencies ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Profile-local source assertions identifying what is compared with earlier occurrences within a partition; undisclosed raw comparison fields remain unknown." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path chron:sequence_identity_setting_ids ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether absence of gesture metadata marks the event incomplete, independently of the captured screenshot and hierarchy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path chron:missing_gesture_marks_incomplete ;
        ] ,
        [
            sh:description "Source-declared group member disposition, independent of the unrecovered ordering or marker implementation." ;
            sh:in (
                "FIRST"
                "LAST"
                "DISCARD_SUMMARY_IF_NON_SUMMARY_EXISTS"
                "RETAIN_SUMMARIES_IF_PRESENT_ELSE_ALL"
            ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path chron:selection_rule ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Profile-local source field assertions compared for equality inside the enclosing partition." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path chron:equality_key_setting_ids ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Upstream operations defining the partitions at which sequence history resets; not a global history or an invented raw pairing algorithm." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path chron:sequence_scope_operation_ids ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Subset of concatenated key operands whose absent fields contribute an empty string. Does not replace explicit null or coerce a non-string value." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path chron:empty_if_absent_key_setting_ids ;
        ] ,
        [
            sh:class chron:MethodSettingAssertion ;
            sh:description "Profile-local source assertion of the literal symbol emitted for a first occurrence in the partition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path chron:sequence_first_symbol_setting_id ;
        ] ;
    sh:targetClass chron:OperationDefinition ;
.

chron:MethodSettingAssertion
    a sh:NodeShape ;
    rdfs:comment "One source-supported decision in a StudyMethodProfile. This is richer than runtime ParameterBinding: it preserves semantic role, target, value shape, evidence, and implementation binding before a runnable subset compiles to flat knob/value pairs." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Layer affected by the setting." ;
            sh:in (
                "collector"
                "raw_occurrence"
                "raw_record"
                "acquired_snapshot"
                "app_episode"
                "app_session"
                "screen_bout"
                "device_session"
                "device_setting_state_interval"
                "device_setting_actuation"
                "pickup_activation"
                "participant_day"
                "participant_hour"
                "participant_record"
                "participant_measure"
                "study_window"
                "analysis_record_set"
                "text_entry_trial"
                "diary_item"
                "diary_response"
                "derived_feature"
                "model"
                "notification_item"
                "notification_alert"
                "notification_attendance"
                "notification_delivery"
                "intervention_content_state"
                "call_handling"
                "outcome"
                "released_artifact"
            ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path chron:method_target_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content digest of the passing conformance result for this exact setting and executor value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 52 ;
            sh:path chron:conformance_result_digest ;
        ] ,
        [
            sh:class chron:MethodContractBinding ;
            sh:description "Exact runtime slot/value bindings authorized by this setting." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path chron:contract_bindings ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Generated runtime-contract slot used when natively executable." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path chron:mapped_contract_slot ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source locations supporting this assertion." ;
            sh:nodeKind sh:Literal ;
            sh:order 53 ;
            sh:path chron:source_locators ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Inputs whose exact identities or schemas are required by this setting." ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path chron:required_inputs ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Evidence-bound rationale for implementation and binding status." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 50 ;
            sh:path chron:adjudication_rationale ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable clause identities within the source extraction that this atomic setting accounts for." ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path chron:source_clause_ids ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON preserving an evidence-derived candidate for a first-class acquisition, diary, session, duration, timestamp, release, or notification protocol object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path chron:structured_protocol_candidate_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical identity of the exact source supplying the evidence when it differs from the reviewed work." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path chron:source_evidence_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON serialization of the complete source-declared value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:method_value_json ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Start offset of the clause within the preserved source value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path chron:source_clause_start ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Inclusivity, clipping, ordering, or calendar convention required to interpret the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:method_boundary_convention ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "End offset of the clause within the preserved source value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path chron:source_clause_end ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "SHA-256 identity of the complete preserved source value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path chron:source_value_sha256 ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-facing label for this branch or member." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path chron:method_variant_branch_label ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Zero-based position of this field in the source-declared output tuple." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path chron:source_output_position ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the source or source-derived fixture proving this exact executor binding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 51 ;
            sh:path chron:conformance_fixture_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-located statement from which this atomic setting was extracted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path chron:source_observed_setting ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Corpus wave or integration source that supplied the evidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path chron:integration_source ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact Chronicle output column corresponding to the source-declared output field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path chron:chronicle_output_column ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable branch identity within the method variant group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path chron:method_variant_branch_id ;
        ] ,
        [
            sh:description "What the reviewed source disclosed for this setting." ;
            sh:in (
                "declared"
                "declared_partial"
                "delegated"
                "absent"
                "not_applicable"
                "undetermined"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path chron:method_disclosure_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable structural path of the clause within the source extraction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path chron:source_clause_path ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source evidence layer used for this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 45 ;
            sh:path chron:evidence_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-ledger coverage status preserved independently from applicability and implementation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path chron:source_coverage_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Human-readable label for the accounted source clause." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path chron:source_clause_label ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON preserving the complete source-declared atomic, joint, variant, or multiverse configuration structure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path chron:method_configuration_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Preserved source-to-ontology mapping note." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path chron:ontology_mapping_note ;
        ] ,
        [
            sh:description "Execution support for this exact setting, never inferred from semantic mapping alone." ;
            sh:in (
                "native"
                "external_executor"
                "specification_only"
                "refused_missing_signal"
                "unresolved"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 19 ;
            sh:path chron:method_implementation_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one source-supported setting assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_setting_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of a source-declared alternative, joint specification, conditional branch set, or multiverse group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path chron:method_variant_group_id ;
        ] ,
        [
            sh:description "Whether this setting is required for this profile, separately from disclosure quality." ;
            sh:in (
                "applicable"
                "not_applicable"
                "undetermined"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path chron:method_applicability_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Existing ontology term used by the setting." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path chron:mapped_ontology_term ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable C01-C21 measurement-component identifier when applicable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:rubric_component_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source or canonical parameter name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:method_parameter_key ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Registered operation, protocol adapter, external executor, or receipt destination identity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path chron:method_execution_destination_id ;
        ] ,
        [
            sh:description "Functional role of the setting." ;
            sh:in (
                "acquisition"
                "event_schema"
                "diary_schema"
                "participant_schema"
                "reconstruction"
                "quality_control"
                "aggregation"
                "feature_engineering"
                "analysis"
                "intervention"
                "validation"
                "reporting"
                "provenance"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path chron:method_setting_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source-declared relationship among members of the method variant group; kept verbatim until profile partitioning adjudicates it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path chron:method_variant_relation ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Unit attached to the value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:method_unit ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical citation identity of the source work." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path chron:source_work_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Preserved assessment of any semantic or execution gap." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path chron:gap_assessment ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable native or external executor identity when one exists." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path chron:executor_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact parameter or input path within the destination contract." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path chron:method_execution_parameter_path ;
        ] ,
        [
            sh:description "Exact replication destination assigned to this setting." ;
            sh:in (
                "native_option_binding"
                "protocol_input"
                "native_operator_parameter"
                "external_named_executor"
                "receipt_conformance"
            ) ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path chron:method_execution_route ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Bounded confidence in the structured adjudication." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 49 ;
            sh:path chron:adjudication_confidence ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact extracted clause text represented by this atomic setting." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path chron:source_clause_text ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Canonical JSON serialization of the complete pre-atomization source value for reversible audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path chron:source_value_json ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Current fail-closed reason preventing this route from executing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path chron:method_execution_blocker_code ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Evidence-row identity from which this atomic setting was derived." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:source_extraction_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact Chronicle output artifact kind containing the source-declared output field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path chron:chronicle_output_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Boundary comparator such as less-than, at-most, or inclusive-between." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:method_comparator ;
        ] ,
        [
            sh:description "Serialization shape of method_value_json." ;
            sh:in (
                "boolean"
                "integer"
                "float"
                "string"
                "enumeration"
                "duration"
                "timestamp"
                "time_window"
                "list"
                "object"
                "expression"
                "artifact_reference"
                "unspecified"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path chron:method_value_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Source extraction component or auxiliary axis identity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path chron:source_component_id ;
        ] ;
    sh:targetClass chron:MethodSettingAssertion ;
.

chron:UsageInterval
    a sh:NodeShape ;
    rdfs:comment "A phenomenon-time interval a usage assertion denotes. A time:ProperInterval." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Endpoint status of the end." ;
            sh:in (
                "observed"
                "unobserved"
                "right_censored"
                "interval_censored"
            ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path chron:end_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Interval end instant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:end_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Interval start instant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:start_instant ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Interval duration in seconds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path qudt:hasQuantityValue ;
        ] ,
        [
            sh:description "Endpoint status of the start." ;
            sh:in (
                "observed"
                "unobserved"
                "right_censored"
                "interval_censored"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:start_status ;
        ] ;
    sh:targetClass chron:UsageInterval ;
.
