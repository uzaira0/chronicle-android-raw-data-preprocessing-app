chron:diary_schedule_rule_id
    a owl:DatatypeProperty ;
    rdfs:label "diary_schedule_rule_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable diary-schedule rule identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_source_adapter_receipt
