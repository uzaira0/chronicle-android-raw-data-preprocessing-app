            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:expected_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:actually_available ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:assesses_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:participant_id ;
        ] ,
        [
            a owl:Restriction ;
