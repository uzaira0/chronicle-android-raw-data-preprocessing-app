{
  "id": "./",
  "name": "Chronicle Local Preprocessing",
  "short_name": "Chronicle",
  "description": "Local-first preprocessing. Files stay on this device.",
  "display_override": ["standalone", "window-controls-overlay"],
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111318",
  "theme_color": "#111318",
  "start_url": "./",
  "scope": "./",
  "categories": ["productivity", "utilities", "health"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/narrow.svg",
      "sizes": "390x844",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Chronicle settings and file selection on mobile"
    },
    {
      "src": "./screenshots/wide.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Chronicle processing panel with results on desktop"
    }
  ]
}
