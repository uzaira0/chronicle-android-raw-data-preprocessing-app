                            ) ;
                        ]

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:integer ;
                            owl:withRestrictions (

                                [
                                    xsd:maxInclusive 1 ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:used_in_month ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:method_profile_id ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Supplied partial user/app/month binary cell, as distinguished in Sekara et al. Scientific Reports2021 Figure1 and Methods. One means used in that month and zero otherwise, not installed/uninstalled. Omitted/null values are normalized unknowns, never filled with zero. App and user tokens are opaque pseudonymous identifiers, not inferred packages or hash algorithms. No day/session, calendar boundary, complete fingerprint, eligibility or annual maximum/OR computation is inferred from these supplied cells." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

