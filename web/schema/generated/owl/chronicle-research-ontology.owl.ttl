    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:evidence_record_id
    a owl:DatatypeProperty ;
    rdfs:label "evidence_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized evidence identity local to its owning item history or supplied callback group; duplicated world-occurrence evidence across histories does not assert distinct unlocks. Equal callback times/payloads do not imply equal identities." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
