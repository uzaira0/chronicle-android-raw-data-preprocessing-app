.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#draxler_interruption_aware>
    a owl:Class ;
    rdfs:label "draxler_interruption_aware" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "Chronicle episode-level derivative informed by Draxler et al. (2021), not their full learning-session/interruption method: closes on own-package backgrounding, a screen-stop event, foreground handover, or a gap strictly over 600 seconds between consecutive input rows (at the preceding row time). It does not reconstruct within-session suspending interruptions, return linkage, or experience-sampling queries." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#eyes_complement>
    a owl:Class ;
    rdfs:label "eyes_complement" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "EYES complement-based device-state segmentation (ACTIVE = not(SHUTDOWN or IDLE or GAP or GLANCE))." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#foreground_background_pairing>
    a owl:Class ;
    rdfs:label "foreground_background_pairing" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "Ahmed et al. (2023) / Okoshi et al. (2025): each Activity Resumed closed by the next Activity Paused of the same package, with no repair of any kind." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#fused_matcher>
    a owl:Class ;
    rdfs:label "fused_matcher" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "This engine's fused open/close matcher (production)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#gesis_start_stop_repair>
    a owl:Class ;
    rdfs:label "gesis_start_stop_repair" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "GESIS/Zerrer three-tier start-stop repair. Tier 1 is the nearest same-package close candidate — a Stop, or a Start whose next same-app event is not a Stop, so an app with no stop event closes at its own next Start (ported deliberately from the tutorial code, per the matcher's own comment) — accepted only when at most ten events sit between the start and that candidate (`GESIS_EVENT_THRESHOLD = 10`, pipeline_v2.rs:125, passed to `match_app_usage_gesis_with_openers_indices_core`): the tutorial's `event_threshold`, alongside its `max_timeout`. Tier 2 is the next event of any kind, accepted only when it falls within 600 s of the start; tier 3 cuts the episode at start + 600 s, an instant no event carries (`GESIS_MAX_TIMEOUT_NS`). The event threshold is as load-bearing as the timeout — a same-package stop further than ten events away is rejected even when it is well inside 600 s — and omitting it from this description made the arm look like a pure time rule." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#morrison_lock_tolerant>
    a owl:Class ;
    rdfs:label "morrison_lock_tolerant" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "Morrison et al. (2018): ends on handover or on a lock that keeps the screen off for thirty seconds (inherited from Bohmer et al. 2011); a shorter lock does not end the use." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#parry_toth_forward_pairing>
    a owl:Class ;
    rdfs:label "parry_toth_forward_pairing" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "Parry & Toth start-only bracket-first forward pairing." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ReconstructionStrategyId#schoedel_2026_app_within_screen_prose_v1>
    a owl:Class ;
    rdfs:label "schoedel_2026_app_within_screen_prose_v1" ;
    rdfs:subClassOf chron:ReconstructionStrategyId ;
    skos:definition "Controlled derivative of Schoedel et al. (2026)'s simplified prose: within a selected screen interval, a type-1 app row opens an episode and the app's last row before a different-app type-1 row or observed screen end closes it. This is not the full deposited PhoneStudy pipeline." ;
.

<https://w3id.org/chronicle-usage-ontology/core/RingerModeId#Normal>
    a owl:Class ;
    rdfs:label "Normal" ;
    rdfs:subClassOf chron:RingerModeId ;
.

<https://w3id.org/chronicle-usage-ontology/core/RingerModeId#Silent>
    a owl:Class ;
    rdfs:label "Silent" ;
    rdfs:subClassOf chron:RingerModeId ;
.

<https://w3id.org/chronicle-usage-ontology/core/RingerModeId#Vibrate>
    a owl:Class ;
    rdfs:label "Vibrate" ;
    rdfs:subClassOf chron:RingerModeId ;
.

chron:SampledEntityMemberRecord
    a owl:Class ;
    rdfs:label "SampledEntityMemberRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:entity_member_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:entity_member_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:entity_member_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:member_entity_kind ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:observed_entity_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:member_entity_kind ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:quantities ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:observed_entity_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:observed_entity_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:string

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:string ;
                            owl:withRestrictions (

                                [
                                    xsd:pattern "^(access_point|cell|application)$" ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:member_entity_kind ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:SampledQuantityRecord ;
            owl:onProperty chron:quantities ;
        ] ;
    skos:definition "One supplied AP appearance, cell/AP member, or application member owned by one observation. Application meaning comes from the local source definition: simultaneous running appearance, supplied app-vocabulary feature member, static installed membership, or ranked recent-task member are distinct. Its local record identity is distinct from an optional recurring entity token and independently retained CID/LAC or anonymized MAC/SSID readings. Equal tokens/values do not merge members. RSSI/frequency belong to the scan appearance, not a stable AP property or an inferred place fingerprint. Omitted/null quantities remain unknown; an empty list is explicitly empty. Membership does not recover a scan-to-place join, ranking, geographic coordinate, hash algorithm, clustering execution, visit or session context. An application token is a supplied opaque identifier, not an inferred package/name mapping. Installation origin is an optional member-owned categorical quantity, not a device/cohort mean or inferred app use. Ranked recent-task source rank/key, boot-elapsed token, component and source value remain independent member quantities. Same-package/different- activity appearances retain distinct member IDs and ordered source keys; list position does not synthesize rank." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:SampledObservationReferenceRecord
    a owl:Class ;
    rdfs:label "SampledObservationReferenceRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:string

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:string ;
                            owl:withRestrictions (

                                [
                                    xsd:pattern "\\S" ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:sampled_observation_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:string

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:string ;
                            owl:withRestrictions (

                                [
                                    xsd:pattern "\\S" ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:sampled_observation_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:sampled_observation_reference ;
        ] ;
    skos:definition "Supplied role-qualified relationship to another normalized observation, not a matcher or temporal selection. Next App pp4–5 distinguishes one AppOpen anchor, six independently named last-action supports and a separate before/after Gaussian-context membership. Same-owner links resolve within profile/work/participant and compatible known device. Sections5.2.1–5.2.2 separately permit explicit cross-participant input inventories and surrogate-history members; target identities retain their source participant, never an inferred identity merge. Omitted/null target leaves this role's support unknown. Equal timestamps or values do not establish linkage, latest/nearest selection or order." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#device_liveness_only>
    a owl:Class ;
    rdfs:label "device_liveness_only" ;
    rdfs:subClassOf chron:ScreenGatingRuleId ;
    skos:definition "Credit demonstrably-alive spans alone, without requiring a screen witness. An activity-based rather than screen-based measurement; the no-screen-witness fallback never applies because no screen evidence is consulted." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_and_liveness_v1>
    a owl:Class ;
    rdfs:label "screen_and_liveness_v1" ;
    rdfs:subClassOf chron:ScreenGatingRuleId ;
    skos:definition "Compatibility default: credit the intersection of witnessed screen-ON intervals and demonstrably-alive spans. Byte-identical to the pre-B07 credited output." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_witness_only>
    a owl:Class ;
    rdfs:label "screen_witness_only" ;
    rdfs:subClassOf chron:ScreenGatingRuleId ;
    skos:definition "Credit witnessed screen-ON intervals alone, without requiring the device to be demonstrably alive. More permissive: a lit screen inside a long event silence still earns credit." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#strict_visual_only>
    a owl:Class ;
    rdfs:label "strict_visual_only" ;
    rdfs:subClassOf chron:ScreenGatingRuleId ;
    skos:definition "Credit witnessed screen-ON intervals alone and exclude any app session with no screen witness. This is the source-faithful visual-only rule; it never uses Chronicle's no-witness alive-span fallback." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenSessionClassificationPolicyId#none>
    a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf chron:ScreenSessionClassificationPolicyId ;
    skos:definition "Do not assign a literature screen-session class." ;
.

<https://w3id.org/chronicle-usage-ontology/core/ScreenSessionClassificationPolicyId#null_no_app_strict_gt15s_vs_app>
