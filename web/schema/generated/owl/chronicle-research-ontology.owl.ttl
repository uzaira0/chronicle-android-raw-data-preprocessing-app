.

chron:drawer_position
    a owl:DatatypeProperty ;
    rdfs:label "drawer_position" ;
    rdfs:range xsd:integer ;
    skos:definition "Supplied normalized observation-specific drawer ordinal; no source zero/one base or creation-time ordering is asserted." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:duration_action
    a owl:DatatypeProperty ;
    rdfs:label "duration_action" ;
    rdfs:range xsd:string ;
    skos:definition "Action on values meeting the duration condition." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:duration_policy_id
    a owl:DatatypeProperty ;
    rdfs:label "duration_policy_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable target-typed duration-policy identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:duration_seconds
    a owl:DatatypeProperty ;
    rdfs:label "duration_seconds" ;
    rdfs:range xsd:float ;
    skos:definition "Interval duration in seconds." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:effective_timestamp_semantics
    a owl:DatatypeProperty ;
    rdfs:label "effective_timestamp_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Timestamp used by later operations after correction or normalization." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:end_action_reference
    a owl:DatatypeProperty ;
    rdfs:label "end_action_reference" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "^.*\\S.*$" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied end action ID for the same gap, resolving locally and distinct from a known start. Not an aggregation support or mean endpoint; no duration calculation or cross-boundary matching." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:end_condition
    a owl:DatatypeProperty ;
    rdfs:label "end_condition" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied terminal-condition token validated against the local constructor definition; not an inferred event occurrence or reconstructed closing time." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:end_instant
    a owl:DatatypeProperty ;
    rdfs:label "end_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Interval end instant." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:end_observation_ref
    a owl:DatatypeProperty ;
    rdfs:label "end_observation_ref" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied end state-record ID, independent of start and bounds; resolved within profile/participant/known device." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:end_status
    a owl:ObjectProperty ;
    rdfs:label "end_status" ;
    rdfs:range chron:EndpointStatus ;
    skos:definition "Endpoint status of the end." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ended_at
    a owl:DatatypeProperty ;
    rdfs:label "ended_at" ;
    rdfs:range xsd:string ;
    skos:definition "Execution end." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:engine
    a owl:DatatypeProperty ;
    rdfs:label "engine" ;
    rdfs:range xsd:string ;
    skos:definition "Named algorithm or engine the operation realizes." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:entity_member_id
    a owl:DatatypeProperty ;
    rdfs:label "entity_member_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied member record ID unique within its owning observation; distinct from an optional recurring AP/cell identity token." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:epistemic_role
    a owl:DatatypeProperty ;
    rdfs:label "epistemic_role" ;
    rdfs:range xsd:string ;
    skos:definition "Whether the operation observes, infers, applies policy, or presents." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:event_payload_association
    a owl:ObjectProperty ;
    rdfs:label "event_payload_association" ;
    rdfs:range chron:InteractionEventPayloadAssociationId ;
    skos:definition "Direction and source-declared association of payloads within one interaction event; no undisclosed temporal predicate is implied." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:event_sequence_position
    a owl:DatatypeProperty ;
    rdfs:label "event_sequence_position" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:integer

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions (

                        [
                            xsd:minInclusive 0 ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Nonnegative position in the current trace; unique within the trace. Does not assert a source timestamp-sort algorithm." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:event_timestamp_ns
    a owl:DatatypeProperty ;
    rdfs:label "event_timestamp_ns" ;
    rdfs:range xsd:integer ;
    skos:definition "Event timestamp in nanoseconds since epoch." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:evidence_basis
    a owl:DatatypeProperty ;
    rdfs:label "evidence_basis" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied inference or recording basis; omission/null leaves the basis unknown rather than reconstructed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:evidence_instant
    a owl:DatatypeProperty ;
    rdfs:label "evidence_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied textual time token for this evidence alone; no endpoint equality or conversion is inferred." ;
