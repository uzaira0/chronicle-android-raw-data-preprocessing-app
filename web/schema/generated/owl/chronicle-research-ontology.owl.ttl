chron:feature_name
    a owl:DatatypeProperty ;
    rdfs:label "feature_name" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied feature label scoped by the owning application; not a global closed vocabulary or an occurrence identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:feature_occurrence_id
    a owl:DatatypeProperty ;
    rdfs:label "feature_occurrence_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied instance identity unique within its owning session even at identical feature labels/times." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:feature_session_id
    a owl:DatatypeProperty ;
    rdfs:label "feature_session_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied app-session identity scoped by profile/participant/device; not an inferred app/time join key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:first_screenshot_reference
    a owl:DatatypeProperty ;
    rdfs:label "first_screenshot_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied first endpoint resolving within the owning session; unknown is not the session's first screenshot." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:fixture_id
    a owl:DatatypeProperty ;
    rdfs:label "fixture_id" ;
    rdfs:range xsd:string ;
    skos:definition "Shared conformance fixture executed for this binding." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:fixture_input_sha256
    a owl:DatatypeProperty ;
    rdfs:label "fixture_input_sha256" ;
    rdfs:range xsd:string ;
    skos:definition "Expected and observed SHA-256 of the shared fixture input." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:fixture_normalized_sha256
    a owl:DatatypeProperty ;
    rdfs:label "fixture_normalized_sha256" ;
    rdfs:range xsd:string ;
    skos:definition "Expected and observed SHA-256 of the adapter-normalized shared fixture." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:following_device_use_session_reference
    a owl:DatatypeProperty ;
    rdfs:label "following_device_use_session_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Explicitly supplied immediately following interval within the same disclosed family: alternating screen intervals (Hush Section6.1) or uninterrupted T0 sessions (Van Berkel Analysis). Scoped by profile/source/participant/known device; distinct and acyclic. Known on/off consistency applies only to alternating intervals. Never inferred from equal timestamps, gaps or continuation labels. Null/omission is unknown, not no successor." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:follows_strategy
    a owl:ObjectProperty ;
    rdfs:label "follows_strategy" ;
    rdfs:range chron:ReconstructionStrategy ;
    skos:definition "The reconstruction strategy followed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:form_element_count
    a owl:DatatypeProperty ;
    rdfs:label "form_element_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of composed form elements transported for the selected version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:gap_assessment
    a owl:DatatypeProperty ;
    rdfs:label "gap_assessment" ;
    rdfs:range xsd:string ;
    skos:definition "Preserved assessment of any semantic or execution gap." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:gesture_artifact_id
    a owl:DatatypeProperty ;
    rdfs:label "gesture_artifact_id" ;
    rdfs:range xsd:string ;
    skos:definition "Optional gesture payload identity; absent or null is not silently completed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:gesture_presence_implies_correctness
    a owl:DatatypeProperty ;
    rdfs:label "gesture_presence_implies_correctness" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether gesture presence alone establishes correctness. False means presence is insufficient evidence, not that every gesture is wrong. Completeness and correctness remain independent; no particular instance is assessed here." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:group_key_compat_absent
    a owl:DatatypeProperty ;
    rdfs:label "group_key_compat_absent" ;
    rdfs:range xsd:boolean ;
    skos:definition "Explicit normalized assertion about original linked-release group-key absence; true must not coexist with a supplied group_key_compat_value_json token, false asserts not absent, and null or omission is unknown. Never inferred from normalized omission or used to apply a default during import." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:group_key_compat_value_json
    a owl:DatatypeProperty ;
    rdfs:label "group_key_compat_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied appearance-local groupKeyCompat lexical JSON value token (Clear All linked shared.py lines17/33). Present null and empty string are not absence, and import applies no default, key expansion or grouping." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:group_summary_compat_value_json
    a owl:DatatypeProperty ;
    rdfs:label "group_summary_compat_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied appearance-local isGroupSummaryCompat lexical JSON value token (Clear All linked shared.py lines24/35/37); no truthiness conversion or summary-member selection is performed by import." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:grouping_basis
    a owl:ObjectProperty ;
    rdfs:label "grouping_basis" ;
    rdfs:range chron:GroupedRecordGroupingBasisId ;
    skos:definition "Whether groups are declared or constructed by field equality or ordered raw string concatenation." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:grouping_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "grouping_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional compatible local source-definition reference, distinguishing per-user clustering from pooled sessions without executing either." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:hierarchy_artifact_id
    a owl:DatatypeProperty ;
    rdfs:label "hierarchy_artifact_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identity of this event's paired view hierarchy in the supplied ArtifactRef catalog." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:hierarchy_redaction_effect
    a owl:ObjectProperty ;
    rdfs:label "hierarchy_redaction_effect" ;
    rdfs:range chron:HierarchyRedactionEffectId ;
    skos:definition "Supplied hierarchy-side effect of this paired redaction." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:history_subject_participant_id
    a owl:DatatypeProperty ;
    rdfs:label "history_subject_participant_id" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied person whose autobiographical history generated a DynamicSecurity challenge, distinct from the owning Task participant_id answering it. Primary layout874–896 presents the same question/options to the legitimate person, paired strong adversary and hidden-stranger naive adversary. Null/omission leaves history identity unknown; no participant assignment, original challenge key or history join is recovered." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:human_detected_incorrect
    a owl:DatatypeProperty ;
    rdfs:label "human_detected_incorrect" ;
    rdfs:range xsd:boolean ;
    skos:definition "Supplied human finding of incorrect interaction metadata; false, null and omission remain distinct." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:inheritance
    a owl:DatatypeProperty ;
    rdfs:label "inheritance" ;
    rdfs:range xsd:string ;
    skos:definition "Direct, inherited, or unresolved parameter transfer." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:initial_sample_policy
    a owl:DatatypeProperty ;
    rdfs:label "initial_sample_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Treatment of the first observation in a run or window." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:integration_source
    a owl:DatatypeProperty ;
    rdfs:label "integration_source" ;
    rdfs:range xsd:string ;
    skos:definition "Corpus wave or integration source that supplied the evidence." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interaction_event_id
    a owl:DatatypeProperty ;
    rdfs:label "interaction_event_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized event identity, unique within its owning trace." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interaction_trace_id
    a owl:DatatypeProperty ;
    rdfs:label "interaction_trace_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized identity of one current interaction trace." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interaction_trace_reference
    a owl:DatatypeProperty ;
    rdfs:label "interaction_trace_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied link to the trace assessed by this task/questionnaire completion (ODIM pp12–13 §§5.2–5.3). Resolves within the same profile/source and must match participant identity when known on the trace. Multiple independent questionnaire tasks may assess one trace; null/omission leaves the target unknown. No join, temporal order or participant identity is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interruption_record_id
    a owl:DatatypeProperty ;
    rdfs:label "interruption_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied interruption identity unique within its containing session, independent of label or equal bounds." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interruption_record_reference
    a owl:DatatypeProperty ;
    rdfs:label "interruption_record_reference" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied interruption ID resolving only within the containing tracked-app session; null/omission is unknown relationship, not a last-interruption or cause inference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interruption_type
    a owl:DatatypeProperty ;
    rdfs:label "interruption_type" ;
    rdfs:range xsd:string ;
    skos:definition "Optional open supplied event-type descriptor, such as the illustrated APP_SWITCH; not automatically an internal/device/external cause or suspending/terminating outcome." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interval_kind
    a owl:ObjectProperty ;
    rdfs:label "interval_kind" ;
    rdfs:range chron:DeviceStateIntervalKindId ;
    skos:definition "Supplied interval meaning; upper-bound unlock cost is not authentication-input duration." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:interval_record_origin
    a owl:ObjectProperty ;
    rdfs:label "interval_record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Supplied normalized records versus constructed example; neither authenticates source rows or reconstruction." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:is_deleted
    a owl:DatatypeProperty ;
    rdfs:label "is_deleted" ;
    rdfs:range xsd:boolean ;
    skos:definition "Supplied normalized boolean deletion flag, not a recovered 0/1 source serialization or an edit classifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:is_fatal
    a owl:DatatypeProperty ;
    rdfs:label "is_fatal" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a failure fails the whole workflow." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:is_password
    a owl:DatatypeProperty ;
    rdfs:label "is_password" ;
    rdfs:range xsd:boolean ;
    skos:definition "Supplied normalized boolean password-field flag; password phrases are not reconstructed from masked source data." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:item_identity_basis
    a owl:ObjectProperty ;
    rdfs:label "item_identity_basis" ;
    rdfs:range chron:NotificationItemIdentityBasisId ;
    skos:definition "Source-backed identity definition for this appearance, not an asserted equivalence between source versions." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:keyboard_schema_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "keyboard_schema_setting_reference" ;
    rdfs:range xsd:string ;
