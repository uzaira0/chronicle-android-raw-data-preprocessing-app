{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzaira0:semantic-federation:protocol:artifact-closure:0.1",
  "title": "Content-addressed artifact closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "root_digest", "artifacts", "closure_digest"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "root_digest": { "$ref": "#/$defs/digest" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "digest", "media_type", "size"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "media_type": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "derived_from": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true }
        }
      }
    },
    "closure_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
