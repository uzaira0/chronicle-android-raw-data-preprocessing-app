      "input_boundary": "one caller-qualified complete participant-wide supplied-order screen-row inventory on one explicit common clock with finite binary64 millisecond timestamps, nonmissing device strings and known integer states 0/1/2/3; no device split or timestamp sort",
      "first_lock_missing_lag": "R filter drops the first LOCK's NA predicate independently in both sequential snapshots",
      "empty_inventory_behavior": "fewer than two supplied rows emits no episodes; fixed portable CSV normalizes the narrower R empty schema",
      "raw_acquisition_original_read_csv_coercions_datetime_timezone_segment_construction_and_study_version_equivalence_excluded": true
