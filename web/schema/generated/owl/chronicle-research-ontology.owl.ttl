.

<https://w3id.org/chronicle-usage-ontology/core/DeviceStateIntervalKindId#unlock_cost_upper_bound>
    a owl:Class ;
    rdfs:label "unlock_cost_upper_bound" ;
    rdfs:subClassOf chron:DeviceStateIntervalKindId ;
    skos:definition "ON_LOCKED to ON_UNLOCKED, potentially including clock/notification viewing, not pure authentication time (printed p218 Section4.1.1)." ;
.

