.

chron:opening_occurrence_id
    a owl:DatatypeProperty ;
    rdfs:label "opening_occurrence_id" ;
    rdfs:range xsd:string ;
    skos:definition "Normalized shared opening identity scoped by profile/participant/device; distinct occurrences remain distinct even at equal supplied app/time." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:opening_occurrence_reference
    a owl:DatatypeProperty ;
    rdfs:label "opening_occurrence_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional shared opening ID supporting inferred seen/latency in the owning history. A positive reference requires that history in supplied opening membership and a known common device; null/omission does not assert a relationship." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:opening_record_origin
    a owl:ObjectProperty ;
