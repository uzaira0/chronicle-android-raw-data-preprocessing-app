            owl:onProperty chron:referenced_night_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:day_observation_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:referenced_night_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:referenced_night_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:referenced_hour_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a rdfs:Datatype ;
                    owl:intersectionOf (
                        xsd:string

                        [
                            a rdfs:Datatype ;
                            owl:onDatatype xsd:string ;
                            owl:withRestrictions (

                                [
                                    xsd:pattern "\\S" ;
                                ]
                            ) ;
                        ]
                    ) ;
                ] ;
            owl:onProperty chron:relationship_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:referenced_day_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:referenced_hour_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:referenced_hour_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:referenced_day_token ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:referenced_day_token ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Explicit support/comparison from a subjective participant-period observation to an objective aggregate in a different supplied period, within the same profile/work/participant. The target observation identity and exact period kind/token both resolve; the relationship label and provenance preserve why the records are compared, not a computed calendar adjacency or causal claim. Murnane2016 p7 compares prior-night reported sleep with following-day use; p8 same-night counts use the separate existing same-period reference." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:DocumentaryExecutionEligibilityId
