.

chron:last_screenshot_reference
    a owl:DatatypeProperty ;
    rdfs:label "last_screenshot_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied last endpoint resolving within the owning session; unknown is not the session's last screenshot." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

