            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:adapter_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:normalized_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:adapter_version ;
        ] ;
    skos:definition "Exact receipt from one versioned diary source-layout adapter execution. This proves source-layout conformance only; it never upgrades a blocked diary protocol to executable." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

