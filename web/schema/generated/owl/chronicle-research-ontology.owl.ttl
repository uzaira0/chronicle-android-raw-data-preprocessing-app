    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:known_minutes
    a owl:DatatypeProperty ;
    rdfs:label "known_minutes" ;
    rdfs:range xsd:float ;
    skos:definition "Admitted minutes on this participant-day whose username is a real person (neither blank, \"nan\", nor \"None\"). The compliance numerator." ;
