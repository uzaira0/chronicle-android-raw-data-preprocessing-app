{
  "name": "chronicle-preprocessing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "host:local": "npm run build && npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "process:browser": "vite-node scripts/run_browser_processing.mts",
    "build:wasm": "wasm-pack build ../rust/chronicle_app_usage_wasm --target web --out-dir src/wasm/chronicle_app_usage_wasm/pkg"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "exceljs": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.5"
  }
}
