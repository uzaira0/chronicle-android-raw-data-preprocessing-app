            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:range_label_values_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:first_screenshot_reference ;
        ] ,
        [
            a owl:Restriction ;
