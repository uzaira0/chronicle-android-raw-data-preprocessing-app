      },
      {
        "path": "web/src/lib/pipelineGraph/golden/family-expected/semantic-model-mutation-ledger.json",
        "digest": "sha256:7f2645140902eff9909e5b052df943a00b7157a2040e407c8272d3e888982e3b",
        "protocol_version": "chronicle-semantic-model-mutation-ledger/v1",
