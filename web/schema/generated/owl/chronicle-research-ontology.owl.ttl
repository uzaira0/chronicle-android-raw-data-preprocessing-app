chron:InteractionTypeRemovalModeId
    a owl:Class ;
    rdfs:label "InteractionTypeRemovalModeId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#gap_preserving>
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#unconditional>
    ) ;
    skos:definition "Whether selected interaction types are removed unconditionally or retain rows that carry long-data-gap evidence. `gap_preserving` is Chronicle's compatibility behavior. `unconditional` reproduces source pipelines such as SmartphoneUsage_Wellbeing that filter the named event before any long-gap exception is considered." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#gap_preserving> ,
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#unconditional> ;
.

<https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#gap_preserving>
    a owl:Class ;
    rdfs:label "gap_preserving" ;
    rdfs:subClassOf chron:InteractionTypeRemovalModeId ;
    skos:definition "Drop selected types except rows whose data gap reaches the smallest configured long-gap threshold (default)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/InteractionTypeRemovalModeId#unconditional>
    a owl:Class ;
    rdfs:label "unconditional" ;
    rdfs:subClassOf chron:InteractionTypeRemovalModeId ;
    skos:definition "Drop every row of a selected type, including rows that carry long-gap evidence." ;
.

chron:IntervalExpansionMethodId
    a owl:Class ;
    rdfs:label "IntervalExpansionMethodId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#none>
        <https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#behapp_start_anchored_half_open_1s_v1>
    ) ;
    skos:definition "Canonical identifiers for source-declared expansions of bounded app intervals into a separate derived timeline. This is not polling: every emitted point is anchored to its own source interval start, and the headline reconstructed episode table is never changed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#behapp_start_anchored_half_open_1s_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#none> ;
.

<https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#behapp_start_anchored_half_open_1s_v1>
    a owl:Class ;
    rdfs:label "behapp_start_anchored_half_open_1s_v1" ;
    rdfs:subClassOf chron:IntervalExpansionMethodId ;
    skos:definition "Exact deposited Behapp preprocessing for `10.1037/emo0001485` (`Match_ESM_App.py`): compute end as start plus `int(duration)`, then emit start, start + 1 second, ... strictly before end. Thus a three-second interval emits offsets 0, 1, and 2, never the stop endpoint." ;
.

<https://w3id.org/chronicle-usage-ontology/core/IntervalExpansionMethodId#none>
    a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf chron:IntervalExpansionMethodId ;
    skos:definition "Compatibility default: emit no interval-expansion artifact." ;
.

chron:IntervalQualityPolicyId
    a owl:Class ;
    rdfs:label "IntervalQualityPolicyId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#none>
        <https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#culverhouse_trim_and_log>
    ) ;
    skos:definition "Canonical identifiers for the named interval-quality policies. This is a SEPARATE axis from reconstruction, crossed with it: a reconstruction rule decides where an episode starts and ends, an interval-quality policy bounds one that is already reconstructed but implausible. It never redefines an episode boundary." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#culverhouse_trim_and_log> ,
        <https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#none> ;
.

<https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#culverhouse_trim_and_log>
    a owl:Class ;
    rdfs:label "culverhouse_trim_and_log" ;
    rdfs:subClassOf chron:IntervalQualityPolicyId ;
    skos:definition "Culverhouse: trim an implausible interval and record that it was trimmed, rather than dropping the episode or blanking its duration." ;
.

<https://w3id.org/chronicle-usage-ontology/core/IntervalQualityPolicyId#none>
    a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf chron:IntervalQualityPolicyId ;
    skos:definition "This engine's own interval cleaning (production default)." ;
.

<https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#LOCKED>
    a owl:Class ;
    rdfs:label "LOCKED" ;
    rdfs:subClassOf chron:KeyguardStateId ;
.

<https://w3id.org/chronicle-usage-ontology/core/KeyguardStateId#UNLOCKED>
    a owl:Class ;
    rdfs:label "UNLOCKED" ;
    rdfs:subClassOf chron:KeyguardStateId ;
.

chron:LockedScreenAudioDispositionId
    a owl:Class ;
    rdfs:label "LockedScreenAudioDispositionId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#include>
        <https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#exclude_from_phone_and_app_sessions>
    ) ;
    skos:definition "Whether locked-screen app/audio continuation counts as interactive phone use." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#exclude_from_phone_and_app_sessions> ,
        <https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#include> ;
.

<https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#exclude_from_phone_and_app_sessions>
    a owl:Class ;
    rdfs:label "exclude_from_phone_and_app_sessions" ;
    rdfs:subClassOf chron:LockedScreenAudioDispositionId ;
    skos:definition "Menthal rule: activity while the screen remains locked/noninteractive creates neither a phone session nor an app session." ;
.

<https://w3id.org/chronicle-usage-ontology/core/LockedScreenAudioDispositionId#include>
    a owl:Class ;
    rdfs:label "include" ;
    rdfs:subClassOf chron:LockedScreenAudioDispositionId ;
    skos:definition "Compatibility default; retain normal Chronicle app and screen construction." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationConfiguredDispositionId#drop_row>
    a owl:Class ;
    rdfs:label "drop_row" ;
    rdfs:subClassOf chron:MaximumDurationConfiguredDispositionId ;
    skos:definition "Remove the app output row while retaining its exact bounds, duration, reason, and source ranges in the maximum-duration excluded-lineage receipt." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationConfiguredDispositionId#flag_and_retain>
    a owl:Class ;
    rdfs:label "flag_and_retain" ;
    rdfs:subClassOf chron:MaximumDurationConfiguredDispositionId ;
    skos:definition "Retain raw timing and credit the episode while recording that it qualified as above the declared maximum." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationConfiguredDispositionId#not_applicable>
    a owl:Class ;
    rdfs:label "not_applicable" ;
    rdfs:subClassOf chron:MaximumDurationConfiguredDispositionId ;
    skos:definition "Required with strategy_native and chronicle_observed_close_rejection_v1, which own their endpoint behaviour natively." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationConfiguredDispositionId#retain_but_exclude>
    a owl:Class ;
    rdfs:label "retain_but_exclude" ;
    rdfs:subClassOf chron:MaximumDurationConfiguredDispositionId ;
    skos:definition "Retain raw timing and lineage but mark the episode ineligible for headline aggregates." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationConfiguredDispositionId#truncate_to_threshold>
    a owl:Class ;
    rdfs:label "truncate_to_threshold" ;
    rdfs:subClassOf chron:MaximumDurationConfiguredDispositionId ;
    skos:definition "Move the effective stop to start + threshold, record the trimmed nanoseconds and effective_endpoint_reason, and keep the raw episode bounds in lineage." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationPolicyId#chronicle_observed_close_rejection_v1>
    a owl:Class ;
    rdfs:label "chronicle_observed_close_rejection_v1" ;
    rdfs:subClassOf chron:MaximumDurationPolicyId ;
    skos:definition "Name Chronicle's fused-matcher candidate-admissibility rule explicitly. Executable only with the fused_matcher strategy; every other strategy refuses with maximum_policy_incompatible_with_reconstruction_strategy." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationPolicyId#post_reconstruction_strict_max_v1>
    a owl:Class ;
    rdfs:label "post_reconstruction_strict_max_v1" ;
    rdfs:subClassOf chron:MaximumDurationPolicyId ;
    skos:definition "Generic stage after episode reconstruction and before concurrency: an episode qualifies when raw duration is strictly greater than the threshold (equality is retained), then the configured disposition applies." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationPolicyId#strategy_native>
    a owl:Class ;
    rdfs:label "strategy_native" ;
    rdfs:subClassOf chron:MaximumDurationPolicyId ;
    skos:definition "Explicitly adopt the selected reconstruction strategy's native maximum-duration behaviour. Baseline-equivalent output plus a receipt; not the same as omission." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#b12_adaptive_participant>
    a owl:Class ;
    rdfs:label "b12_adaptive_participant" ;
    rdfs:subClassOf chron:MaximumDurationThresholdSourceId ;
    skos:definition "Standing refusal (adaptive_maximum_threshold_provider_unavailable): no paper in the collected corpus derives a per-participant duration CAP, so there is nothing faithful for this source to execute and no fallback threshold is fabricated. The individualized-threshold practice that exists in the literature is Peng & Zhu (2020)'s per-user median of inter-app intervals, which is a session-grouping rule and is implemented as the peng_zhu_2020_participant_median arm of SessionGroupingPolicyId." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#chronicle_legacy_config>
    a owl:Class ;
    rdfs:label "chronicle_legacy_config" ;
    rdfs:subClassOf chron:MaximumDurationThresholdSourceId ;
    skos:definition "Chronicle's long_duration_threshold_hours, canonicalized exactly to integer nanoseconds (1.25 h -> 4500000000000; a value that is not a whole number of nanoseconds refuses); pairs only with chronicle_observed_close_rejection_v1." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#fixed_parameter>
    a owl:Class ;
    rdfs:label "fixed_parameter" ;
    rdfs:subClassOf chron:MaximumDurationThresholdSourceId ;
    skos:definition "Read maximum_duration_threshold_ns: exact base-10 nanoseconds, [1-9][0-9]{0,18}, at most i64::MAX; pairs only with post_reconstruction_strict_max_v1." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MaximumDurationThresholdSourceId#strategy_native>
    a owl:Class ;
    rdfs:label "strategy_native" ;
    rdfs:subClassOf chron:MaximumDurationThresholdSourceId ;
    skos:definition "The selected reconstruction strategy's own threshold, if it has one; pairs only with the strategy_native policy." ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#attribution>
    a owl:Class ;
    rdfs:label "attribution" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#construct>
    a owl:Class ;
    rdfs:label "construct" ;
    rdfs:subClassOf chron:MeasurementLayer ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#engagement>
    a owl:Class ;
    rdfs:label "engagement" ;
    rdfs:subClassOf chron:MeasurementLayer ;
    skos:definition "Device/app usage-engagement measurement (screen-on, app-in-foreground). RELATED to, but deliberately NOT equated with, BCIO \"participant engagement with behaviour change intervention\" (BCIO:013000): BCIO engagement is intervention-scoped whereas a chronicle app is generally not a behaviour-change intervention — hence relatedMatch, not closeMatch (doc 13 D3)." ;
    skos:relatedMatch BCIO:013000 ;
.

<https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#person>
    a owl:Class ;
