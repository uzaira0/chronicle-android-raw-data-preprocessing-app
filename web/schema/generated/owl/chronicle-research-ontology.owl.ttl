        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#zhu_2018_unlock_lock_v1>
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#unlock_to_lock_v1>
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#unlock_to_off_or_lock_v1>
    ) ;
    skos:definition "Canonical identifiers for device-level screen-session construction. The two source-sensitive strategies require a digest-bound capability sidecar and preserved physical source order; missing prerequisites refuse rather than falling back to Chronicle." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#chronicle_screen_interactive_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#parry_toth_2025_session_glance_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#unlock_to_lock_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#unlock_to_off_or_lock_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenSessionConstructionStrategyId#zhu_2018_unlock_lock_v1> ;
.

chron:TypingQuestionnaireResponseRecord
    a owl:Class ;
    rdfs:label "TypingQuestionnaireResponseRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:questionnaire_response_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:response_value_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:questionnaire_response_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:response_value_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:observed_property ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:observed_property ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:questionnaire_response_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:response_value_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:questionnaire_setting_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:questionnaire_setting_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:observed_property ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:questionnaire_item_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:questionnaire_item_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:questionnaire_setting_reference ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:questionnaire_item_label ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Individually identified supplied answer owned either by a token or text-change case's follow-up or separately by its typing trial's questionnaire association. Akpinar et al. pp18–19 §4.4.1 uses F for participant-reported error correction and T otherwise in the change task; the distinct word task uses F for a participant-reported typo and T otherwise. Neither means system agreement. ESM context and subjective-error instruments on pp7–8/32–33 are separate. Each answer references its own local definition. Null/omission/lexical JSON null and repeated values remain distinct; no raw join, scoring or recoding." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:CoverageCause
    a owl:Class ;
    rdfs:label "CoverageCause" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#shutdown_boundary>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unclean_power_loss>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#collector_reporting_gap>
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unknown>
    ) ;
    skos:definition """Best-supported cause of a coverage gap. A gap is an OBSERVABILITY condition — never asserted as physical inactivity.
NOT CURRENTLY COMPUTED. No path in the kernel produces any of these four values: the shipped day-coverage output is DayCoverageStatus, which classifies a day as usage / no_activity / no_data and offers no cause at all. This enum, and the CoverageAssessment class that carries it, are design-time vocabulary for a cause attribution the engine does not yet make. They are retained because the distinctions are the ones the event stream could support — Device Shutdown and Device Startup are already canonical EventTypeCode values and the screen-gating layer already reads device liveness — but an instance carrying a value here is an assertion by whoever wrote it, not a reading of this pipeline's output.""" ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#collector_reporting_gap> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#shutdown_boundary> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unclean_power_loss> ,
        <https://w3id.org/chronicle-usage-ontology/core/CoverageCause#unknown> ;
.

chron:GroupedRecordSelectionRuleId
    a owl:Class ;
    rdfs:label "GroupedRecordSelectionRuleId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#FIRST>
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#LAST>
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#DISCARD_SUMMARY_IF_NON_SUMMARY_EXISTS>
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#RETAIN_SUMMARIES_IF_PRESENT_ELSE_ALL>
    ) ;
    skos:definition "Which members of each candidate group survive; not a timestamp or tie-order rule." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#DISCARD_SUMMARY_IF_NON_SUMMARY_EXISTS> ,
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#FIRST> ,
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#LAST> ,
        <https://w3id.org/chronicle-usage-ontology/core/GroupedRecordSelectionRuleId#RETAIN_SUMMARIES_IF_PRESENT_ELSE_ALL> ;
.

chron:MethodProfileExecutionStatusId
    a owl:Class ;
    rdfs:label "MethodProfileExecutionStatusId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#executable>
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#blocked>
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#specification_only>
    ) ;
    skos:definition "Whole-profile execution state after every required setting, input, GUI control, receipt, and conformance gate is evaluated." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#blocked> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#executable> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodProfileExecutionStatusId#specification_only> ;
.

chron:ParameterSet
    a owl:Class ;
    rdfs:label "ParameterSet" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:parameter_set_sha256 ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:bindings ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterBinding ;
            owl:onProperty chron:bindings ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "A content-addressed configuration entity — a set of ParameterBindings over the plan's variables. NOT a Plan: the plan is the workflow; this binds its variables." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:QueryDefinition
    a owl:Class ;
    rdfs:label "QueryDefinition" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:query_request_fields ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:query_request_fields ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:query_outputs ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:query_dependencies ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:realizes_operations ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:query_outputs ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:query_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:OperationDefinition ;
            owl:onProperty chron:realizes_operations ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:query_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:query_group_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:query_group_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:query_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:query_group_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:QueryDefinition ;
            owl:onProperty chron:query_dependencies ;
        ] ;
    skos:broadMatch pplan:Step ;
    skos:definition "One physical computation and memoization boundary. Its realizes_operations links are prospective mappings and do not imply that those semantic operations were applied in a particular run." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:ScreenGatingRuleId
    a owl:Class ;
    rdfs:label "ScreenGatingRuleId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_and_liveness_v1>
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_witness_only>
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#strict_visual_only>
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#device_liveness_only>
    ) ;
    skos:definition "Canonical identifiers for the rule that decides which parts of an app session earn screen-gated credit. Chronicle's shipped rule is the intersection of two independently observed conditions: intervals where a screen event witnessed the screen ON (bridged across sub-auto-lock blips), and spans where the device was demonstrably alive (event cadence within the liveness tolerance, broken by a Device Startup). Naming the rule makes each conjunct selectable on its own, so a researcher can state which observation their measurement rests on instead of inheriting the intersection implicitly. The rule affects only the credited side output; the headline app-usage output is never changed by any value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#device_liveness_only> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_and_liveness_v1> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#screen_witness_only> ,
        <https://w3id.org/chronicle-usage-ontology/core/ScreenGatingRuleId#strict_visual_only> ;
.

chron:TaskActionRecord
    a owl:Class ;
    rdfs:label "TaskActionRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:action_content_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:action_content_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:action_content_json ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:app_identifier ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:app_identifier ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:task_action_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:task_action_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:app_identifier ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:assigned_role_labels ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:source_locators ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:task_action_id ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:action_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:assigned_role_labels ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:action_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:UsageInterval ;
            owl:onProperty chron:denotes_interval ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:action_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:denotes_interval ;
        ] ;
    skos:broadMatch prov:Entity ;
    skos:definition "Individually supplied member of its containing task or device-use session with optional action label, app identity, time, role labels and lexical content. S-ADL physical p25 Table11 distinguishes observed app/screen actions from extracted subtask roles. Missing/extra/tied-event handling and the automatic constructor are not inferred. Same labels or times do not merge members or create order. Supplied array order remains intact. Oulasvirta pp106–107 distinguishes all-user-action session membership from app-launch order; app identity is independently supplied, never extracted from labels. Hush Section6.1 distinguishes active-in-off from foreground-in-following-on membership." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:acquisition_deduplication
    a owl:DatatypeProperty ;
    rdfs:label "acquisition_deduplication" ;
    rdfs:range xsd:string ;
    skos:definition "Identity and disposition for repeated acquired observations." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:adapter_id
    a owl:DatatypeProperty ;
    rdfs:label "adapter_id" ;
    rdfs:range xsd:string ;
    skos:definition "Versioned source-layout adapter identity." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:adapter_version
    a owl:DatatypeProperty ;
    rdfs:label "adapter_version" ;
    rdfs:range xsd:string ;
    skos:definition "Exact source-layout adapter version." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:app_name
    a owl:DatatypeProperty ;
    rdfs:label "app_name" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied application label qualifying feature names, distinct from an optional package name; no package inference or taxonomy restriction." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:assessor_id
    a owl:DatatypeProperty ;
    rdfs:label "assessor_id" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional supplied assessor identity, distinct from the assessed participant_id. JCP2017 pp867–868 has one live interviewer and two video-review psychiatrists, each independently producing standard and app-incorporated judgments. The assessor belongs to the owning task and its assessments; null/omission leaves identity unknown. No clinician catalog, interview/video join or consensus is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:conformance_fixture_id
    a owl:DatatypeProperty ;
    rdfs:label "conformance_fixture_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identity of the source or source-derived fixture proving this exact executor binding." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:conformance_result_digest
    a owl:DatatypeProperty ;
    rdfs:label "conformance_result_digest" ;
    rdfs:range xsd:string ;
    skos:definition "Content digest of the passing conformance result for this exact setting and executor value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:diary_response_timezone
    a owl:DatatypeProperty ;
    rdfs:label "diary_response_timezone" ;
    rdfs:range xsd:string ;
    skos:definition "Timezone and day-boundary convention for prompts and responses." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:documentary_method_setting_ids
    a owl:DatatypeProperty ;
    rdfs:label "documentary_method_setting_ids" ;
    rdfs:range xsd:string ;
    skos:definition "Source statements retained for audit but not treated as selectable method values." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:event_code
    a owl:ObjectProperty ;
    rdfs:label "event_code" ;
    rdfs:range chron:EventTypeCode ;
    skos:definition "Canonical event type." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:evidence_value_json
    a owl:DatatypeProperty ;
    rdfs:label "evidence_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Lexical JSON token for a supplied evidence value; literal false/zero/null/string-false tokens and a supplied-unknown null field remain distinct without casts." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:history_record_origin
    a owl:ObjectProperty ;
    rdfs:label "history_record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Example versus supplied normalized history; not authenticated original rows." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:lookback
    a owl:DatatypeProperty ;
    rdfs:label "lookback" ;
    rdfs:range xsd:string ;
    skos:definition "Retrospective lookback rule." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:mapping_profile_id
    a owl:DatatypeProperty ;
    rdfs:label "mapping_profile_id" ;
    rdfs:range xsd:string ;
    skos:definition "Exact released source-layout mapping profile." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:mapping_profile_version
    a owl:DatatypeProperty ;
    rdfs:label "mapping_profile_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version of the released source-layout mapping profile." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_configuration_structure
    a owl:ObjectProperty ;
    rdfs:label "method_configuration_structure" ;
    rdfs:range chron:MethodConfigurationStructureId ;
    skos:definition "Relationship among this source's method specifications; never infer unreported cross-products." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_parameter_key
    a owl:DatatypeProperty ;
    rdfs:label "method_parameter_key" ;
    rdfs:range xsd:string ;
    skos:definition "Source or canonical parameter name." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:notification_item_id
    a owl:DatatypeProperty ;
    rdfs:label "notification_item_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied recurring-item reference scoped by profile/device/identity basis; conflicting or split identities are rejected rather than automatically merged across scopes." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:notification_title
    a owl:DatatypeProperty ;
    rdfs:label "notification_title" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized title text (My Phone and Me p.4 Table1); empty, null and omission remain distinct. Not notification content or an identity key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:observation_category
    a owl:DatatypeProperty ;
    rdfs:label "observation_category" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied category scope, independent of property/value; not a reconstructed app classifier. Null/omission remain distinct." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:observation_instant
    a owl:DatatypeProperty ;
    rdfs:label "observation_instant" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied opaque state-entry time token. Null/omission/empty stay distinct; no clock conversion or chronology inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:observed_entity_token
    a owl:DatatypeProperty ;
    rdfs:label "observed_entity_token" ;
    rdfs:range xsd:string ;
    skos:definition "Opaque supplied identity of the typed subject, including independently identified applications, categories and student courses. A course token is not a class/attendance occurrence ID; distinct observation IDs preserve those instances. Null/omission remains unknown, not an inferred app package, PID, UID equality, app/category membership or cross-observation join." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:overall_text
    a owl:DatatypeProperty ;
    rdfs:label "overall_text" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied case-context text, optionally withheld; not reconstructed from keyboard actions." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:profile_implementation_status
    a owl:ObjectProperty ;
    rdfs:label "profile_implementation_status" ;
    rdfs:range chron:MethodProfileExecutionStatusId ;
    skos:definition "Whole-profile execution status; executable requires every replication gate to pass." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:quantities
    a owl:ObjectProperty ;
    rdfs:label "quantities" ;
    rdfs:range chron:SampledQuantityRecord ;
    skos:definition "Independently retained supplied quantities; [] is empty membership, omission/null unknown. No sum, counter difference, reset repair or unit conversion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:relationship_label
    a owl:DatatypeProperty ;
    rdfs:label "relationship_label" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied nonblank relationship designation, not inferred causality, chronology or a source storage code." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:requested_cadence
    a owl:DatatypeProperty ;
    rdfs:label "requested_cadence" ;
    rdfs:range xsd:string ;
    skos:definition "Requested observation or prompt cadence." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:screenshot_artifact_id
    a owl:DatatypeProperty ;
    rdfs:label "screenshot_artifact_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identity of this event's screenshot in the supplied existing ArtifactRef catalog." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_actions
    a owl:ObjectProperty ;
    rdfs:label "session_actions" ;
    rdfs:range chron:TaskActionRecord ;
    skos:definition "Supplied device- or tracked-app-session-local action/activity membership in supplied array order; actions need not identify an app. Null/omission is unknown membership, [] supplied empty, never a reconstructed or complete-zero assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_quantities
    a owl:ObjectProperty ;
    rdfs:label "session_quantities" ;
    rdfs:range chron:SessionQuantityRecord ;
    skos:definition "Supplied session-owned quantities in preserved order; null/omission unknown and [] explicitly empty. Local IDs and definition/scope compatibility are checked by ingress, not inferred from action membership." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_event_time_token
    a owl:DatatypeProperty ;
    rdfs:label "source_event_time_token" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied opaque source-designated event-time token, independent of capture_instant. ScreenTK Figure3 calls its timestamp Unix event time; numeric unit, precision and conversion to the Figure2 capture-time representation are unreported. No parsing, clock conversion, timezone assignment or equality between the two time fields is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_extraction_id
    a owl:DatatypeProperty ;
    rdfs:label "source_extraction_id" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence-row identity from which this atomic setting was derived." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_method_variant_id
    a owl:DatatypeProperty ;
    rdfs:label "source_method_variant_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identity of the exact cohort, platform, protocol version, branch, or multiverse configuration represented by this profile." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_value_sha256
    a owl:DatatypeProperty ;
    rdfs:label "source_value_sha256" ;
    rdfs:range xsd:string ;
    skos:definition "SHA-256 identity of the complete preserved source value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:timezone
    a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:range xsd:string ;
    skos:definition "Original recording timezone (preserved)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:unresolved_method_setting_ids
    a owl:DatatypeProperty ;
    rdfs:label "unresolved_method_setting_ids" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence-blocked settings preventing complete configuration selection." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:DiaryTriggerKindId
    a owl:Class ;
    rdfs:label "DiaryTriggerKindId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#scheduled>
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#random>
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#event_triggered>
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#participant_initiated>
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#completion_relative>
    ) ;
    skos:definition "What causes a diary prompt or entry opportunity to become due." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#completion_relative> ,
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#event_triggered> ,
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#participant_initiated> ,
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#random> ,
        <https://w3id.org/chronicle-usage-ontology/core/DiaryTriggerKindId#scheduled> ;
.

chron:InteractionEventPayloadRoleId
    a owl:Class ;
    rdfs:label "InteractionEventPayloadRoleId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#screenshot>
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#view_hierarchy>
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#gesture>
    ) ;
    skos:definition "Payload roles within one captured UI interaction-event record, not independent input channels." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#gesture> ,
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#screenshot> ,
        <https://w3id.org/chronicle-usage-ontology/core/InteractionEventPayloadRoleId#view_hierarchy> ;
.

chron:MethodImplementationStatusId
    a owl:Class ;
    rdfs:label "MethodImplementationStatusId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#native>
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#external_executor>
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#specification_only>
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#refused_missing_signal>
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#unresolved>
    ) ;
    skos:definition "Whether Chronicle can execute a source-supported setting without silently approximating it." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#external_executor> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#native> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#refused_missing_signal> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#specification_only> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodImplementationStatusId#unresolved> ;
.

chron:NotificationContextSamplingBoundaryId
    a owl:Class ;
    rdfs:label "NotificationContextSamplingBoundaryId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#arrival>
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#removal>
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#interruption>
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#posting>
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#source_unreported>
    ) ;
    skos:definition "Collection boundary of supplied item-linked context; distinct from a feature's retrospective window or a verified sample timestamp." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#arrival> ,
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#interruption> ,
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#posting> ,
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#removal> ,
        <https://w3id.org/chronicle-usage-ontology/core/NotificationContextSamplingBoundaryId#source_unreported> ;
.

chron:QueryExecutionStatus
    a owl:Class ;
    rdfs:label "QueryExecutionStatus" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#cached>
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#recomputed>
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#error>
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#skipped>
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#bypassed>
    ) ;
    skos:definition "Observed state of one physical query in a runtime execution." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#bypassed> ,
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#cached> ,
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#error> ,
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#recomputed> ,
        <https://w3id.org/chronicle-usage-ontology/core/QueryExecutionStatus#skipped> ;
.

chron:AssociationContextItemRecord
    a owl:Class ;
    rdfs:label "AssociationContextItemRecord" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:context_item_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:context_item_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:context_dimension ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty chron:context_item_label ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:context_dimension ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:context_dimension ;
        ] ;
    skos:definition "Context item value with an optional supplied dimension. Habitual physical p14 Figure5 distinguishes notification, period, time, location and activity from app labels. Missing dimension is not inferred from a label; equal labels in different dimensions remain distinct. Array order is preserved as supplied, never interpreted as chronology." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:EndpointStatus
    a owl:Class ;
    rdfs:label "EndpointStatus" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored>
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored>
    ) ;
    skos:definition "Observation-endpoint qualification for a derived interval. Under RDF open-world semantics a missing endpoint is UNKNOWN, not observed-absent — so absence is always an explicit status, never a null result." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#interval_censored> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#observed> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#right_censored> ,
        <https://w3id.org/chronicle-usage-ontology/core/EndpointStatus#unobserved> ;
.

chron:MethodDisclosureStatusId
    a owl:Class ;
    rdfs:label "MethodDisclosureStatusId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#declared>
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#declared_partial>
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#delegated>
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#absent>
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#not_applicable>
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#undetermined>
    ) ;
    skos:definition "Normalized disclosure state; access depth and implementation state remain separate." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#absent> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#declared> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#declared_partial> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#delegated> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#not_applicable> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodDisclosureStatusId#undetermined> ;
.

chron:SessionGroupingPolicyId
    a owl:Class ;
    rdfs:label "SessionGroupingPolicyId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#none>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#church_5s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#smartphone_wellbeing_strict_lt_5s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#grosse_deters_10s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#ross_15s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#van_berkel_45s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#zerrer_60s>
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#peng_zhu_2020_participant_median>
    ) ;
    skos:definition "Canonical identifiers for the named usage-session grouping rules. A THIRD axis, crossed with the two above: reconstruction decides episode boundaries, interval quality bounds an implausible episode, and this groups finished episodes into usage sessions. Most members differ only in their gap constant, so the comparison operator and any package clause are the load-bearing differences and are stated per value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#church_5s> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#grosse_deters_10s> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#none> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#peng_zhu_2020_participant_median> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#ross_15s> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#smartphone_wellbeing_strict_lt_5s> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#van_berkel_45s> ,
        <https://w3id.org/chronicle-usage-ontology/core/SessionGroupingPolicyId#zerrer_60s> ;
.

chron:day_observation_id
    a owl:DatatypeProperty ;
    rdfs:label "day_observation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied observation identity scoped by profile/participant/period kind/token, not a raw join key; legacy day-named transport supports explicit hour ownership." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_settings
    a owl:ObjectProperty ;
    rdfs:label "method_settings" ;
    rdfs:range chron:MethodSettingAssertion ;
    skos:definition "Source-supported settings in this profile or subprotocol." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:MethodExecutionRouteId
    a owl:Class ;
    rdfs:label "MethodExecutionRouteId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#native_option_binding>
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#protocol_input>
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#native_operator_parameter>
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#external_named_executor>
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#receipt_conformance>
    ) ;
    skos:definition "Exact destination through which a source-supported setting participates in replication." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#external_named_executor> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#native_operator_parameter> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#native_option_binding> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#protocol_input> ,
        <https://w3id.org/chronicle-usage-ontology/core/MethodExecutionRouteId#receipt_conformance> ;
.

chron:date
    a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:date ;
    skos:definition "Local calendar date the row is attributed to, in the run's output timezone (see TimezoneNormalizationPolicyId) and under the selected DayBoundaryAttributionId." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:device_use_session_reference
    a owl:DatatypeProperty ;
    rdfs:label "device_use_session_reference" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional explicitly supplied parent device-session ID. Exact source-compatible children resolve one unique same-profile/work/participant parent with compatible known device; unknown device never selects among multiple parents. Null/omission remains unknown. No clock or raw join is inferred." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:evidence_unit
    a owl:DatatypeProperty ;
    rdfs:label "evidence_unit" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied unit for this quantity alone; no numeric conversion or inferred unit." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:label_record_id
    a owl:DatatypeProperty ;
    rdfs:label "label_record_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied label identity unique within its owning session, independent of equal property or value tokens." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:label_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "label_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Compatible classification-defining local method setting, not a constructor, result statistic or execution receipt." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:label_value_json
    a owl:DatatypeProperty ;
    rdfs:label "label_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Optional supplied lexical JSON classification value; no scoring, coercion or missing-to-negative conversion. Omission, supplied null and lexical JSON null remain distinct." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:measurement_layer
    a owl:ObjectProperty ;
    rdfs:label "measurement_layer" ;
    rdfs:range chron:MeasurementLayer ;
    skos:definition "Measurement-model layer." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_boundary_convention
    a owl:DatatypeProperty ;
    rdfs:label "method_boundary_convention" ;
    rdfs:range xsd:string ;
    skos:definition "Inclusivity, clipping, ordering, or calendar convention required to interpret the value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_comparator
    a owl:DatatypeProperty ;
    rdfs:label "method_comparator" ;
    rdfs:range xsd:string ;
    skos:definition "Boundary comparator such as less-than, at-most, or inclusive-between." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_setting_id
    a owl:DatatypeProperty ;
    rdfs:label "method_setting_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identity of one source-supported setting assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_target_layer
    a owl:ObjectProperty ;
    rdfs:label "method_target_layer" ;
    rdfs:range chron:MethodTargetLayerId ;
    skos:definition "Layer affected by the setting." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_unit
    a owl:DatatypeProperty ;
    rdfs:label "method_unit" ;
    rdfs:range xsd:string ;
    skos:definition "Unit attached to the value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_value_json
    a owl:DatatypeProperty ;
    rdfs:label "method_value_json" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical JSON serialization of the complete source-declared value." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:occurrence_instant
    a owl:DatatypeProperty ;
    rdfs:label "occurrence_instant" ;
    rdfs:range xsd:string ;
    skos:definition "When the occurrence happened." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:questionnaire_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "questionnaire_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to a compatible disclosed response-scale definition within the owning profile/source, not an invitation or reported result; unknown instrument details remain on that source definition." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:reconstructed_by
    a owl:ObjectProperty ;
    rdfs:label "reconstructed_by" ;
    rdfs:range chron:ReconstructionExecution ;
    skos:definition "The execution that produced this assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_action_reference
    a owl:DatatypeProperty ;
    rdfs:label "session_action_reference" ;
    rdfs:range
        [
            a rdfs:Datatype ;
            owl:intersectionOf (
                xsd:string

                [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (

                        [
                            xsd:pattern "\\S" ;
                        ]
                    ) ;
                ]
            ) ;
        ] ;
    skos:definition "Optional explicitly supplied action/foreground-period or unlock-attempt ID local to the explicitly referenced parent device session. A nonnull action requires its parent; known app/role contradictions reject without inferring unknown membership or timing." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:session_record_origin
    a owl:ObjectProperty ;
    rdfs:label "session_record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Constructed example versus supplied normalized session; neither authenticates source rows." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:used_parameter_set
    a owl:ObjectProperty ;
    rdfs:label "used_parameter_set" ;
    rdfs:range chron:ParameterSet ;
    skos:definition "The ParameterSet the execution used." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:MeasurementLayer
    a owl:Class ;
    rdfs:label "MeasurementLayer" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#construct>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#validity>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#presence>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#engagement>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#person>
        <https://w3id.org/chronicle-usage-ontology/core/MeasurementLayer#attribution>
    ) ;
