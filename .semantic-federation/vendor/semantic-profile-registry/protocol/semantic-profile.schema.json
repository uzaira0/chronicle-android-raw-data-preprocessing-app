{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzaira0:semantic-federation:protocol:semantic-profile:0.1",
  "title": "Semantic profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "profile_id",
    "version",
    "title",
    "profile_kind",
    "namespace",
    "standards",
    "dependencies",
    "resources",
    "conformance_classes",
    "licenses"
  ],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/exactVersion" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "profile_kind": { "enum": ["shared", "product", "canary"] },
    "namespace": { "$ref": "#/$defs/identifier" },
    "standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/standard" },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" },
      "uniqueItems": true
    },
    "conformance_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/conformanceClass" },
      "uniqueItems": true
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" },
      "uniqueItems": true,
      "default": []
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relation", "confidence"],
        "properties": {
          "source": { "$ref": "#/$defs/identifier" },
          "target": { "$ref": "#/$defs/identifier" },
          "relation": { "enum": ["exact", "close", "broad", "narrow", "related"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "direction": { "enum": ["forward", "reverse", "bidirectional"] }
        }
      },
      "default": []
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "since", "remove_after", "replacement"],
        "properties": {
          "identifier": { "$ref": "#/$defs/identifier" },
          "since": { "$ref": "#/$defs/exactVersion" },
          "remove_after": { "type": "string", "format": "date" },
          "replacement": { "$ref": "#/$defs/identifier" }
        }
      },
      "default": []
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(urn:[A-Za-z0-9][A-Za-z0-9:._-]*|https://[^\\s]+)$"
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "uri", "license"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "manifest_digest"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/exactVersion" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "role", "digest"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "media_type": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["ontology", "shape", "query", "fixture", "mapping", "migration", "license", "documentation", "binding-source"]
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "conformanceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "determinism"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean" },
        "determinism": { "enum": ["byte-exact", "canonical-rdf", "numeric-tolerance", "semantic"] },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_id", "version", "manifest_digest"],
      "properties": {
        "extension_id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/exactVersion" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
