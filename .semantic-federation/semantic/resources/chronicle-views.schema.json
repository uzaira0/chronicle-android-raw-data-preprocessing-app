{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzaira0:semantic-federation:chronicle-preprocessing:views/0.1",
  "title": "Chronicle typed multidimensional views",
  "oneOf": [
    {"$ref": "#/$defs/stageView"},
    {"$ref": "#/$defs/artifactView"},
    {"$ref": "#/$defs/obligationView"},
    {"$ref": "#/$defs/temporalSubjectView"},
    {"$ref": "#/$defs/explanationView"},
    {"$ref": "#/$defs/assuranceView"}
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["view_id", "family", "schema_id", "revision", "root_digest", "payload"],
      "properties": {
        "view_id": {"type": "string"},
        "family": {"const": "incremental-dataflow"},
        "schema_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0},
        "root_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "stageView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "view_id": {"const": "chronicle.stage.v1"},
            "schema_id": {"const": "urn:chronicle:view:stage:v1"},
            "payload": {
              "type": "object",
              "required": ["node_states"],
              "properties": {
                "stage": {"enum": ["preprocess", "clean", "analyze", "output", null]},
                "node_states": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["node_id", "materialization_state"],
                    "properties": {
                      "node_id": {"type": "string"},
                      "materialization_state": {"enum": ["open", "ready", "satisfied", "blocked", "invalid", "not_applicable"]},
                      "execution_status": {"enum": ["cached", "recomputed", "error", "skipped", "bypassed", null]},
                      "reason_ids": {"type": "array", "items": {"type": "string"}}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "artifactView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {
          "properties": {
            "view_id": {"const": "chronicle.artifact.v1"},
            "schema_id": {"const": "urn:chronicle:view:artifact:v1"},
            "payload": {
              "type": "object",
              "required": ["artifacts", "assignments"],
              "properties": {
                "artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "digest", "media_type"], "properties": {"artifact_id": {"type": "string"}, "digest": {"type": "string"}, "media_type": {"type": "string"}, "derived_from": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
                "assignments": {"type": "array", "items": {"type": "object", "required": ["assignment_id", "role_id", "artifact_id"], "properties": {"assignment_id": {"type": "string"}, "role_id": {"type": "string"}, "artifact_id": {"type": "string"}, "qualifiers": {"type": "object"}}, "additionalProperties": false}}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "obligationView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"view_id": {"const": "chronicle.obligation.v1"}, "schema_id": {"const": "urn:chronicle:view:obligation:v1"}, "payload": {"type": "object", "required": ["obligations"], "properties": {"obligations": {"type": "array", "items": {"type": "object", "required": ["obligation_id", "role_id", "state", "reason_id"], "properties": {"obligation_id": {"type": "string"}, "role_id": {"type": "string"}, "node_id": {"type": ["string", "null"]}, "state": {"enum": ["open", "blocked", "invalid"]}, "reason_id": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false}}}
      ]
    },
    "temporalSubjectView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"view_id": {"const": "chronicle.temporal-subject.v1"}, "schema_id": {"const": "urn:chronicle:view:temporal-subject:v1"}, "payload": {"type": "object", "required": ["subject_ids", "artifact_ids"], "properties": {"subject_ids": {"type": "array", "items": {"type": "string"}}, "start": {"type": ["string", "null"], "format": "date-time"}, "end": {"type": ["string", "null"], "format": "date-time"}, "artifact_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}}
      ]
    },
    "explanationView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"view_id": {"const": "chronicle.explanation.v1"}, "schema_id": {"const": "urn:chronicle:view:explanation:v1"}, "payload": {"type": "object", "required": ["transitions"], "properties": {"transitions": {"type": "array", "items": {"type": "object", "required": ["transition_id", "subject_id", "to_state", "reason_id", "source_id"], "properties": {"transition_id": {"type": "string"}, "subject_id": {"type": "string"}, "from_state": {"type": ["string", "null"]}, "to_state": {"type": "string"}, "reason_id": {"type": "string"}, "source_id": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false}}}
      ]
    },
    "assuranceView": {
      "allOf": [
        {"$ref": "#/$defs/envelope"},
        {"properties": {"view_id": {"const": "chronicle.assurance.v1"}, "schema_id": {"const": "urn:chronicle:view:assurance:v1"}, "payload": {"type": "object", "required": ["profile_lock_digest", "closure_digest", "conforms"], "properties": {"profile_lock_digest": {"type": "string"}, "closure_digest": {"type": "string"}, "conforms": {"type": "boolean"}, "failed_check_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}}
      ]
    }
  }
}
