.

chron:phrase_id
    a owl:DatatypeProperty ;
    rdfs:label "phrase_id" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied normalized child identity local to its owning capture, not text equality or a recovered raw node key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:phrase_left_px
