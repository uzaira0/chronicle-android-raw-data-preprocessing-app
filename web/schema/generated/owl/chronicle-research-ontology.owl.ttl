            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:app_package_name ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:app_package_name ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:date ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:screen_gating_rule ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:ParameterSet ;
            owl:onProperty chron:cites_parameter_set ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
