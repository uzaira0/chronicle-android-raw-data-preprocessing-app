chron:referenced_hour_token
    a owl:DatatypeProperty ;
    rdfs:label "referenced_hour_token" ;
    rdfs:range xsd:string ;
    skos:definition "Explicitly supplied opaque identity of a particular one-hour period, not an hour-of-day bucket, day or night. Mutually exclusive with day/night tokens; no endpoints, timezone or timestamp join inferred (CHI2020 Paper36 p5 CCM)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:referenced_night_token
    a owl:DatatypeProperty ;
    rdfs:label "referenced_night_token" ;
    rdfs:range xsd:string ;
    skos:definition "Explicitly supplied opaque identity of the night described, not a calendar day, prompt time, source serializer or inferred sleep interval. Mutually exclusive with day/hour tokens; no endpoints or preceding/following day recovered (Murnane2016 pp3,7–8)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:referenced_day_token
    a owl:DatatypeProperty ;
    rdfs:label "referenced_day_token" ;
    rdfs:range xsd:string ;
    skos:definition "Explicitly supplied opaque identity of the day described, mutually exclusive with hour/night tokens; not substituted from prompt/submission time, parsed, calendar-normalized or timezone-converted." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_setting_reference
    a owl:DatatypeProperty ;
    rdfs:label "method_setting_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Local profile-owned source definition reference checked for the record's role/target at ingress; not a record identifier, execution receipt or raw-row authentication." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:denotes_interval
    a owl:ObjectProperty ;
    rdfs:label "denotes_interval" ;
    rdfs:range chron:UsageInterval ;
    skos:definition "The phenomenon-time interval this assertion denotes." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:device_id
    a owl:DatatypeProperty ;
    rdfs:label "device_id" ;
    rdfs:range xsd:string ;
    skos:definition "Device identifier." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:method_profile_id
    a owl:DatatypeProperty ;
    rdfs:label "method_profile_id" ;
    rdfs:range xsd:string ;
    skos:definition "Stable identifier for the versioned method profile." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_work_id
    a owl:DatatypeProperty ;
    rdfs:label "source_work_id" ;
    rdfs:range xsd:string ;
    skos:definition "Canonical citation identity of the source work." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:participant_id
    a owl:DatatypeProperty ;
    rdfs:label "participant_id" ;
    rdfs:range xsd:string ;
    skos:definition "Participant/device identifier (string, always)." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:source_locators
    a owl:DatatypeProperty ;
    rdfs:label "source_locators" ;
    rdfs:range xsd:string ;
    skos:definition "Source locations supporting this assertion." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

