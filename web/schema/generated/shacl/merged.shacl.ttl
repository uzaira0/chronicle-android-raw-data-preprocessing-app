PREFIX chron: <https://w3id.org/chronicle-usage-ontology/core/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

chron:AttributionAssertionContractShape
    a sh:NodeShape ;
    sh:message "An unresolved attribution (person == None/blank) must not name an attributed_person." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path chron:attributed_person ;
                ] ,
                [
                    sh:hasValue "unresolved" ;
                    sh:minCount 1 ;
                    sh:path chron:attribution_status ;
                ] ;
        ] ;
    sh:targetClass chron:AttributionAssertion ;
.

chron:CoverageAssessmentShape
    a sh:NodeShape ;
    sh:message "A no-data assessment (actually_available = false) requires expected_available to be stated." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:expected_available ;
                ] ,
                [
                    sh:hasValue false ;
                    sh:minCount 1 ;
                    sh:path chron:actually_available ;
                ] ;
        ] ;
    sh:targetClass chron:CoverageAssessment ;
.

chron:EffectiveUsageProvenanceShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "An effective-usage measure must name the operation execution that produced it." ;
            sh:minCount 1 ;
            sh:path chron:produced_by ;
        ] ,
        [
            sh:message "An effective-usage measure must cite the ParameterSet it was produced under." ;
            sh:minCount 1 ;
            sh:path chron:cites_parameter_set ;
        ] ;
    sh:targetClass chron:EffectiveUsageMeasure ;
.

chron:OperationExecutionContractShape
    a sh:NodeShape ;
    sh:message "A node execution that records a start must record its end." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path prov:startedAtTime ;
                ] ,
                [
                    sh:maxCount 0 ;
                    sh:path prov:endedAtTime ;
                ] ;
        ] ,
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:minCount 1 ;
                    sh:path chron:started_at ;
                ] ,
                [
                    sh:maxCount 0 ;
                    sh:path chron:ended_at ;
                ] ;
        ] ;
    sh:property
        [
            sh:message "An operation execution must cite the ParameterSet it ran under." ;
            sh:minCount 1 ;
            sh:path chron:used_parameter_set ;
        ] ,
        [
            sh:message "An operation execution must name the OperationDefinition it realizes." ;
            sh:minCount 1 ;
            sh:path chron:executes_operation ;
        ] ;
    sh:targetClass chron:OperationExecution ;
.

chron:QueryExecutionContractShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A query execution must cite the ParameterSet it ran under." ;
            sh:minCount 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:QueryExecution ;
.

chron:UsageEpisodeProvenanceShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A usage episode assertion must be reconstructed_by an execution." ;
            sh:minCount 1 ;
            sh:path chron:reconstructed_by ;
        ] ;
    sh:targetClass chron:UsageEpisodeAssertion ;
.

chron:UsageIntervalEndpointShape
    a sh:NodeShape ;
    sh:message "An endpoint marked 'observed' must carry its instant." ;
    sh:not
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:end_instant ;
                ] ,
                [
                    sh:hasValue "observed" ;
                    sh:minCount 1 ;
                    sh:path chron:end_status ;
                ] ;
        ] ,
        [
            a sh:NodeShape ;
            sh:property
                [
                    sh:maxCount 0 ;
                    sh:path chron:start_instant ;
                ] ,
                [
                    sh:hasValue "observed" ;
                    sh:minCount 1 ;
                    sh:path chron:start_status ;
                ] ;
        ] ;
    sh:targetClass chron:UsageInterval ;
.

chron:GlanceAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim that the screen activated then deactivated without an unlock. Derived prov:Entity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:GlanceAssertion ;
.

chron:LoggingObservation
    a sh:NodeShape ;
    rdfs:comment "OPTIONAL. The OS logger's act of observing a device property, modeled only if that abstraction is genuinely needed. Do NOT type UsageEventRecord as this." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "The device property the logger observed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:observed_property ;
        ] ,
        [
            sh:class chron:UsageEventRecord ;
            sh:description "The event record produced by the logging observation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:result_record ;
        ] ;
    sh:targetClass chron:LoggingObservation ;
.

chron:UsageSessionAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim of continuous device use between unlock and lock. Derived prov:Entity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:UsageSessionAssertion ;
.

chron:WorkflowPlan
    a sh:NodeShape ;
    rdfs:comment "The prospective processing workflow. A p-plan:Plan / prov:Plan." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:QueryDefinition ;
            sh:description "Physical queries in the workflow." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path chron:queries ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Semantic operations in the workflow." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path chron:operations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Plan identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:plan_id ;
        ] ;
    sh:targetClass chron:WorkflowPlan ;
.

chron:CoverageAssessment
    a sh:NodeShape ;
    rdfs:comment "A coverage/observability judgement over a stream window: expected vs actual data availability, its threshold, bounding events, and best-supported cause. A gap MAY CONCEAL usage — this asserts only how the measurement policy treats the interval, never that the device was inactive." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether any data was actually present." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:actually_available ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether data was expected to be available (needs a heartbeat/expectation to assert NoData)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:expected_available ;
        ] ,
        [
            sh:description "Best-supported cause." ;
            sh:in (
                "shutdown_boundary"
                "unclean_power_loss"
                "collector_reporting_gap"
                "unknown"
            ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path chron:coverage_cause ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "How the measurement policy treats this interval (e.g. pass / na / exclude)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:policy_treatment ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Coverage threshold applied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:availability_threshold ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The stream window assessed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:assesses_interval ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:participant_id ;
        ] ;
    sh:targetClass chron:CoverageAssessment ;
.

chron:EffectiveUsageMeasure
    a sh:NodeShape ;
    rdfs:comment "The effective-usage duration (episode interval intersected with active coverage, per a named policy). Cites the ParameterSet and execution that produced it. NOT asserted as physical truth — carries the coverage policy that produced it." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Named policy for how coverage gaps were treated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:coverage_policy ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:description "Study/local date the measure is assigned to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:date ;
        ] ,
        [
            sh:class chron:OperationExecution ;
            sh:description "The operation execution that produced this measure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path chron:produced_by ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Effective usage minutes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:effective_minutes ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet under which this measure was produced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path chron:cites_parameter_set ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:EffectiveUsageMeasure ;
.

chron:ParameterBinding
    a sh:NodeShape ;
    rdfs:comment "One knob = value binding within a ParameterSet." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Option/knob key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:knob_key ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Bound value (canonical JSON string)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:knob_value ;
        ] ;
    sh:targetClass chron:ParameterBinding ;
.

chron:PlatformEventOccurrence
    a sh:NodeShape ;
    rdfs:comment "The real-world Android lifecycle/system occurrence (an app resuming, the screen turning off, a shutdown). This is the thing that happened in the world — NOT the logged record and NOT an observation. Deliberately untyped as sosa:Observation." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "When the occurrence happened." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path time:inXSDDateTimeStamp ;
        ] ,
        [
            sh:description "Canonical event type." ;
            sh:in (
                "activity_resumed"
                "activity_paused"
                "activity_stopped"
                "screen_interactive"
                "screen_non_interactive"
                "keyguard_shown"
                "keyguard_hidden"
                "device_shutdown"
                "device_startup"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:event_code ;
        ] ;
    sh:targetClass chron:PlatformEventOccurrence ;
.

chron:QueryExecution
    a sh:NodeShape ;
    rdfs:comment "Retrospective evidence for one physical query. Kept distinct from OperationExecution because a fused query can realize several semantic operations with different applicability." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Observed physical execution state." ;
            sh:in (
                "cached"
                "recomputed"
                "error"
                "skipped"
                "bypassed"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path chron:query_execution_status ;
        ] ,
        [
            sh:class chron:QueryDefinition ;
            sh:description "The QueryDefinition this execution realizes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path chron:executes_query ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:description "Evidence timestamp for the query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:startedAtTime ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content identity of the query's exact effective inputs." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:query_input_key ;
        ] ,
        [
            sh:class chron:OperationExecution ;
            sh:description "Root workflow execution containing this query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:isPartOf ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Content identity of the query output." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:query_output_digest ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:description "Evidence timestamp for the query execution." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:endedAtTime ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of the evidence supporting the state." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:query_reason_id ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:QueryExecution ;
.

chron:ReconstructionStrategy
    a sh:NodeShape ;
    rdfs:comment "A named, versioned episode-reconstruction algorithm (semantic category + canonical IRI). Subclass only where formal restrictions genuinely differ." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Canonical strategy category (IRI-bearing enum value)." ;
            sh:in (
                "parry_toth_forward_pairing"
                "fused_matcher"
                "eyes_complement"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:strategy_kind ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Strategy version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:strategy_version ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Strategy identifier (unique key)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:strategy_id ;
        ] ,
        [
            sh:datatype xsd:anyURI ;
            sh:description "Canonical IRI carried by the runtime enum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:canonical_iri ;
        ] ;
    sh:targetClass chron:ReconstructionStrategy ;
.

chron:UsageEpisodeAssertion
    a sh:NodeShape ;
    rdfs:comment "A claim that one app was in continuous use over an interval. A derived prov:Entity (what the pipeline asserts, not a ground truth)." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:AttributionAssertion ;
            sh:description "Person attribution for this episode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path chron:attribution ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:description "Measurement-model layer." ;
            sh:in (
                "construct"
                "validity"
                "presence"
                "engagement"
                "person"
                "attribution"
            ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path chron:measurement_layer ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:app_package_name ;
        ] ,
        [
            sh:class chron:ReconstructionExecution ;
            sh:description "The execution that produced this assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path chron:reconstructed_by ;
        ] ,
        [
            sh:class chron:UsageInterval ;
            sh:description "The phenomenon-time interval this assertion denotes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path chron:denotes_interval ;
        ] ;
    sh:targetClass chron:UsageEpisodeAssertion ;
.

chron:UsageEventRecord
    a sh:NodeShape ;
    rdfs:comment "The logged information artifact for one Android usage event. A prov:Entity, not an observation." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Device identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:device_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android activity class name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:app_class_name ;
        ] ,
        [
            sh:description "Canonical event type." ;
            sh:in (
                "activity_resumed"
                "activity_paused"
                "activity_stopped"
                "screen_interactive"
                "screen_non_interactive"
                "keyguard_shown"
                "keyguard_hidden"
                "device_shutdown"
                "device_startup"
            ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path chron:event_code ;
        ] ,
        [
            sh:class chron:PlatformEventOccurrence ;
            sh:description "The real-world occurrence this record logs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path chron:records_occurrence ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Original recording timezone (preserved)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:timezone ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Event timestamp in nanoseconds since epoch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:event_timestamp_ns ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Participant/device identifier (string, always)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:participant_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Android package name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:app_package_name ;
        ] ;
    sh:targetClass chron:UsageEventRecord ;
.

chron:AttributionAssertion
    a sh:NodeShape ;
    rdfs:comment "Attribution of usage to a person. Exactly one status is required; an actual person is attached only when known. The participant-device-day denominator must satisfy duration conservation: target + known_non_target + unresolved = eligible." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether the device is shared." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:on_shared_device ;
        ] ,
        [
            sh:description "Required attribution status." ;
            sh:in (
                "target"
                "known_non_target"
                "unresolved"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path chron:attribution_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The actual person, attached only when known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:attributed_person ;
        ] ;
    sh:targetClass chron:AttributionAssertion ;
.

chron:OperationExecution
    a sh:NodeShape ;
    rdfs:comment "A retrospective execution of an OperationDefinition. A prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Stable workflow-execution identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:execution_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Execution end." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:ended_at ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Execution start." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:started_at ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "The OperationDefinition this execution realizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path chron:executes_operation ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:OperationExecution ;
.

chron:QueryDefinition
    a sh:NodeShape ;
    rdfs:comment "One physical computation and memoization boundary. Its realizes_operations links are prospective mappings and do not imply that those semantic operations were applied in a particular run." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Independently identified output artifacts or ports." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:query_outputs ;
        ] ,
        [
            sh:class chron:QueryDefinition ;
            sh:description "Direct upstream physical queries." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path chron:query_dependencies ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable physical-query identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:query_id ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "Semantic operations this query may realize." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path chron:realizes_operations ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Exact request fields read by the query." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:query_request_fields ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Presentation-only query-group identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:query_group_id ;
        ] ;
    sh:targetClass chron:QueryDefinition ;
.

chron:ReconstructionExecution
    a sh:NodeShape ;
    rdfs:comment "The execution that produced a usage assertion. A prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:class chron:ReconstructionStrategy ;
            sh:description "The reconstruction strategy followed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path chron:follows_strategy ;
        ] ,
        [
            sh:class chron:ParameterSet ;
            sh:description "The ParameterSet the execution used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:used_parameter_set ;
        ] ;
    sh:targetClass chron:ReconstructionExecution ;
.

chron:OperationDefinition
    a sh:NodeShape ;
    rdfs:comment "One semantic operation in the workflow at any useful scale. Operations compose recursively via part_of_operation so a coarse responsibility and its independently invalidatable transformations share one model without forcing presentation and execution boundaries to coincide." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:boolean ;
            sh:description "Whether a failure fails the whole workflow." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path chron:is_fatal ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Operations that must precede this one." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path chron:depends_on ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Channels or inputs the operation reads." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path chron:consumes ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Named algorithm or engine the operation realizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path chron:engine ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Whether the operation observes, infers, applies policy, or presents." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path chron:epistemic_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable semantic operation identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:operation_id ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Channels or outputs the operation produces." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path chron:produces ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Semantic responsibility of the operation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path chron:operation_role ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Declared effects such as preserve, drop, split, classify, or encode." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path chron:data_effects ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Action the operation performs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:verb ;
        ] ,
        [
            sh:class chron:OperationDefinition ;
            sh:description "The coarser semantic operation this operation is a proper part of. Referenced by operation_id, not inlined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:isPartOf ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Direct configuration fields read by this operation." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path chron:configuration_dependencies ;
        ] ;
    sh:targetClass chron:OperationDefinition ;
.

chron:ParameterSet
    a sh:NodeShape ;
    rdfs:comment "A content-addressed configuration entity — a set of ParameterBindings over the plan's variables. NOT a Plan: the plan is the workflow; this binds its variables." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:description "Content-addressed hash of the canonical parameter set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:parameter_set_sha256 ;
        ] ,
        [
            sh:class chron:ParameterBinding ;
            sh:description "Knob=value bindings." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path chron:bindings ;
        ] ;
    sh:targetClass chron:ParameterSet ;
.

chron:UsageInterval
    a sh:NodeShape ;
    rdfs:comment "A phenomenon-time interval a usage assertion denotes. A time:ProperInterval." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property
        [
            sh:description "Endpoint status of the end." ;
            sh:in (
                "observed"
                "unobserved"
                "right_censored"
                "interval_censored"
            ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path chron:end_status ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Interval end instant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path chron:end_instant ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Interval start instant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:start_instant ;
        ] ,
        [
            sh:datatype xsd:float ;
            sh:description "Interval duration in seconds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path qudt:hasQuantityValue ;
        ] ,
        [
            sh:description "Endpoint status of the start." ;
            sh:in (
                "observed"
                "unobserved"
                "right_censored"
                "interval_censored"
            ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path chron:start_status ;
        ] ;
    sh:targetClass chron:UsageInterval ;
.
