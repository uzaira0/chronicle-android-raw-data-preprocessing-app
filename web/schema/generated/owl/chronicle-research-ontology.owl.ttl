.

chron:screenshots
    a owl:ObjectProperty ;
    rdfs:label "screenshots" ;
    rdfs:range chron:SessionScreenshotRecord ;
    skos:definition "Supplied screenshot members in preserved array order; [] means explicitly empty supplied membership, not a complete original capture claim." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:selected_element_ids
    a owl:DatatypeProperty ;
    rdfs:label "selected_element_ids" ;
