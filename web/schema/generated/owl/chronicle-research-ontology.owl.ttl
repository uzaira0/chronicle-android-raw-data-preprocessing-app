chron:UsageInterval
    a owl:Class ;
    rdfs:label "UsageInterval" ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:EndpointStatus ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:end_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom chron:EndpointStatus ;
            owl:onProperty chron:start_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty chron:duration_seconds ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:end_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty chron:start_status ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:start_instant ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty chron:start_status ;
        ] ;
    skos:broadMatch time:ProperInterval ;
    skos:definition "A phenomenon-time interval a usage assertion denotes. A time:ProperInterval." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:questionnaire_item_label
    a owl:DatatypeProperty ;
    rdfs:label "questionnaire_item_label" ;
    rdfs:range xsd:string ;
    skos:definition "Supplied questionnaire item label; not an invented raw schema key." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:day_observation_kind
    a owl:ObjectProperty ;
    rdfs:label "day_observation_kind" ;
    rdfs:range chron:ParticipantDayObservationKindId ;
    skos:definition "Objective period aggregate, subjective response or run-owned modality availability; none substitutes for another. Legacy day-named transport key retains explicitly supplied owner kinds." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:referenced_run_token
    a owl:DatatypeProperty ;
    rdfs:label "referenced_run_token" ;
    rdfs:range xsd:string ;
    skos:definition "Explicitly supplied opaque collection/assessment-run identity for participant modality availability (Moodable primary508–517,603–611,685–689). Not a day/hour/night, model campaign, clock or original repeated-participation claim; mutually exclusive with period tokens." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:observed_property
    a owl:DatatypeProperty ;
    rdfs:label "observed_property" ;
    rdfs:range xsd:string ;
    skos:definition "The device property the logger observed." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:InteractionTraceRecordOriginId
    a owl:Class ;
    rdfs:label "InteractionTraceRecordOriginId" ;
    owl:unionOf (
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTraceRecordOriginId#analyst_constructed_example>
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTraceRecordOriginId#supplied_normalized_records>
    ) ;
    skos:definition "Epistemic status of supplied normalized records; neither value authenticates an original source export. Reused for interaction traces, notification snapshots/histories and ringer-state intervals." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
    linkml:permissible_values
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTraceRecordOriginId#analyst_constructed_example> ,
        <https://w3id.org/chronicle-usage-ontology/core/InteractionTraceRecordOriginId#supplied_normalized_records> ;
.

chron:app_package_name
    a owl:DatatypeProperty ;
    rdfs:label "app_package_name" ;
    rdfs:range xsd:string ;
    skos:definition "Android package name." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

chron:record_origin
    a owl:ObjectProperty ;
    rdfs:label "record_origin" ;
    rdfs:range chron:InteractionTraceRecordOriginId ;
    skos:definition "Constructed example versus supplied normalized evidence; neither authenticates raw source rows." ;
    skos:inScheme <https://w3id.org/chronicle-usage-ontology/core> ;
.

