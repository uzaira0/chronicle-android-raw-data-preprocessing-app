        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Stable identity of one source configuration group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path chron:method_configuration_group_id ;
        ] ,
        [
            sh:class chron:MethodConfigurationLevel ;
